# CA1810: Initialize all static fields in '' when those fields are declared and remove the explicit static constructor
dotnet_diagnostic.CA1810.severity = none

# CA1812: XX is an internal class that is apparently never instantiated. If so, remove the code from the assembly. If this class is intended to contain only static members, make it static
dotnet_diagnostic.CA1812.severity = none

# CA1814: .cctor uses a multidimensional array of string[*,*]. Replace it with a jagged array if possible.
dotnet_diagnostic.CA1814.severity = none

# CA1816: Change XX to call GC.SuppressFinalize(object). This will prevent derived types that introduce a finalizer from needing to re-implement 'IDisposable' to call it.
dotnet_diagnostic.CA1816.severity = none

# CA1819: Properties should not return arrays
dotnet_diagnostic.CA1819.severity = none

# CA1820: Test for empty strings using 'string.Length' property or 'string.IsNullOrEmpty' method instead of an Equality check.
