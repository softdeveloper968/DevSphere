# To learn more about .editorconfig see https://aka.ms/editorconfigdocs
root = true

# All files
[*]
indent_style = space

# NETSDK1071: A PackageReference to '' specified a Version of ``. Specifying the version of this package is not recommended
dotnet_diagnostic.NETSDK1071.severity = none

# CS0414: The field 'StorageHelpers._batchContainer' is assigned but its value is never used
dotnet_diagnostic.CS0414.severity = none

# CS0162: Unreachable code detected
dotnet_diagnostic.CS0162.severity = none

# CS0168: The variable 'ex' is declared but never used
dotnet_diagnostic.CS0168.severity = none

# CS0219: The variable 'found' is assigned but its value is never used
dotnet_diagnostic.CS0219.severity = none

# CS0649: Field '' is never assigned to, and will always have its default value null
dotnet_diagnostic.CS0649.severity = none

# CS1998: This async method lacks 'await' operators and will run synchronously.
dotnet_diagnostic.CS1998.severity = none

# Warning CS8321: The local function 'ASDATE' is declared but never used
dotnet_diagnostic.CS8321.severity = none

# CA1031: Modify 'function' to catch a more specific allowed exception type, or rethrow the exception
dotnet_diagnostic.CA1031.severity = none

