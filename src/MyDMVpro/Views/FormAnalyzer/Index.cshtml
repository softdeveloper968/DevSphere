<div>
    <div class="row gap_15 mb_15 flex_row">
        <div class="formListPanel col-md-7 col-lg-7">
            @{{
                    FormAnalyzerViewModel list = new FormAnalyzerViewModel()
                    {
                        DataUrl = "/FormAnalyzer/FormAnalyzerUploads",
                        ListId = "DT_AnalyzerUploads",
                        TableVarName = "AnalyzerUploadsTable",
                        PageLength = 10,
                        EnableKeyNavigation = false,
                        AllowMultilineVin = false,
                        AllowMultiSelect = true
                    };
                    list.Columns.Add_Select();
                    list.Columns.Add("", "reqBlank");
                    list.Columns.Add("", "reqBlank");

                    list.Columns.Add("Form", "colFormName afilter", filterField: "formName");
                    list.Columns.Add("Date Uploaded", "colDateUploaded dfilter", filterField: "dateUploaded");
                    list.Columns.Add("Date Scanned", "colDateScanned dfilter", filterField: "dateScanned");
                    list.Columns.Add_VIN();
                    list.Columns.Add("Matches", "colActiveMatches afilter", filterField: "activeMatches");
                    list.Columns.Add("Filename", "colFileName asearch", filterField: "uploadFileName");
                    list.Columns.Add("FormId", "colFormId");
                    list.Columns.Add("UploadId", "colUploadId");

                    list.SortColumns.Add("colFormName");
                    list.SortColumns.Add("reqVIN");

                    await Html.RenderPartialAsync("_uploadedForms", list);
                }}
            @* DROP LOCATION FOR UPDATES VIA SPREADSHEET *@

        </div>
        <div class="col-md-5 col-lg-5">
            <div class="white_box p_15 h-100">
                <div class="analyzerDropZonePanel">
                    <div id="drop-area">
                        <form class="analyzeruploadform">
                            <div class="form-group mb_10">
                                <div class="row gap_15">
                                    <div class="col-sm-3">
                                        <input type="file" id="fileElem" multiple accept="image/*" onchange="handleFiles(this.files)">
                                        <label class="button btn btn-default custom_btn" for="fileElem">Select files</label>
                                    </div>
                                    <div class="col-sm-5">
                                        @* <label for="formId" class="text-left control-label"></label> *@
                                        <select id="formId" name="formId" class="form-control">
                                            <option value="">Unknown type</option>
                                            @foreach (var f in Model.Item1)
                                            {
                                                <option value="@f.FormId">@f.FormName</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="col-sm-4">
                                        <label class="mt_10">
                                            <input type="checkbox" id="allowDupes" name="allowDupes">
                                            Allow Duplicates
                                        </label>
                                    </div>
                                </div>
                            </div>
