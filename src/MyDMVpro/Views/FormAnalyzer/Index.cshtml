    @*<div class="row">
        <div class="col-md-6 col-lg-6"><div class="detailsViewPanel" id="detailsViewPanel"></div></div>
    </div>*@
    <div class="row gap_15">
        <div class="col-md-7 col-lg-5 mb_10">
            <div id="detailsEditPanel" class="detailsEditPanel white_box p_15" tabindex="-1">
                <form class="vinUpdater" name="vinUpdater" id="vinUpdater" method="post" action="/FormAnalyzer/UpdateVin">
                    <input type="hidden" name="uploadId" id="formAnalyzer_uploadId" value="">
                    <label for="formAnalyzer_vinUpdater"><span id="unmatchedvalidvintext">Unmatched or no VIN detected</span><span id="invalidvintext" style="display:none">Invalid VIN</span>, enter corrected VIN and click Update:<span class="vinvalidation"></span></label>
