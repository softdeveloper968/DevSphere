                </div>
            </div>
        </div>
        <div class="col-md-12 col-lg-7">
            <div id="docViewPanel" class="docViewPanel white_box p_15"></div>
        </div>
    </div>
    <div style="display:none">
        <form id="hiddenform" method="post" action=""></form>
    </div>
</div>
<script>
    // ************************ Drag and drop ***************** //
    let dropArea = document.getElementById("drop-area")

    $(document).ready(function () {

        // Prevent default drag behaviors
        ;['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropArea.addEventListener(eventName, preventDefaults, false)
            document.body.addEventListener(eventName, preventDefaults, false)
        });

        // Highlight drop area when item is dragged over it
        ;['dragenter', 'dragover'].forEach(eventName => {
            dropArea.addEventListener(eventName, highlight, false)
        });

        ;['dragleave', 'drop'].forEach(eventName => {
            dropArea.addEventListener(eventName, unhighlight, false)
        });

        // Handle dropped files
        dropArea.addEventListener('drop', handleDrop, false)

        $("#newFormSelector").find("input[name='ForceVendorMode']").val("true");
        formAnalyzer_hide_ViewDetails();

        $("#DT_FormAnalyzerMatch").DataTable().on('select deselect', function (e, dt, type, indexes) {
            if (type === 'row') {
                if (e.type === 'select') {
                    formAnalyzer_show_ViewDetails(false);
                    formAnalyzer_match_selected();
                }
                else {
                    formAnalyzer_match_deselected();
                }
            }
        });

        var $panel = $("#detailsEditPanel");
        var $footer = $panel.find(".panel-footer");
        $("#detailsEditPanel_saveButton").prop('disabled', true);
        $("#detailsEditPanel_saveButton").off('click').on('click', function (e) {
            e.preventDefault();
            if ($("#newFormPanel").is(":visible")) {
                $("#newFormPanel").find("form").trigger("submit");
            }
            else {
                $("#detailsEditPanelBody").find("form").trigger("submit");
            }
        });

        $panel.find("#nextButton").off('click').on('click', function (e) {
            e.preventDefault();
            var t = $("#DT_AnalyzerUploads").DataTable();
            var curselnode = t.row('.selected').node();
            var nodes = t.rows({ order: 'current', page: 'all' }).nodes();
            var curIndex = nodes.indexOf(curselnode);
            if (curIndex < nodes.count()) {
                $.each($(nodes[curIndex + 1]), function () {
                    t.row(curselnode).deselect();
                    t.row(this).select();
                    t.row(this).scrollTo();
                });
            }
        });
        $panel.find("#prevButton").off('click').on('click', function (e) {
            e.preventDefault();
            var t = $("#DT_AnalyzerUploads").DataTable();
            var curselnode = t.row('.selected').node();
            var nodes = t.rows({ order: 'current', page: 'all' }).nodes();
            var curIndex = nodes.indexOf(curselnode);
            if (curIndex > 0) {
                $.each($(nodes[curIndex - 1]), function () {
                    t.row(curselnode).deselect();
                    t.row(this).select();
                    t.row(this).scrollTo();
                });
            }
        });
        $panel.find("#vinUpdater").submit(function (e) {
            e.preventDefault();
            var $thisForm = $(this);
            $.ajax({
                url: $thisForm.attr('action'),
                type: 'POST',
                headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                data: $thisForm.serialize()
            }).done(function (data) {
                // refresh list
                var t = $("#DT_AnalyzerUploads").DataTable();
                t.ajax.reload();
            }).fail(function (xhr) {
                formAnalyzer_processError(xhr);
            });
            return false;
        });
        $('#formAnalyzer_vinUpdater').on('input', function (e) {
            var vin = $(this).val().toUpperCase();
            var ctl = $(this).parent().parent().find(".vinvalidation");
            getVinDetail(vin, ctl);
        });
        $("#formAnalyzer_vinUpdater").on('input propertychange paste', function () {
            var vin = $(this).val().toUpperCase();
            $("#vinUpdateButton").prop('disabled', !isVIN(vin));
            formAnalyzer_fill_vinlist(vin);
        });
        $("#formAnalyzer_vinUpdater").on('change', function () {
            var vin = $(this).val().toUpperCase();
            $("#vinUpdateButton").prop('disabled', !isVIN(vin));
        });
    });

    function preventDefaults(e) {
        e.preventDefault()
        e.stopPropagation()
    }

    function highlight(e) {
        dropArea.classList.add('highlight')
    }

    function unhighlight(e) {
        dropArea.classList.remove('active')
    }

    function handleDrop(e) {
        var dt = e.dataTransfer
        var files = dt.files

        handleFiles(files)
    }

    let uploadProgress = []
    let progressBar = document.getElementById('progress-bar')

    function initializeProgress(numFiles) {
        progressBar.value = 0
        uploadProgress = []

        for (let i = numFiles; i > 0; i--) {
            uploadProgress.push(0);
        }
    }

    function updateProgress(fileNumber, percent) {
        if (!(percent)) {
            percent = 0;
        }
        uploadProgress[fileNumber] = percent
        let total = uploadProgress.reduce((tot, curr) => tot + curr, 0) / uploadProgress.length
        //console.debug('update', fileNumber, percent, total)
        if (total) {
            progressBar.value = total
        }
        else {
            progressBar.value = 0
        }
    }

    function handleFiles(files) {
        files = [...files]
        initializeProgress(files.length)
        files.forEach(uploadFile); // calls uploadFile for each file uploaded
        //files.forEach(previewFile)
    }

    function previewFile(file) {
        let reader = new FileReader()
        reader.readAsDataURL(file)
        reader.onloadend = function () {
            //let img = document.createElement('img')
            //img.src = reader.result
            //document.getElementById('gallery').appendChild(img)
        }
    }

    function uploadFile(file, i) {
        var url = '/FormAnalyzer/Upload';
        var ajax = new XMLHttpRequest();
        var formData = new FormData();
        ajax.open('POST', url, true);
        ajax.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
        ajax.setRequestHeader('RequestVerificationToken', $('[name="__RequestVerificationToken"]').val())

        // Update progress (can be used to show progress indicator)
        ajax.upload.addEventListener("progress", function (e) {
            if (e.total == 0) {
                updateProgress(i, 0);
            }
            updateProgress(i, (e.loaded * 100.0 / e.total) || 100);
        })

        ajax.addEventListener('readystatechange', function (e) {
            if (ajax.readyState == 4 && ajax.status == 200) {
                updateProgress(i, 100); // <- Add this
            }
            else if (ajax.readyState == 4 && ajax.status != 200) {
                // Error. Inform the user
            }
        });

        formData.append('file', file);
        const dt = new Date(file.lastModified);
        formData.append('filedate', dt.toUTCString());
        formData.append('formId', $("#formId").val());
        formData.append('allowDuplicates', $('#allowDupes').prop('checked'));
        ajax.send(formData);
    }
    function createUploadPromise(iteration) {

        return new Promise((resolve, reject) => {
            // create FormData object - add file and form fields manually
            var files = droppedFiles || fileUploadElem.files;
            const file = files[iteration];

            const formData = new FormData()
            formData.append('file', file);
            const dt = new Date(file.lastModified);
            formData.append('filedate', dt.toUTCString());
            formData.append('allowDuplicates', 'true');
            formData.append('formId', $("#formId").val());
            formData.append('allowDuplicates', $('#allowDupes').prop('checked'));

            // dispatch xhr to start file upload - listen to file upload complete event and notify user
            let xhr = new XMLHttpRequest()
            var url = '/FormAnalyzer/Upload';
            xhr.open('POST', url, true);

            // set onload (i.e. upload completion) callback
            xhr.onload = () => {
                if (xhr.readyState === 4 && xhr.status === 200) {
                    this.selectedFilesList.querySelectorAll('li')[iteration].style.color = 'darkgreen'
                    resolve()
                } else {
                    this.selectedFilesList.querySelectorAll('li')[iteration].style.color = 'red'
                    reject()
                }
            }

            // watch for file upload progress
            xhr.upload.addEventListener('progress', (e) => {
                this.selectedFilesList.querySelectorAll('progress')[iteration].setAttribute("value", (e.loaded / e.total * 100))
            })

            // initiate AJAX request
            xhr.open("POST", this.formElem.action)
            xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
            xhr.setRequestHeader('RequestVerificationToken', $('[name="__RequestVerificationToken"]').val())

            xhr.send(formData)

        })
    }

</script>


