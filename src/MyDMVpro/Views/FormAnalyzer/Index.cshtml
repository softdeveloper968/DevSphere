                                QueueTitle = "Form Analyzer Match",
                                DataUrl = GetUrl("FormAnalyzerMatch"),
                                ListId = "DT_FormAnalyzerMatch",
                                TableVarName = "FormAnalyzerMatch",
                                AllowMove = false,
                                AllowDelete = false,
                                AllowMultilineVin = false,
                                AllowRefresh = false,
                                EnableFilter = false,
                                EnableAdvancedSearch = false,
                                UseButtonList = true,
                                AllowGlobalSearch = false,
                                DeferLoading = false,
                                AllowMultiSelect = false,
                                PageLength = 5,
                                ForceVinSearch = true,
                                ColorizeStatus = true,
                                LengthMenu = "[5,10,15]"
