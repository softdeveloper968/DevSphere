                        </form>
                        <div style="width:100%">
                            <progress id="progress-bar" max="100" value="0"></progress>
                        </div>
                    </div>
                </div>
                <div class="applyToListPanel p-0 mt_15" id="applyToListPanel">
                    @{
                        {
