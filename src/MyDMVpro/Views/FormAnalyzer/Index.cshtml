                        await Html.RenderPartialAsync("_NewAppType", Model.Item2);
                    }
                    @section Scripts {
                        @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
                    }
                </div>
                <div class="d-flex gap_5">
                    <button type="button" class="btn custom_btn" id="prevButton">Prev</button>
                    <button type="button" class="btn custom_btn" id="nextButton">Next</button>
                    <button type="button" class="btn btn-primary custom_btn" id="detailsEditPanel_saveButton" disabled>Save</button>
                </div>
