@model MyDMVpro.Models.FormAnalyzerModels.FormAnalyzerViewModel
@using MyDMVpro.Common.ViewHelpers;
@using System.Text;
@{
    var columnCount = 0;
    string filterList()
    {
        List<string> filterFields = new List<string>();
        foreach (DatatableColumnInfo col in Model.Columns)
        {
            if (!string.IsNullOrEmpty(col.FilterField))
            {
                filterFields.Add(col.FilterField);
            }
        }
        return string.Join(",", filterFields);
    }
    string getbool(bool f)
    {
        if (f) return "true";
        return "false";
    }
}
<script asp-add-nonce="true">
    var GetUniqueID = function () {
        // Math.random should be unique because of its seeding algorithm.
        // Convert it to base 36 (numbers + letters), and grab the first 9 characters
        // after the decimal.
        return '_' + Math.random().toString(36).substr(2, 9);
    };
</script>
<style asp-add-nonce="true">
    .advancedFilter {
    }
    .filterToggle .advanced {
            display: none;
        }
    .filterToggle .simple {
            display: inline-block;
        }
    .filterToggle.advancedOn
        .advanced {
            display: inline-block;
        }
    .filterToggle.advancedOn
        .simple {
            display: none;
        }
    .mindate {
        display: block;
        width: 100%;
    }
    .maxdate {
        display: block;
        width: 100%;
    }
    td.numericCol {
        text-align: right !important;
        padding-right: 30px;
    }
    th.numericCol {
        text-align: right !important;
        padding-right: 30px;
    }

    #@(Model.ListId)_wrapper tfoot {
        display: table-footer-group;
        font-weight: bold;
    }
    #@(Model.ListId)_wrapper thead {
        display: table-header-group;
    }
    .multivinSearch {
        resize: none;
        font-size: x-small;
    }
</style>

<div class="white_box p_15 h-100">
    <table class="display stripe nowrap" id="@Model.ListId" cellspacing="0" align="left">
        <thead>
            <tr id="headerRow-@Model.ListId">
                @if (Model.Columns.Count > 0)
                {
                    foreach (var c in Model.Columns)
                    {
                        <th class="@c.Class dt-center" @Html.Raw(c.GetHoverTextAttribute())>@c.Title</th>
                    }
                    columnCount = Model.Columns.Count;
                }
            </tr>
            <tr id="filterRow-@Model.ListId">
                @for (var i = 0; i < Model.Columns.Count; i++)
                {
                    DatatableColumnInfo c = Model.Columns[i];
                    string cls = c.Class;

                    if (i == 0)
                    {
                        <th class="clearFilter" data-toggle="tooltip" title="Clear filter">&nbsp;</th>
                    }
                    else if (i == 1 && Model.EnableAdvancedSearch)
                    {
                        <th class="advancedFilter" data-toggle="tooltip" title="Advanced filter"></th>
                    }
                    else
                    {
                        <th>&nbsp;</th>
                    }
                }
            </tr>
        </thead>
        <tbody></tbody>
        <tfoot>
            <tr></tr>
        </tfoot>
    </table>
</div>

<script asp-add-nonce="true">
    $(document).ready(function () {
        $.fn.dataTable.render.shortDate = datatable_render_shortdate;

        var table = $('#@Model.ListId')
            .on('preXhr.dt', function (e, settings, data) {
                data.dropdownFilters = '@filterList()';
            })
            .DataTable(
            {
                @if (Model.EnableKeyNavigation) {
                    @:@Model?.KeyNavigation
                }
                "rowId": "formUploadId",
                "colReorder": false,
                "scroller": true,
                "scrollCollapse": true,
                "paging": true,
                "sScrollX": "100%",
                "scrollX": true,
                "scrollY": "160px",
                bSortCellsTop: true,
                "select": {
                    style:
                        @if (Model.AllowMultiSelect)
                        {
                            @:"os",
                        }
                        else {
                            @:"single",
                        }
                        items: "row",
                    blurable: false
               },
                "searching": true,
                "pageLength": @Model.PageLength,
                "language": {
                    select: {
                        rows: "<span class='info_xrowsselected'>%d rows selected</span>"
                        ,selector: 'td:not(.norowselect)'
                    }
                },
                "lengthMenu": @Model.LengthMenu,
                @*fixedColumns: { leftColumns: 2 },*@
                @if (Model.SortColumns.Count > 0)
                {
                    @:order: [
                    for(var i = 0; i<Model.SortColumns.Count; i++)
                    {
                        if (i > 0) { @:,
                        } @:[$('#@Model.ListId .@Model.SortColumns[i].Name').index(), '@(Model.SortColumns[i].Descending?"desc":"asc")']
                    }
                    @:],
                }
                searchDelay: 500,
                "columnDefs": [
                    {
                        "targets": "reqChkbx",
                        "orderable": false,
                        "className": "select-checkbox",
                        "min-width": "40px",
                        "max-width": "40px",
                        "sortable": false,
                    },
                    { "targets": "reqBlank", "defaultContent": "", "sortable": false, "orderable": false, "autowidth": true, "className": "noexport" },
                    { "targets": "advancedFilter", "defaultContent": "", "sortable": false, "orderable": false, "autowidth": true },
                    { "targets": "reqVIN", "type": "text-vin", "data": "vin", "render": datatable_render_vin },
                    { "targets": "colFormId", "visible": false, "sortable": false, "data": "formId", "className": "noexport" },
                    { "targets": "colUploadId", "visible": false, "sortable": false, "data": "formUploadId", "className": "noexport" },
                    { "targets": "colFormName", "visible": true, "sortable": true, "data": "formName" },
                    { "targets": "colFileName", "visible": true, "sortable": true, "data": "uploadFileName"  },
                    { "targets": "colDateApproved", "visible": true, "sortable": true, "data": "dateApproved" },
                    { "targets": "colDateUploaded", "visible": true, "sortable": true, "data": "dateUploaded" },
                    { "targets": "colDateScanned", "visible": true, "sortable": true, "data": "dateScanned" },
                    { "targets": "colApprovedBy", "visible": true, "sortable": true, "data": "approvedBy" },
                    {
                        "targets": "colActiveMatches", "visible": true, "sortable": true, "data": "activeMatches",
                        "render": getfn_datatable_render_number(true,true)
                    },
                    { "targets": "colTotalMatches", "visible": true, "sortable": true, "data": "totalMatches" },
                    {
                        "targets": ["dfilter", "drfilter"],
                        "sortable": true,
                        "width": "100px",
                        "defaultContent": "",
                        "render": datatable_render_date
                    },
                    {
                        "targets": "_all", "searchable": true, "className": "dt-center", "autowidth": true, "defaultContent": "", "sortable": true,
                        render: $.fn.dataTable.render.text()
                    },
                ],
                "processing": true,
                "serverSide": false,
                //"filter": true,
                "ajax": {
                        "url": "@Model.DataUrl",
                        "type": "POST",
                        "dataType": "JSON",
                        headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() }
                    },
                "buttons": [
                    {
                        extend: 'selectAll',
                        className: 'selectall',
                        action: function (e) {
                            e.preventDefault();
                            table.rows({ search: 'applied' }).deselect();
                            table.rows({ search: 'applied' }).select();
                        }
                    },
                    'selectNone',
@*                    { text: "VIN Correction", className: "selectOnOff selectOne", action: function (e) { e.preventDefault(); formAnalyzer_show_CorrectVin(table); } },*@
@*                    { text: "Details", className: "selectOnOff selectOne", action: function (e) { e.preventDefault(); formAnalyzer_show_ViewDetails(true); } },*@
                    { text: "Attach Only", className: "selectOnOff", action: function (e) { e.preventDefault(); formAnalyzer_show_AttachNoUpdate(table); } },
                    { text: "Delete", className: "selectOnOff", action: function (e) { e.preventDefault(); formAnalyzer_show_DeleteItems(table); } },
                    { text: "Re-scan", className: "selectOnOff", action: function (e) { e.preventDefault(); formAnalyzer_show_RescanUpload(table); } },
                    { text: "Process Titles", className: "selectOnOff", action: function (e) { e.preventDefault(); formAnalyzer_show_ProcessTitles(table); } },
                    @*{ text: "Create Request", className: "selectOnOff", action: function (e) { e.preventDefault(); formAnalyzer_show_CreateRequest(table); } },*@
                    {
                    extend: 'collection',
                        text: 'Export',
                        dropup: true,
                        background: false,
                        buttons: [
                            {
                                extend: 'copy',
                                exportOptions: {
                                    columns: '@Model.CopyExportSelector'
                                }
                            },
                            {
                                extend: 'excelHtml5',
                                exportOptions: {
                                    columns: '@Model.ExcelExportSelector'
                                }
                            },
                            {
                                extend: 'pdfHtml5',
                                orientation: 'landscape',
                                pageSize: 'LEGAL',
                                exportOptions: {
                                    columns: '@Model.PdfExportSelector',
                                }
                            },
                            {
                                extend: "print",
                                exportOptions: {
                                    columns: ':visible'
                                }
                            },
                            @if (!Model.DisableCsvExport)
                            {
                            <text>
                            {
                                name: 'ExportCsvData',
                                className: 'exportCsvData selectOnOff',
                                text: 'Data as CSV',
                                action: function (e) {
                                    e.preventDefault();
                                    exportItemsToCsv(table);
                                }
                            },
                            </text>
                            }
                        ]
                    },
                    { text: "", titleAttr: "Refresh", className: "listRefresh", action: function (e) { e.preventDefault(); table.ajax.reload(); } },
                ],
                "initComplete": function (settings, json) {
                    var api = this.api();
                    var colFilters = json.columnFilters;
                    var tblid = '@Model.ListId';
                    api.columns(['.drfilter', '.dfilter']).every(getfn_datatable_drfilter(tblid, false, colFilters));
                    api.columns(['.afilter']).every(getfn_datatable_afilter(tblid, true, colFilters));
                    api.columns(['.asearch']).every(getfn_datatable_asearch(tblid));
                    api.columns(['.dsearch']).every(getfn_datatable_dsearch(tblid));
                    api.columns(['.reqVIN']).every(getfn_datatable_vin(tblid, @getbool(Model.AllowMultilineVin)));
                    fixupColumnWidths(this);
                },
                "dom": "<'row'<'col-sm-6'l><'col-sm-6'<'#buttonContainer.site-datatable-button-container'>>>" + "<'row'<'col-sm-12'tr>>" + "<'row'<'col-sm-5'i><'col-sm-7'p>><'alert row'>B",
            });

        @if (Model.EnableKeyNavigation)
        {
            <text>
            table.on('key-focus.dt', function (e, datatable, cell) {
                table.row(cell.index().row).select();
            });

            table.on('key-blur.dt', function (e, datatable, cell) {
                table.row(cell.index().row).deselect();
            });
            // Handle click on table cell
            table.on('click', 'tbody td', function(e){
                e.stopPropagation();
        
                // Get index of the clicked row
                var rowIdx = table.cell(this).index().row;
        
                // Select row
                table.row(rowIdx).select();
            });
            </text>
        } 
        @if (Model.EnableKeyShortcuts)
        { 
            <text>
            table.on('key.dt', function (e, datatable, key, cell, originalEvent) {
                if (key === 32) {
                    // Toggle selection
                    var row = table.row(cell.index().row);
                    if ($(row.node()).hasClass('selected'))
                            row.deselect();
                        else
                            row.select();
                }
            });
            </text>
        }

        @Model.TableVarName = table;

        table.on('draw', function () {
            formAnalyzer_hide_ViewDetails();
            formAnalyzer_hide_ApplyToPanel();
            if (table.rows({ selected: true }).indexes().length === 0) {
                table.buttons('.selectOnOff').disable();
            }
            else if (table.rows({ selected: true }).indexes().length === 1) {
                table.buttons('.selectOnOff').enable();
            }
            else {
                table.buttons('.selectOnOff').enable();
                table.buttons('.selectOnOff.selectOne').disable();
            }
        });
        table.on('select deselect', function (e, dt, type, indexes) {
            if (type === 'row') {
                var items = table.rows({ selected: true }).data();
                if (items.length === 0) {
                    table.buttons('.selectOnOff').disable();
                }
                else if (items.length === 1) {
                    table.buttons('.selectOnOff').enable();
                }
                else {
                    table.buttons('.selectOnOff').enable();
                    table.buttons('.selectOnOff.selectOne').disable();
                }
                formAnalyzer_selection_updated(items);
            }
        });
        table.buttons('.selectOnOff').disable();

        datatable_filter_setup(table, '@Model.ListId', true);
        datatable_multivin_search_setup(table);
    });
</script>


