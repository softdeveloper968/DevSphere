@{
    ViewData["Title"] = "Follow-Up Codes";
}

<script src="~/js/vendor.js" asp-append-version="true"></script>
<script src="~/js/followupcodes.js" asp-append-version="true"></script>
<link rel="stylesheet" href="~/css/vendor.css" asp-append-version="true" />

<h2>Follow-Up Codes</h2>
@{
    {
        FollowUpCodesViewModel list = new FollowUpCodesViewModel(VendorViewType.FollowUpCodes)
        {
            DataUrl = "/Tags/FollowUpTags",
            ListId = "DT_FollowUpCodes",
            TableVarName = "FollowUpCodeTable",
            AllowDelete = false,
            PageLength = 20,
            EnableKeyNavigation = false,
            AllowMultiSelect = true,
            AddLastModified = false,
            AddLastModifiedBy = false,
            AllowExport = false
        };
        list.Columns.Add_Select();
        list.Columns.Add("Code", "reqTag");
        list.Columns.Add("Description", "reqDesc");
        list.Columns.Add("TagId", "reqTagId");

        list.SortColumns.Add("reqTag");

        await Html.RenderPartialAsync("_vendorFollowUpCodeList", list);
    }
}
<div id="modal-FollowUpCode-New" class="modal fade hidden-print" tabindex="-1" role="dialog">
    <div class="container vertical-alignment-helper">
        <div class="row vertical-align-center">
            <div class="col-sm-4"></div>
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                        <h4 class="modal-title" id="myModal-label">New Follow-Up Code</h4>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="FollowUpCode_New_Name" class="control-label">Follow-Up Code</label>
                            <input type="text" maxlength="50" style="text-transform: uppercase;" id="FollowUpCode_New_Name" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label for="FollowUpCode_New_Description" class="control-label">Follow-Up Description</label>
                            <textarea class="form-control" id="FollowUpCode_New_Description" rows="10" width="100%" placeholder="Type note" style="resize:none;"></textarea>
                        </div>
                    </div>
                    <div class="alert alert-danger" style="display:none" role="alert"></div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-success custom_btn" id="okButton">Save</button>
                        <button type="button" class="btn btn-default custom_btn" data-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="modal-FollowUpCode-Delete" class="modal fade hidden-print" tabindex="-1" role="dialog">
    <div class="container vertical-alignment-helper">
        <div class="row vertical-align-center">
            <div class="col-sm-4"></div>
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                        <h4 class="modal-title" id="myModal-label">Delete Follow-Up Code</h4>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="FollowUpCode_Delete_Id" />
                        <div class="form-group">
                            <label for="FollowUpCode_Delete_Name" class="control-label">Follow-Up Code</label>
                            <input type="text" maxlength="50" style="text-transform: uppercase;" id="FollowUpCode_Delete_Name" class="form-control" readonly>
                        </div>
                        <div class="form-group">
                            <label for="FollowUpCode_Delete_Description" class="control-label">Follow-Up Description</label>
                            <textarea class="form-control" id="FollowUpCode_Delete_Description" rows="10" width="100%" style="resize:none;" readonly></textarea>
                        </div>
                    </div>
                    <div class="alert alert-danger" style="display:none" role="alert"></div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-success" id="okButton">Delete</button>
                        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="modal-FollowUpCode-Edit" class="modal fade hidden-print" tabindex="-1" role="dialog">
    <div class="container vertical-alignment-helper">
        <div class="row vertical-align-center">
            <div class="col-sm-4"></div>
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                        <h4 class="modal-title" id="myModal-label">Edit Follow-Up Code</h4>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="FollowUpCode_Edit_Id" />
                        <div class="form-group">
                            <label for="FollowUpCode_Edit_Name" class="control-label">Follow-Up Code</label>
                            <input type="text" maxlength="50" style="text-transform: uppercase;" id="FollowUpCode_Edit_Name" class="form-control" readonly>
                        </div>
                        <div class="form-group">
                            <label for="FollowUpCode_Edit_Description" class="control-label">Follow-Up Description</label>
                            <textarea class="form-control" id="FollowUpCode_Edit_Description" rows="10" width="100%" placeholder="Type note" style="resize:none;"></textarea>
                        </div>
                    </div>
                    <div class="alert alert-danger" style="display:none" role="alert"></div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-success" id="okButton">Save</button>
                        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
