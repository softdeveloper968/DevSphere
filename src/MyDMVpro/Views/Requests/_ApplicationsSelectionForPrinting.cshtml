<div id="modal-request-merge-selection" class="modal fade hidden-print" tabindex="-1" role="">
    <div class="container vertical-alignment-helper">
        <div class="row vertical-align-center">
            <div class="col-sm-4"></div>
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                        <h4 class="modal-title" id="myModal-label">Merge Application into PDF</h4>
                    </div>
                    <div class="modal-body">
                    </div>
                    <div class="modal-footer">
                        <div class="alert alert-danger" role="alert" style="display:none"></div>
                        <button type="button" class="btn btn-default" id="btnStartBulkMerging">Merge and Create PDF</button>
                        <button type="button" class="btn btn-default" data-dismiss="modal" id="btnClose">Close</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script asp-add-nonce="true">
    var bulkMergeForm = $("#modal-request-merge-selection");

    bulkMergeForm.find("#btnStartBulkMerging").off('click').on('click', function (e) {
        e.preventDefault();

        //$("#myModal").text("Confirmation");
        let $modal = $("#modal-request-merge-selection");
        $(this).hide();
        $modal.find("#bulkMergeStep1").hide();
        $modal.find("#bulkMergeStep2").fadeIn();

        var formData = new FormData();
        $(vendorBulkMerge_Items).each(function (i, v) {
            formData.append("requestIds", v.requestId);
        });

        var templateId = $modal.find("#bulkMergeStep1 input[type=radio]:checked").val();
        var includeChecks = $modal.find("#includeCheckMerge").is(":checked");

        formData.append("templateId", templateId);
        formData.append("includeChecks", includeChecks ? "true" : "false");

        $.ajax({
            url: '/BulkPrint/BulkMergeApplications',
            type: 'POST',
            headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
            data: formData,
            dataType: 'json',
            cache: false,
            contentType: false,
            processData: false,
        }).done(function (data) {

            if (data.status == "error") {
                vendor_show_alert($modal, data.message, -1);
            }
            else {
                $modal.find("#bulkFileName").text(data.data);
                // refresh list
                AjaxReloadList($("#DT_BulkPrintApplications").DataTable(), false);
            }
        }).fail(function (xhr) {
            vendor_show_alert($modal, xhr.responseText, -1);
        })
        return false;
    });

    bulkMergeForm.find("#btnClose").click(function () {
        //$("#myModal").text("Attachments");

        bulkMergeForm.find("#btnStartBulkMerging").show();
        bulkMergeForm.find("#bulkMergeStep1").show();
        bulkMergeForm.find("#bulkMergeStep2").hide();
    });
</script>