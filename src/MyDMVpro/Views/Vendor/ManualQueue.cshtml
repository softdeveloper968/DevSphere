@model MyDMVpro.Common.ViewHelpers.ViewDefinitionCollection

@{
    string PageName = "ManualQueue";
    string GetUrl(string name)
    {
        return MyDMVpro.Controllers.RequestStatusController.GetEndpointUrl(this.Context, name);
    }
}
<script src="~/js/vendor.js" asp-append-version="true"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<link rel="stylesheet" href="~/css/vendor.css" asp-append-version="true" />
@{
    await Html.RenderPartialAsync("_Chat", new Chats());
    await Html.RenderPartialAsync("_AttachmentList");
    await Html.RenderPartialAsync("_MoveDialog");
    await Html.RenderPartialAsync("_BulkDialog");
    await Html.RenderPartialAsync("_EditDetails");
    await Html.RenderPartialAsync("_ExportItems");
    await Html.RenderPartialAsync("_DeleteRequest");
    await Html.RenderPartialAsync("_downloadStatements");
    // These are required for the bulk print dialogs
    await Html.RenderPartialAsync("~/Views/Requests/_ApplicationsSelectionForPrinting.cshtml");
    await Html.RenderPartialAsync("~/Views/Requests/_CheckMergeForPrinting.cshtml");
    await Html.RenderPartialAsync("~/Views/Requests/_AttachmentsSelectionForPrinting.cshtml");
}
<h2 class="sub_heading">New Deals Review</h2>
<div class="white_box p_15 mb_20">
    @{
        {
            VendorRequestViewModel MQ_Review_list = new VendorRequestViewModel(VendorViewType.MQ_Review, PageName)
                {
                    QueueTitle = "Review",

                    ListId = "DT_MQ_Review",

                    AllowMove = false,

                    AllowDelete = false,
                    AllowCancel = false,
                    AllowAddToInvoice = false,
                    AllowRefresh = true,
                    AllowStatusEdit = false,
                    AllowMultiSelect = true,
                    AllowDirectToBilling = false,
                    AllowSort = true,
                    EnableFilter = true,
                    ColorizeStatus = false,
                    EnableSortButton = false,
                    AddLastModified = false,
                    AddLastModifiedBy = false,
                    EnableExport = true,
                    EnablePresets = false,
                    EnableReportBuilder = true,
                    AddExpandNotesOption = true,
                    AddIncludeArchivedOption = true,
                    UpdateAuditsButton = false,
                    EnableBulkEdit = false,
                    AddOCRReviewButton = true,
                };

            MQ_Review_list.Columns.Add_Select();
            MQ_Review_list.Columns.Add_CodeCount();
            MQ_Review_list.Columns.Add_Chat();
            MQ_Review_list.Columns.Add_Attachments();
            MQ_Review_list.Columns.Add_DateToVendor();         
            MQ_Review_list.Columns.Add_Group();
            MQ_Review_list.Columns.Add_RNo();
            MQ_Review_list.Columns.Add_Notes();
            MQ_Review_list.Columns.Add_AppType();

            await Html.RenderPartialAsync("_VendorRequestList", MQ_Review_list);
        }
    }
</div>

