<script>
    $(document).ready(function () {  
        populateAssignedShipperDropdown('#assignedProcessorFilter');
        populateProcessingDayDropdown("#processingDay")
        $("#processingDay").on('change', function (e) {
            NeedToProcess_RefreshViewFilters(this);
        });
        $("#assignedProcessorFilter").on('change', function (e) {
            NeedToProcess_RefreshViewFilters(this);
        });
        $('#resetFilters').on('click', function () {
            // Reset both dropdowns to their default values
            $('#processingDay').val(''); // Reset processing day
            $('#assignedProcessorFilter').val(''); // Reset assigned shipper
            // Call the refresh function to update views if necessary
            NeedToProcess_RefreshViewFilters(this);
        });
    });
</script>