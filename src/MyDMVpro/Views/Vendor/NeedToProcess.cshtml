@model MyDMVpro.Common.ViewHelpers.ViewDefinitionCollection

@{
    const string PageName = VendorPageNames.NeedToProcess;
    string GetUrl(string name)
    {
        return MyDMVpro.Controllers.RequestStatusController.GetEndpointUrl(this.Context, name);
    }
}
<script src="~/js/vendor.js" asp-append-version="true"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<link rel="stylesheet" href="~/css/vendor.css" asp-append-version="true" />
@{
    await Html.RenderPartialAsync("_Chat", new Chats());
    await Html.RenderPartialAsync("_AttachmentList");
    await Html.RenderPartialAsync("_MoveDialog");
    await Html.RenderPartialAsync("_BulkDialog");
    await Html.RenderPartialAsync("_EditDetails");
    await Html.RenderPartialAsync("_ExportItems");
    await Html.RenderPartialAsync("_DeleteRequest");
    await Html.RenderPartialAsync("_downloadStatements");
    // These are required for the bulk print dialogs
    await Html.RenderPartialAsync("~/Views/Requests/_ApplicationsSelectionForPrinting.cshtml");
    await Html.RenderPartialAsync("~/Views/Requests/_CheckMergeForPrinting.cshtml");
    await Html.RenderPartialAsync("~/Views/Requests/_AttachmentsSelectionForPrinting.cshtml");
}
<div class="white_box p_15 mb_20">
    <div class="row gap_15">
        <div class="col-md-12 form-group m-0">           
            <div class="row gap_15 align-items-center">
                <div class="col-md-4">
                    <div class="form-group">
                        <label class="control-label">Select a Day </label>
                        <select id="processingDay" class="form-control">  
                            <option value="">Select day</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <label for="assignedProcessorFilter" class="control-label">Select a Processor</label>
                        <select id="assignedProcessorFilter" class="form-control" data-required="required">
                            <option value="">Select Processor</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="form-group">
                        <button id="resetFilters" class="btn btn-secondary" style="margin-top: 25px">
                            <i class="fa fa-refresh"></i> Reset Filters
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<h2 class="sub_heading">Incoming</h2>
<div class="white_box p_15 mb_20">
    @{
        {
            VendorRequestViewModel All_Incoming = new VendorRequestViewModel(VendorViewType.NTP_AllIncoming, PageName)
                {
                    QueueName = "All_Incoming",
                    AllowMultiplePerPage = true,
                    AllowMove = false,
                    AllowDelete = false,
                    AllowCancel = false,
                    AllowAddToInvoice = false,
                    AllowRefresh = true,
                    AllowStatusEdit = false,
                    AllowMultiSelect = true,
                    AllowDirectToBilling = false,
                    AllowSort = true,
                    EnableFilter = true,
                    ColorizeStatus = false,
                    EnableSortButton = false,
                    AddLastModified = false,
                    AddLastModifiedBy = false,
                    EnableExport = true,
                    EnablePresets = false,
                    EnableReportBuilder = false,
                    AddExpandNotesOption = false,
                    AddIncludeArchivedOption = false,
                    UpdateAuditsButton = false,
                    EnableBulkEdit = false,
                    
                };

            All_Incoming.Columns.Add_Select();
            All_Incoming.Columns.Add_AppState();
            All_Incoming.Columns.Add_AppType();
            All_Incoming.Columns.Add_VIN();
            All_Incoming.Columns.Add_LH_Shipped_to_Vendor();
            All_Incoming.Columns.Add_DateReceived();

            await Html.RenderPartialAsync("_VendorRequestList", All_Incoming);
        }
    }
</div>

