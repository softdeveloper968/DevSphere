<div id="modal-DirectToBilling" class="modal fade hidden-print" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title" id="myModal-label">Direct to Billing</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="note">Notes (will append to existing notes)</label>
                    <textarea rows="5" width="100" name="note" id="note" class="form-control"></textarea>
                </div>
                <div class="form-group">
                    <label for="remark">Internal remarks (will append to existing remarks)</label>
                    <textarea rows="5" width="100" name="remark" id="remark" class="form-control"></textarea>
                </div>
                <div class="form-group">
                    <label for="code">Code</label>
                    <input type="text" maxlength="10" width="50" name="code" id="code" class="form-control" />
                    <div class="checkbox" style="margin-right:10px">
                        <label>
                            <input type="checkbox" id="codeNotRequired" name="codeNotRequired" />
                            Code not required
                        </label>
                    </div>
                </div>
                <div class="form-group">
                    <label for="date">Date Finished</label>
                    <input type="date" name="dateFinished" id="date" class="form-control" />
                </div>
                <div class="form-group">
                    <label id="selectedCount" class="m-0"></label>
                </div>
                <div class="form-group">
                    <label id="DirectToBilling_VinsToUpdate" class="vinUpdateList m-0 d-block"></label>
                </div>
            </div>
            <div class="alert alert-danger" style="display:none" role="alert"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" id="okButton">OK</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
