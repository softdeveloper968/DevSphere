    await Html.RenderPartialAsync("_EditDetails");
}
<h2 class="sub_heading">Audits-ETA</h2>
@{
    var etaAuditInstructions = new MyDMVpro.Models.AuditInstructionsModel
            {
                CollapseId = "One",
                Title = "Please click and read the ETA audit instructions below",
                Instructions = new List<string>
                {
                    "Review the past due ETAs and contact the state to determine if the application just needs more time or if there is a problem. DIG IN and do not let the DMV get you off the phone without an answer.",
                    "Add notes from your investigation to the record and update the ETA accordingly.",
                    "Chat the client to advise them of any updates."
                }
            };
    await Html.RenderPartialAsync("_AuditInstructions", etaAuditInstructions);
}

<div class="white_box p_15 mb_20 Audits_view">
    @{
        VendorRequestViewModel auditList = new VendorRequestViewModel(VendorViewType.Audits, PageName)
            {
                QueueName = "Audits",
                //DataUrl = GetUrl("Audits"),
                //ListId = "DT_Audits",
                //TableVarName = "AuditsTable",
                AllowMove = false,
                AllowDelete = false,
                AllowCancel = false,
                AllowAddToInvoice = false,
                AllowRefresh = true,
                AllowStatusEdit = false,
                AllowMultiSelect = true,
                AllowDirectToBilling = false,
                AllowSort = true,
                EnableFilter = true,
                ColorizeStatus = false,
                EnableSortButton = false,
                AddLastModified = false,
                AddLastModifiedBy = false,
                EnableExport = false,
                EnablePresets = false,
                EnableReportBuilder = false,
                AddExpandNotesOption = false,
                AddIncludeArchivedOption = false,
                UpdateAuditsButton = true,
                EnableBulkEdit = false,
            };

        auditList.Columns.Add_Select();
        auditList.Columns.Add_Chat();
        auditList.Columns.Add_Links();
        auditList.Columns.Add_StageName();
        auditList.Columns.Add_Status();
        auditList.Columns.Add_AppType();
        auditList.Columns.Add_AppState();
        auditList.Columns.Add_VIN();
        auditList.Columns.Add_RNo();
        auditList.Columns.Add_Make();
        auditList.Columns.Add_Year();
        auditList.Columns.Add_Group();
        auditList.Columns.Add_RT_LH();
        auditList.Columns.Add_DT_LH();
