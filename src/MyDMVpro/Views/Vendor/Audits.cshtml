    <div class="audit_ETAheader">
    </div>
    <div class="eta_audit_button">
        <div class="audit_ETArealtimer custom_btn btn btn-default"></div>
    </div>
    @{
        await Html.RenderPartialAsync("_VendorRequestList", auditList);
    }
</div>

