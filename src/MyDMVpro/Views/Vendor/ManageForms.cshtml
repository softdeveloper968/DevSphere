@model IEnumerable<MyDMVpro.Models.FormTemplates>
<link rel="stylesheet" href="~/css/vendor.css" asp-append-version="true" />

@{
    ViewData["Title"] = "ManageFormTemplates";
}

<h2>ManageFormTemplates</h2>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.State)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FormCode)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PdfImage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Vendor)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.State)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FormCode)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PdfImage)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Vendor.VendorCode)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.VendorId">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.VendorId">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.VendorId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
