@model MyDMVpro.Models.VendorViewModels.AdministrationViewModel

@{
    ViewData["Title"] = "Administration";
}
<link rel="stylesheet" href="~/css/vendor.css" asp-append-version="true" />
<script src="~/js/vendor.js" asp-append-version="true"></script>

@{ await Html.RenderPartialAsync("_billToInfo"); }
<div class="row" style="padding-left:20px">
    <div class="col-md-4">
        <div>Select group</div>
        <div class="box">
            <div class="box-body table-responsive" height="80%">
                <select id="vendorGroupId" asp-items="@Model.GetGroups()" class="form-control" data-required="required">
                    <option value=""></option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div id="groupDetailAccordion" class="panel-group" style="display:none;">
        <div class="panel panel-default">
            <div class="panel-heading">
                <h4 class="panel-title">
                    <a data-toggle="collapse" href="#groupDetailsPanel">Details</a>
                </h4>
            </div>
            <div class="panel-collapse collapse in" id="groupDetailsPanel">
                <div class="panel-body nooutline">
                    @{ await Html.RenderPartialAsync("_groupInfo", Model.Business); }
                </div>
                <div class="panel-footer">
                    <button class="btn btn-default" id="groupInfoEdit" >Edit</button>
                </div>
            </div>
        </div>
        <div class="panel panel-default">
            <div class="panel-heading">
                <h4 class="panel-title">
                    <a data-toggle="collapse" href="#profilesPanel">Billing Profiles</a>
                </h4>
            </div>
            <div class="panel-collapse collapse" id="profilesPanel">
                <div class="panel-body nooutline">
                    <div class="">
                        <form id="billToListForm" method="post">
                            <input type="hidden" id="groupId" name="groupId" value="" />
                            <input type="hidden" id="vendorId" name="vendorId" value="" />
                            <input type="hidden" id="json" name="json" value="" />
                        </form>
                        <div id="billingInfoPanel">
                            <div class="table-responsive" height="80%">
                                <table id="DT_billToListTable">
                                    <thead>
                                        <tr>
                                            <th class="btiChkbx"></th>
                                            <th class="btiShortName">Short Name</th>
                                            <th class="btiCustName">Billing Name</th>
                                            <th class="btiCustAddr1">Address 1</th>
                                            <th class="btiCustAddr2">Address 2</th>
                                            <th class="btiCustCity">City</th>
                                            <th class="btiCustState">State</th>
                                            <th class="btiCustZip">Zip</th>
                                            <th class="btiCustAttn">Attn</th>
                                            <th class="btiCustNote">Note</th>
                                        </tr>
                                    </thead>
                                    <tbody></tbody>
                                    <tfoot></tfoot>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="panel-footer"></div>
            </div>
        </div>
        <div class="panel panel-default">
            <div class="panel-heading" style="height:50px;">
                <h4 class="panel-title">
                    <a data-toggle="collapse" href="#feeInfoPanel">Fees</a>
                </h4>
            </div>
            <div class="panel-collapse collapse" id="feeInfoPanel">
                <div class="panel-body">
                    <div class="row">
                        <div class="col-md-12">
                            <form id="feesListForm" method="post" style="display:none;">
                                <input type="hidden" id="groupId" name="groupId" value="" />
                                <input type="hidden" id="vendorId" name="vendorId" value="" />
                                <input type="hidden" id="json" name="json" value="" />
                            </form>
                            <div>
                                <div id="feeInfoTableDiv" class="table-responsive" height="80%">
                                    <table id="DT_feeListTable">
                                        <thead>
                                            <tr>
                                                <th></th>
                                                <th class="feeState">State</th>
                                                <th class="feeAppType">App Type</th>
                                                <th class="feeDMV">DMV</th>
                                                <th class="feeService">Service</th>
                                                <th class="feeOtherDesc">Other Desc</th>
                                                <th class="feeOther">Other</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                        <tfoot></tfoot>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="panel-footer"></div>
            </div>
        </div>

    </div>
</div>
<form method="post"></form>
<script>
    $(document).ready(function () {
        initGroupSelect();
        initBillToListTable();
        initFeeListTable();
        initGroupDetailsPanel();
        $("#groupDetailsPanel").on('shown.bs.collapse', function () {
            resizeNotes();
        });
        $("#profilesPanel").on('shown.bs.collapse', function () {
            $("#DT_billToListTable").DataTable().columns.adjust().draw();
        });
        $("#feeInfoPanel").on('shown.bs.collapse', function () {
            $("#DT_feeListTable").DataTable().columns.adjust().draw();
        });
    });
    var groupDetailsEditor;
    function initGroupDetailsPanel() {
        initStatesList();
        groupDetailsEditor = new $.fn.dataTable.Editor({
                fields: [
                    {
                        label: "Business Name:",
                        name: "BusinessName"
                    }, {
                        label: "Address",
                        name: "AddrLine1"
                    }, {
                        label: "Address line 2:",
                        name: "AddrLine2"
                    }, {
                        label: "City:",
                        name: "City"
                    }, {
                        label: "State:",
                        name: "State",
                        type: "select",
                        options: statesList,
                        optionsPair: {
                            label: 'name',
                            value: 'abbrev'
                        }
                    }, {
                        label: "Zip:",
                        name: "Zip"
                    }, {
                        label: "Note:",
                        name: "Notes",
                        type:   "textarea",
                        attr: {
                          class: "form-control",
                          rows: "10",
                          cols: "160",
                          length : "10000",
                          height: "400"
                        }
                    }
                ],
                formOptions: {
                    inline: {
                        onBlur: 'submit'
                    }
                }
        });
        $('#groupInfoEdit').off('click').on('click', function (e) {
            e.preventDefault();
            // Refresh before edit, to get most recent Version#
            refreshGroupInfoPanel(function () {
                groupDetailsEditor
                    .buttons({
                        label: "Save",
                        fn: function () {
                            this.trigger("submit");
                            SaveGroupInfo();
                        }
                    })
                    .edit();
            });
        } );
    }
    function initGroupSelect() {
        $("#groupDetailAccordion").hide();
        $("#vendorGroupId").on('change', function (e) {
            RefreshGroupData(this);
        });
    }
    function RefreshGroupData(ctl) {
        if (typeof ctl === 'undefined') {
            ctl = $("#vendorGroupId");
        } else {
            ctl = $(ctl);
        }
        var gid = ctl.val();
        currentGroupId = gid;
        if (gid == '') {
            $("#groupDetailAccordion").hide();
        }
        else {
            populateBillingPanel(gid);
            populateFeePanel(gid);
            populateGroupInfoPanel(gid, function () {
                $("#groupDetailAccordion").show();
                resizeNotes();
            });
        }
    }
    function RefreshBillToInfoData() {
        var ctl = $("#vendorGroupId");
        var gid = ctl.val();
        currentGroupId = gid;
        if (gid == '') {
        }
        else {
            populateBillingPanel(gid);
        }
    }
    function RefreshFeeData() {
        var ctl = $("#vendorGroupId");
        var gid = ctl.val();
        currentGroupId = gid;
        if (gid == '') {
        }
        else {
            populateFeePanel(gid);
        }
    }
    //function initGroupTable() {
    //    var table = $("#DT_GroupTable").DataTable({
    //        "select": { style: 'single' },
    //        columnDefs: [
    //            {
    //                "targets": "nosort",
    //                "orderable": false
    //            },
    //            {
    //                targets: "checksort",
    //                orderDataType: 'dom-checkbox'
    //            },
