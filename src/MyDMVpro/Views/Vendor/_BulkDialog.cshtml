<div id="modal-PriorCompleteaudit" class="modal fade hidden-print" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title" id="myModal-labelForPrior"></h4>
            </div>
            <div class="alert alert-danger" style="display:none" role="alert"></div>
            <div class="modal-body">
                <div class="priorCompleteauditGrid">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>S.No</th>
                                <th>Audit Name</th>
                                <th>Completed Note</th>
                                <th>Completed Date</th>
                                <th>Total Time Taken</th>
                                <th>Completed By</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody id="audit-list-body">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <div id="record-count"></div>
                <button type="button" class="btn btn-default" id="cancel-button" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
