<form method="post"></form>
<script>
    function updateStartDate() {
        const val = $("#reportDateRange").find("option:selected").val();

        const date = new Date();
        if (val == "last30") {
            // get the date 30 days ago
            date.setDate(date.getDate() - 30);
        }
        else if (val == "lastmonth") {
            // get a date with containing the first day of the previous month
            date.setMonth(date.getMonth() - 1);
            date.setDate(1);
        }
        else if (val == "thismonth") {
            date.setDate(1);
        }
        // set the reportStartDate field with the date
        let completeStartDate = date.toISOString().split('T')[0];
        let maxctl = $("#filterRow-Reports_Completed").find(".maxdate");
        maxctl.val("");
        $("#reportStartDate").val(completeStartDate);
        let minctl = $("#filterRow-Reports_Completed").find(".mindate");
        if (!minctl.is(":visible")) {
            $("#filterRow-Reports_Completed").find(".advancedFilter").trigger('click');
        }
        minctl.val(completeStartDate);
        minctl.trigger('change');
    }
    $(document).ready(function () {
        $("#vendorGroupId").on('change', function (e) {
            Reports_RefreshViewFilters(this);
        });
        $("#downloadReports").on('click', function (e) {
            Reports_Download($("#vendorGroupId").val(), 
                $("#vendorGroupId option:selected").text(), 
                $("#reportWorkbook").is(':checked'));
        });
        $("#refreshReports").on('click', function (e) {
            updateStartDate();
            Reports_RefreshViewFilters($("#vendorGroupId"));
        });
        $("#reportDateRange").on('change', function (e) {
            updateStartDate();
        });
        updateStartDate();
        $("#reportStartDate").on('change', function (e) {
            updateStartDate();
        });
    });
</script>