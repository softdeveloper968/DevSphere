@model List<MyDMVpro.Models.Groups>

@{
    const string PageName = "Reports";
    string GetUrl(string name)
    {
        return MyDMVpro.Controllers.RequestStatusController.GetEndpointUrl(this.Context, name);
    }
    IEnumerable<SelectListItem> GetGroups()
    {
        List<SelectListItem> groups = new();
        foreach (var group in Model)
        {
            groups.Add(new SelectListItem(){ Disabled = false, Selected = false, Text = group.GroupName, Value = group.GroupId.ToString() });
        }
        return groups;
    }
}
<script src="~/js/vendor.js" asp-append-version="true"></script>
<link rel="stylesheet" href="~/css/vendor.css" asp-append-version="true" />
@{
    await Html.RenderPartialAsync("_ExportItems");
}

<div class="white_box p_15 mb_20">
    <div class="row gap_15">
        <div class="col-md-8 form-group m-0">
            <label class="control-label font-600">Select a Group </label>
            <div class="row gap_15">
                <div class="col-md-6">
                    <div class="form-group">
                        <select id="vendorGroupId" asp-items="@(GetGroups())" class="form-control" data-required="required">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <select id="reportDateRange" class="form-control">
                            <option value="last30">Completed Last 30 days</option>
                            <option value="lastmonth">Completed since first of last month</option>
                            <option value="thismonth">Completed this month</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="form-group">
                <label for="reportStartDate" class="control-label">Completed Start Date</label>
                <input type="date" id="reportStartDate" name="reportStartDate" class="form-control" />
            </div>
        </div>
        <div class="col-md-4">
            <label class="m-0 d-inline-flex gap-2 mt_10 font-600">
                <input type="checkbox" id="reportWorkbook" name="reportWorkbook" class="m-0" />
                Download as Excel Workbook
            </label>
        </div>
        <div class="col-md-4">
            <button type="button" class="btn btn-primary custom_btn" id="downloadReports">Download</button>
            <button type="button" class="btn custom_btn" id="refreshReports">Refresh Lists</button>
        </div>
            
    </div>
</div>
