@model GroupProfileDataViewModel
@using MyDMVpro.Models.VendorViewModels;

@{
	ViewData["Title"] = "Manage Group Profile Data";
}
<link rel="stylesheet" href="~/css/vendor.css" asp-append-version="true" />
<script src="~/js/vendor.js" asp-append-version="true"></script>
<script src="~/js/groupfees.js" asp-append-version="true"></script>

<link rel="stylesheet" href="~/css/groupfees.css" />

<div class="row" style="padding-left:20px">
    <div class="col-md-3">
		<div>Select a Group</div>
        <div class="box">
            <div class="box-body table-responsive" height="80%">
                <select id="vendorGroupId" asp-items="@(Model.Groups)" class="form-control" data-required="required">
                    <option value=""></option>
                </select>
                
            </div>
        </div>
    </div>
</div>
@{
    var listColumns = Model.ListColumns;
    string IconColumnWidth() {
        return "30px";
    }
    var editorFields = Model.EditorFields;

    void AddOption(List<Dictionary<string, object>> options, string label, string value)
    {
        var entry = new Dictionary<string, object>();
        entry.Add("label", label);
        entry.Add("value", value);
        options.Add(entry);
    }
    string BuildDOM()
    {
        string dom = "";
        dom = "<'row'<'col-sm-6'l><'col-sm-6'<'#buttonContainer.site-datatable-button-container'C>>>"
                + "<'row'<'col-sm-12'tr>>"
                + "<'row'<'col-sm-5'i><'col-sm-7'p>><'alert row'><'col-sm-12'B>";
        return dom;
    }
}
<div class="box">
    <div class="box-body" height="80%">
        <table style="" class="table table-striped table-bordered" id="@Model.ListId" cellspacing="0" align="left">
            <thead>
                <tr id="headerRow-@Model.ListId">
                    @if (listColumns.Count > 0)
                    {
                        foreach (var c in listColumns)
                        {
                            <th>@c["title"]</th>
                        }
                    }
                </tr>
                @if (Model.EnableFilter && false)
                {
                    <tr id="filterRow-@Model.ListId">
                        @for (var i = 0; i < listColumns.Count; i++)
                        {
                            <th>&nbsp;</th>
                        }
                    </tr>
                }
            </thead>
            <tbody></tbody>
            <tfoot>
                <tr id="footerRow-@Model.ListId">
                    @if (listColumns.Count > 0)
                    {
                        foreach (var c in listColumns)
                        {
                            <th></th>
                        }
                    }
                </tr>
            </tfoot>
        </table>
    </div>
</div>
<style>
    #@Model.ListId th, td {
        white-space: nowrap;
    }
</style>
<script asp-add-nonce="true">
    function vendorLoadGroupFees(groupId, dt) {
    }
    function refreshList() {
        let groupId = $("#vendorGroupId").val();
        vendorLoadGroupFees(groupId, $('#@Model.ListId').DataTable());
    }
	$("#vendorGroupId").change(function () {
        refreshList();
	});
    // generate a function to compare individual values of two json objects
    var bulkDataEdited = @Html.Raw(Json.Serialize(Model.ListData));
    function getVisibleFields(editor) {
        var fields = editor.fields();
        var visibleFields = [];
        for (var i = 0; i < fields.length; i++) {
            var field = fields[i];
            if (field.visible()) {
                visibleFields.push(field.name());
            }
        }
        return visibleFields; 
    }
    var feesEditor;

    $(document).ready(function () {
        $.fn.dataTable.render.shortDate = datatable_render_shortdate;
        var tableId = '#'+'@Model.ListId';
        feesEditor = new $.fn.dataTable.Editor( {
                table: tableId,
                idSrc: "groupProfileID",
                display: 'lightbox',
                template: '#profileEditForm',
                fields: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.EditorFields))
            } );

        configureFeesEditor(feesEditor, tableId, bulkDataEdited);
        $(tableId).on( 'click', 'tbody td.editable', function (e) {
            feesEditor.inline( this );
        } );
        var columnIndex = 0;
        // for (let i = 0; i < table.columns().length; i++) {
        //     if (table.column(i).dataSrc() === '_softdelete') {
        //         columnIndex = i;
        //         break;
        //     }
        // }
        // Example usage
        DataTable.ext.search.push(function (settings, data, dataIndex) {
            if (data[columnIndex] == "true") {
                return false;
            }
            return true;
        });
        var table = $(tableId)
            .DataTable({
                dom: "@Html.Raw(BuildDOM())",
                lengthMenu: [
                    [10, 25, 50, -1],
                    [10, 25, 50, 'All'],
                ],
                createdRow: function( row, data, dataIndex ) {
                },
                fixedColumns: {
                    leftColumns: 1
                },
                rowCallback: bulkedit_row_callback,
                rowId: 'groupProfileID',
                autoWidth: true,
                scrollX: true,
                sort: true,
                buttons: [
                    @if (Model.AddSelectDeselectButtons) 
                    {
                        <text>
                        {
                            extend: 'selectAll',
                            className: 'selectall',
                            action: function (e) {
                                e.preventDefault();
                                table.rows({ search: 'applied' }).deselect();
                                table.rows({ search: 'applied' }).select();
                            }
                        },
                        'selectNone',
                        </text>
                    }
                    { extend: "edit", editor: profileEditor },
                    { text: 'Save', className: 'save', action: function (e) { vendorSaveBulkProfileEdits(profileEditor,table); } },
                    { text: 'Undo', className: 'undo', action: function (e) { vendorUndoBulkEdits(table); } },
					{ text: 'New', extend: 'create', editor: profileEditor },
                    {
                        extend: 'selected',
                        text: 'Delete',
                        action: function (e, dt, node, config) {
                            var rows = table.rows({ selected: true }).indexes();
                            var currentlyVisibleFields = profileEditor.fields();// getVisibleFields(editor);
                            profileEditor
                                .hide(currentlyVisibleFields)
                                .one('close', function () {
                                    setTimeout(function () {
                                        // Wait for animation
                                        profileEditor.show(currentlyVisibleFields).hide('_softdelete');
                                    }, 500);
                                })
                                .edit(rows, {
                                    title: 'Delete',
                                    message:
                                        rows.length === 1
                                            ? 'Are you sure you wish to delete this row?'
                                            : 'Are you sure you wish to delete these ' + rows.length + ' rows',
                                    buttons: 'Delete'
                                })
                                .val('_softdelete', "true");
                            table.draw();
                        }
                    },
                    { extend: 'colvis', text: 'Show/Hide Columns'},
                    {
                        text: 'Reset Filter',
                        className: 'clearFilter',
                        action: function (e) {
                            vendorProfileResetFilter(table);
                        }
                    },
                    { text: "", titleAttr: "Refresh", className: "listRefresh", action: function (e) { e.preventDefault(); refreshList(); } }
                ],
                initComplete: function () {
                    vendorProfileResetFilter(this.api());
                },
                data: bulkDataEdited,
                columns: [
                    @foreach (var col in listColumns.AsEnumerable())
                    {
                        <text>
                        {
                        </text>
                        foreach (var attr in col.Keys)
                        {
                            var attrVal = col[attr];
                            if (attrVal is OptionsFunction)
                            {
                                var optAttr = attrVal as OptionsFunction;
                                <text>
                                "@attr": @Html.Raw(optAttr.Text),
                                </text>
                            }
                            else if (attr == "render")
                            {
                                <text>
                                render: @Html.Raw(col[attr]),
                                </text>
                            }
                            else if (attrVal is bool bVal)
                            {
                                <text>
                                "@attr": @(bVal ? "true" : "false"),
                                </text>
                            }
                            else if (attrVal is string sVal)
                            {
                                <text>
                                "@attr": "@sVal",
                                </text>
                            }
                            else
                            {
                                <text>
                                "@attr": "@col[attr]",
                                </text>
                            }
                        }
                        <text>
                        },
                        </text>
                    }],
                select: {
                    style: 'os',
                    items: "row",
                    selector: 'td:first-child',
                    info: true
                }
            });
            @if (!string.IsNullOrEmpty(Model.TableVarName))
            {
                <text>
                @Model.TableVarName = table;
                </text>
            }
        table.on('draw', function () {
            if (table.rows({ selected: true }).indexes().length === 0) {
                table.buttons('.selectOnOff').disable();
            }
            else if (table.rows({ selected: true }).indexes().length === 1) {
                table.buttons('.selectOnOff').enable();
            }
            else {
                table.buttons('.selectOnOff').enable();
                table.buttons('.selectOnOff.selectOne').disable();
            }
        });
        table.on('select deselect', function (e, dt, type, indexes) {
            if (type === 'row') {
                if (table.rows({ selected: true }).indexes().length === 0) {
                    table.buttons('.selectOnOff').disable();
                }
                else if (table.rows({ selected: true }).indexes().length === 1) {
                    table.buttons('.selectOnOff').enable();
                }
                else {
                    table.buttons('.selectOnOff').enable();
                    table.buttons('.selectOnOff.selectOne').disable();
                }
            }
        });
        table.buttons('.selectOnOff').disable();
        $('#filterRow-@Model.ListId').find('.clearFilter').on('click', function (e) {
            e.preventDefault();
            $('#filterRow-@Model.ListId').find('.customFilter').val('');
            table.search('').columns().search('').draw();
        });
        $('#filterRow-@Model.ListId').find('.advancedFilter').on('click', function (e) {
            e.preventDefault();
            $('#filterRow-@Model.ListId').find('.filterToggle').toggleClass('advancedOn');
            table.columns.adjust().draw();
            table.draw();
        });
        $('.DTE_Field_InputControl > input').on('change', function (e) {
            let v = $(this).val();
            let checkbox = $(this).closest('input[type=checkbox]');
            if (v == '') { 
                checkbox.show();
            }
            else {
                checkbox.hide();
            }
        });
        $('.dteFieldCheckbox').on('click', function (e) {
            e.preventDefault();
            var checkbox = $(this).find('input[type=checkbox]');
            if (checkbox.prop('checked')) {
                checkbox.prop('checked', false);
            }
            else {
                checkbox.prop('checked', true);
            }
        });
    });
</script>
