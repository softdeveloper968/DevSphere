<div id="modal-markInvoiced" class="modal fade hidden-print" tabindex="-1">
    <div class="container vertical-alignment-helper">
        <div class="row vertical-align-center">
            <div class="col-sm-4"></div>
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                        <h4 class="modal-title" id="myModal-label">Mark As Invoiced</h4>
                    </div>
                    <div class="modal-body">
                        <div class="form-group">
                            <label for="MarkInvoiced_invoiceDate" class="control-label">Date Invoiced</label>
                            <input type="date" width="150" id="MarkInvoiced_invoiceDate" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label for="MarkInvoiced_invoiceNum" class="control-label">Invoice #</label>
                            <input type="text" width="150" id="MarkInvoiced_invoiceNum" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label for="MarkInvoiced_invoiceAmount" class="control-label">Invoice Amount</label>
                            <input type="number" width="150" id="MarkInvoiced_invoiceAmount" class="form-control" />
                        </div>
                        @*<div class="form-group">
                            <label for="MarkInvoiced_invoiceDatePaid" class="control-label">Date Paid</label>
                            <input type="date" width="150" id="MarkInvoiced_invoiceDatePaid" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label for="MarkInvoiced_invoiceNote" class="control-label">Note</label>
                            <input type="text" width="150" id="MarkInvoiced_invoiceNote" class="form-control" />
                        </div>*@
                        <div class="form-group">
                            <label id="selectedCount"></label>
                        </div>
                    </div>
                    <div class="alert alert-danger" style="display:none" role="alert"></div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-success" id="okButton">OK</button>
                        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
