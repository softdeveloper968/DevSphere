<script>
'use strict';
var profileData = [];
var bulkFields = [];
/*   format
    {
        "isRequired": true,
        "vendorIsRequired": null,
        "excelName": "",
        "isInternalVendorAttachment": false,
        "isInternalClientAttachment": false
    } */
function getProfileData() {
    var profileId = $('#profileList').val();
    const found = profileData.find((item) => item.groupProfileID == profileId);
    if (found) {
        return JSON.parse(found.jRequest || "{}");
    }
    return {};
}
function refreshProfileList(appType, appTypeState, groupId) {
    $.ajax({
        url: '@Url.Action("GetProfilesForAppType", "Vendor")',
        type: 'GET',
        data: { appType: appType, appTypeState: appTypeState, groupId: groupId },
        dataType: 'json',
        success: function (data) {
            var options = $('#profileList');
            options.empty();
            $.each(data, function (i, item) {
                profileData.push(item);
                var txt = `${item.groupProfileName}`;
                if (item.groupProfileType && item.groupProfileType.groupProfileTypeName != null) {
                    txt = `${item.groupProfileName} (${item.groupProfileType.groupProfileTypeName})`;
                }
                options.append($('<option></option>').val(item.groupProfileID).text(txt));
            });
            vendor_initGroupAttachmentNames(groupId);
            vendor_initVendorAttachmentNames();
            populateProfileForm($("#@GetListId()"), options.val());
        },
        error: function (xhr, status, error) {
            alert(error);
        }
    });
}
function getBulkFields() {
    $.ajax({
        url: '@Url.Action("GetFieldsAndAttachmentsForAppType", "AppForm")',
        type: 'GET',
        async: false,
        data: { appType: '@GetAppType()', appTypeState: '@GetAppTypeState()' },
        dataType: 'json',
        success: function (data) {
            bulkFields = [];
            $.each(data, function (i, field) {
                bulkFields.push(field);
            });
        },
        error: function (xhr, status, error) {
            alert(error);
        }
    });
}
function applyProfileToEntries() {
    var data = getProfileData();
    var editor = bulkEditor;
    var fields = editor.order();

    for (const [key, value] of Object.entries(data)) {
        if (fields.includes(key)) {
            if (typeof value == 'undefined' || value == null) {
                continue;
            }
            editor.field(key).set(value);
        }
    }
    hideBlankFields(editor);
}

const keysToSkip = ['groupProfileID', 'groupProfileTypeID', 'groupProfileName', '_softdelete'];

function getFieldInfo(fname) {
    const field = bulkFields.find((element) => element.excelName == fname);
    return field;
}
function showRequiredFields(editor) {
    $.each(editor.order(), function (idx,fname) {
        let field = getFieldInfo(fname);
        if (field) {
            if (field.isInternalVendorAttachment || field.isInternalClientAttachment) {
                editor.field(fname).show();
                return;
            }
            // Check if the field value is blank
            if (field.isRequired || field.vendorIsRequired) {
                // Show the field (in case it was previously hidden)
                editor.field(fname).show();
                return;
            }
        }
        else {
            //console.log(`field not found: ${fname}`);
        }
        // Hide the field
        editor.field(fname).hide();
    });
}
function showAllFields(editor) {
    $.each(editor.order(), function (idx,fname) {
        editor.field(fname).show();
    });
}
function showAppOnlyFields(editor) {
    $.each(editor.order(), function (idx,fname) {
        let field = getFieldInfo(fname);
        if (field) {
            editor.field(fname).show();
        }
        else {
            editor.field(fname).hide();
        }
    });
}
// Function to hide blank fields
function hideBlankFields(editor) {
    let alwaysVisible = false;
    $.each(editor.order(), function (idx,fname) {
        let field = editor.field(fname);
        // Check if the field value is blank
        if (!alwaysVisible && !field.isMultiValue() && field.multiEditable && !field.val()) {
            // Hide the field
            editor.field(fname).hide();
        } else {
            // Show the field (in case it was previously hidden)
            editor.field(fname).show();
        }
    });
}
function hideFieldsNotInProfile(editor) {
    let data = getProfileData();
    let showList = [];
    for (const [key, value] of Object.entries(data)) {
        if (value == null) continue;
        if (keysToSkip.some((element) => element == key)) continue;
        showList.push(key);
    }
    $.each(editor.order(), function (idx,fname) {
        if (showList.includes(fname)) {
            editor.field(fname).show();
        } else {
            editor.field(fname).hide();
        }
    });
}
function hookupListeners(editor, displayName) {
    $('input[type="radio"][name="showFieldTypes"]').off('change').on('change', function () {
        //console.log("display name: " + displayName);
        if (this.value == 'All') {
            //console.log("show all fields");
            showAllFields(editor);
        }
        else if (this.value == 'Required') {
            //console.log("show required fields");
            //showRequiredFields(editor);
            showBulkEditRequiredFields(editor);
        }
        else if (this.value == 'AppOnly') {
            //console.log("show app only fields");
            showAppOnlyFields(editor);
        }
        else if (this.value == 'NonBlank') {
            //console.log("hide blank fields");
            hideBlankFields(editor);
        }
        else if (this.value == 'Profile') {
            //console.log("hide fields not in profile");
            hideFieldsNotInProfile(editor);
        }
        else {
            showAllFields(editor);
        }
    });
    let groupId = vendor_UniversalBulkEditSelectedGroup($("#@GetListId()").DataTable());
    vendor_initGroupAttachmentNames(groupId);
    vendor_initVendorAttachmentNames();
    updateAttachmentSelects(editor,groupId);
}
</script>
