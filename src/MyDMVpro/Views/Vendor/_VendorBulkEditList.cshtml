@model BulkEditViewModel
@using MyDMVpro.Common.ViewHelpers;
@using MyDMVpro.Controllers;
@using System.Text.Encodings.Web;
@using System.Text.Json;
@using System.Text.Unicode;
@{
    var listColumns = Model.ListColumns;

    string GetAppType()
    {
        foreach (var item in Model.ListData)
        {
            return item["AppType"] as string;
        }
        return "";
    }
    string GetAppTypeState()
    {
        foreach (var item in Model.ListData)
        {
            return item["AppTypeState"] as string;
        }
        return "";
    }
    string GetListId()    
    {
        if (string.IsNullOrWhiteSpace(Model.ListId))
        {
            Model.ListId = "BEDIT_LISTID";
        }
        return Model.ListId;
    }
    // This function is used to encode the data field name
    // and unencode the single quote character, as it is not necessary
    // the json spec.  This is necessary for the DataTables editor
    // to work properly.
    string EncodeDataFieldName(object data)
    {
        string val = (data as string) ?? ""; // Should never occur, just in case
        var s = JsonEncodedText.Encode(val);
        string jsonString = s.ToString();
        return jsonString.Replace(@"\u0027", "'");
    }
    // Same issue here, as the JsonSerializer encodes single quotes
    // and causes issues with the DataTables editor
    string SerializeVendorEditorFields()
    {
        string jsonString = JsonSerializer.Serialize(VendorDocumentFields());
        return jsonString.Replace(@"\u0027", "'");
    }
    string SerializeEditorFields()
    {
        const char singleQuote = '\u0027';
        var encoderSettings = new TextEncoderSettings();
        encoderSettings.AllowRange(UnicodeRanges.BasicLatin);
        encoderSettings.AllowCharacters(singleQuote);

        var options2 = new JsonSerializerOptions
        {
            Encoder = JavaScriptEncoder.Create(encoderSettings)
        };
        string jsonString = JsonSerializer.Serialize(Model.EditorFields, options2);
        return jsonString.Replace("\\u0027", "'");
    }
    string IconColumnWidth() {
        return "30px";
    }
    List<Dictionary<string, object>> VendorDocumentFields() {
        List<Dictionary<string, object>> result = new();
        foreach (var field in Model.EditorFields)
        {
            if (field.ContainsKey("data"))
            {
                string excelName = field["data"] as string;
                if (excelName == null) continue;
                if (excelName.StartsWith("XV-", StringComparison.OrdinalIgnoreCase)
                    || excelName.Equals("Today's Date", StringComparison.OrdinalIgnoreCase))
                {
                    result.Add(field);
                }
            }
        }
        return result;
    }

    listColumns.Insert(0, new Dictionary<string, object>()
    {
        { "title", "" },
        { "defaultContent", "" },
        { "orderable", false },
        { "className", "select-checkbox nohide iconColumn dt-center noexport"},
        { "autowidth", false },
        { "width", $"{IconColumnWidth()}"},
        { "min-width", $"{IconColumnWidth()}"},
        { "max-width", $"{IconColumnWidth()}"},
        { "sortable", false }
    });
    string BuildDOM()
    {
        string dom = "";

        dom = "<'row'<'col-sm-6'l><'col-sm-6'<'bulkedit-profile-container'>>>"
                + "<'row'<'col-sm-12'tr>>"
                + "<'row'<'col-sm-5'i><'col-sm-7'p>><'alert row'><'col-sm-12'B>";
        if (Model.ShowColVisButton)
        {
            //dom = dom + "C";
        }

        return dom;
    }
}
