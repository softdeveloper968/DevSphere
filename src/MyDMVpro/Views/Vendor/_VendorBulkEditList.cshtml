<script asp-add-nonce="true">
    'use strict';
    var bulkDataEdited = @Html.Raw(Json.Serialize(Model.ListData));
    var bulkEditor;
    var vendorDocEditor;

    $(document).ready(function () {
        var defaultSortOrder = [];

        $.fn.dataTable.render.shortDate = datatable_render_shortdate;

        var tableId = "#@GetListId()";
        var displayName = onPageDisplay($('#bulkEditContainer'));

        vendor_initGroupAttachmentNames();
        vendor_initVendorAttachmentNames();

        vendorDocEditor = new DataTable.Editor( {
                table: tableId,
                idSrc: "RequestId",
                display: displayName,
                template: '#bulkEditFormVendorDocs',
                fields: @Html.Raw(SerializeVendorEditorFields()),
                i18n:{ "edit": { "title":  "Edit Vendor Documents" } }
        });
        bulkEditor = new DataTable.Editor( {
                table: tableId,
                idSrc: "RequestId",
                display: displayName,
                template: '#bulkEditForm',
                fields: @Html.Raw(SerializeEditorFields()),
                i18n:{ "edit": { "title":  "Edit Request" } }
        });

        configureBulkEditEditor(bulkEditor);
        configureBulkEditEditor(vendorDocEditor);
        configureDirtyPageWarning(bulkDataEdited);

        // Call this function whenever you need to check the fields, e.g., before opening the editor
        bulkEditor.on('open', function () {
            hookupListeners(bulkEditor, displayName);
        });
        vendorDocEditor.on('open', function () {
            vendor_initVendorAttachmentNames();
            updateAttachmentSelects(vendorDocEditor,null);
        });
        getBulkFields();

        //// TBD: Review if this is behavior we want
        ////  it might be too intrusive
        //var openVals;
        //editor.on( 'open', function ( e, type ) {
        //        openVals = JSON.stringify( editor.get() );
        //    });
        //editor.on( 'preBlur', function ( e ) {
        //        let newVals = JSON.stringify( editor.get() );
        //        if ( openVals !== newVals ) {
        //            return confirm( 'You have unsaved changes. Are you sure you want to exit?' );
        //        }
        //    });

        //editor.on('postEdit', function (e, json, data, id) {
        //});

        function pushColumnSort(table, sortorder, colSelector, dir) {
            let col = table.column(colSelector);
            if (col) {
                let idx = col.index();
                if (idx >= 0) {
                    sortorder.push([ col.index(), dir ]);
                }
            }
        }
        function getSortOrder(table,idx) {
            var sortorder = [];
            if (idx == 0) {
                pushColumnSort(table, sortorder, '.reqGroup', 'asc');
                pushColumnSort(table, sortorder, '.reqRTLH', 'asc');
                pushColumnSort(table, sortorder, '.reqVIN', 'asc');
            }
            if (idx == 1) {
                pushColumnSort(table, sortorder, '.reqGroup', 'asc');
                pushColumnSort(table, sortorder, '.reqDTLH', 'asc');
                pushColumnSort(table, sortorder, '.reqVIN', 'asc');
            }
            return sortorder;
        }
        function sortOrderName(idx){
            if (idx == 0) {
                return "Group,RT-LH,VIN";
            }
            if (idx == 1) {
                return "Group,DT-LH,VIN";
            }
            return "Default";
        }

        $(tableId).on( 'click', 'tbody td.editable', function (e) {
            bulkEditor.inline( this );
        } );

        var table = $(tableId)
            .DataTable({
                dom: "@Html.Raw(BuildDOM())",
                fixedColumns:   {
                   left: 1
                },
                lengthMenu: [
                    [10, 25, 50, -1],
                    [10, 25, 50, 'All'],
                ],
                createdRow: function( row, data, dataIndex ) {
                    //if ( data["RequestId"] == "A" ) {
                    //    $(row).addClass( 'rowchanged' );
                    //}
                },
                rowCallback: bulkedit_row_callback,
                rowId: 'RequestId',
                autoWidth: true,
                scrollX: true,
                sort: true,
                buttons: [
                    @if (Model.AddSelectDeselectButtons) 
                    {
                        <text>
                        {
                            extend: 'selectAll',
                            className: 'selectall',
                            action: function (e) {
                                e.preventDefault();
                                table.rows({ search: 'applied' }).deselect();
                                table.rows({ search: 'applied' }).select();
                            }
                        },
                        'selectNone',
                        </text>
                    }
                    @if (Model.EnableSortButton)
                    {<text>
                        {
                            extend: 'collection',
                            text: 'Sort',
                            "dropup": true,
                            autoClose: true,
                            background: false,
                            buttons: [
                                { text: function ( dt, button, config ) { return sortOrderName(0); }, action: function (e) { e.preventDefault(); vendor_sort_table(table,getSortOrder(table,0)); } },
                                { text: function ( dt, button, config ) { return sortOrderName(1); }, action: function (e) { e.preventDefault(); vendor_sort_table(table,getSortOrder(table,1)); } },
                                { text: "Default", className: "", action: function (e) { e.preventDefault(); vendor_sort_table(table, defaultSortOrder); } }
                            ]
                        },
                    </text>}
                    { text: 'Undo', className: 'undo', action: function (e) { vendorUndoBulkEdits(table); } },
                    { text: "Move", className: "selectOnOff selectOne", action: function (e) { e.preventDefault(); vendor_show_Move(table,true); } },
                    { text: 'Rollback', className: 'rollback', action: function (e) { vendor_show_RollbackRequests(table); } },
                    { text: 'Save', className: 'save dtBulkEditSaveButton', action: function (e) { vendorSaveBulkEdits(bulkEditor,table); } },
                    @if (Model.EnableBulkEditToInProcess)
                    {
                    <text>
                        { text: 'Save to In Processing', className: 'save', action: function (e) { vendorSaveBulkEdits(bulkEditor,table, @((int)ProcessStageIDs.InProcessing)); } },
                        { text: 'Not Ready for Processing', className: 'save', action: function (e) { vendorSaveBulkEdits_NotReady(table); } },
                    </text>
                    }
                    //'colvis'
                    { extend: 'colvis', text: 'Show/Hide Columns'},
                    {
                        text: 'Reset Filter',
                        className: 'clearFilter',
                        action: function (e) {
                            table.columns()
                                .every(function () {
                                    var column = this;
                                    if (column.searchable === false) {
                                        return;
                                    };
                                    var select = $('<select><option value=""></option></select>')
                                        .appendTo($(column.footer()).empty())
                                        .on('change', function () {
                                            var val = $.fn.dataTable.util.escapeRegex($(this).val());
                                            column.search(val ? '^' + val + '$' : '', true, false).draw();
                                        });
 
                                    column
                                        .data()
                                        .unique()
                                        .sort()
                                        .each(function (d, j) {
                                            if (d != null && d.trim() != '') {
                                                var opt = $('<option></option>').attr({ value: d }).text(d);
                                                select.append(opt);
                                            }
                                        });
                                });
                                table.search('').columns().search('').draw();
                        }
                    },
                    {
                        text: "Edit - Request", className: 'selectOnOff', 
                        action: function (e, dt, node, config) {
                            let groupId = vendor_UniversalBulkEditSelectedGroup($("#@GetListId()").DataTable());
                            if (groupId == null) { 
                                vendor_show_DataTable_alert(table, 'Bulk editing only supported for requests by the same group.');
                            }
                            else
                            {
                                updateAttachmentSelects(bulkEditor,groupId);
                                $(".profilePanel").hide();
                                // populate dropdown for group
                                refreshProfileList('@GetAppType()', '@GetAppTypeState()', groupId);
                                $(".profilePanel").show();
                                bulkEditor.title('Edit Requests')
                                        .buttons('Update')
                                        .edit('.selected');
                            }
                        }
                    },
                    {
                        text: "Edit - Vendor Docs", className: 'selectOnOff', 
                        action: function (e, dt, node, config) {
                            updateAttachmentSelects(vendorDocEditor,null);
                            $(".profilePanel").hide();
                            vendor_initVendorAttachmentNames();
                            vendorDocEditor.title('Edit Vendor Documents')
                                        .buttons('Update')
                                        .edit('.selected');
                        }
                    }
                ],
                initComplete: function () {
                    var api = this.api();
                    //.columns( function ( idx, data, node ) { idx !== 0 } )
                    api.columns()
                        .every(function () {
                            var column = this;
                            if (column.searchable === false) {
                                return;
                            };
                            var select = $('<select><option value=""></option></select>')
                                .appendTo($(column.footer()).empty())
                                .on('change', function () {
                                    var val = $.fn.dataTable.util.escapeRegex($(this).val());
 
                                    column.search(val ? '^' + val + '$' : '', true, false).draw();
                                });
 
                            column
                                .data()
                                .unique()
                                .sort()
                                .each(function (d, j) {
                                    if (d != null && d.trim() != '') {
                                        var opt = $('<option></option>').attr({ value: d }).text(d);
                                        select.append(opt);
                                    }
                                });
                        });
                    fixupColumnWidths(this);
                    datatable_addProfile(this);
                },
                data: bulkDataEdited,
                columns: [
                    @foreach (var col in listColumns.AsEnumerable())
                    {
                        <text>
                        {
                        </text>
                        foreach (var attr in col.Keys)
                        {
                            var attrVal = col[attr];
                            if (attrVal is OptionsFunction)
                            {
                                var optAttr = attrVal as OptionsFunction;
                                <text>
                                "@attr": @Html.Raw(optAttr.Text),
                                </text>
                            }
                            else if (attr == "render")
                            {
                                <text>
                                render: @Html.Raw(col[attr]),
                                </text>
                            }
                            else if (attr == "data")
                            {
                                <text>
                                data: "@Html.Raw(EncodeDataFieldName(col[attr]))",
                                </text>
                            }
                            else if (attrVal is bool bVal)
                            {
                                <text>
                                "@attr": @(bVal ? "true" : "false"),
                                </text>
                            }
                            else if (attrVal is string sVal)
                            {
                                <text>
                                "@attr": "@sVal",
                                </text>
                            }
                            else
                            {
                                <text>
                                "@attr": "@col[attr]",
                                </text>
                            }
                        }

                        <text>
                        },
                        </text>
                    }],
                select: {
                    style: 'os',
                    items: "row",
                    selector: 'td:first-child',
                    info: true
                }
            });

            @if (!string.IsNullOrEmpty(Model.TableVarName))
            {
                <text>
                @Model.TableVarName = table;
                </text>
            }

        table.on('draw', function () {
            if (table.rows({ selected: true }).indexes().length === 0) {
                table.buttons('.selectOnOff').disable();
            }
            else if (table.rows({ selected: true }).indexes().length === 1) {
                table.buttons('.selectOnOff').enable();
            }
            else {
                table.buttons('.selectOnOff').enable();
                table.buttons('.selectOnOff.selectOne').disable();
            }
        });
        table.on('select deselect', function (e, dt, type, indexes) {
            if (type === 'row') {
                if (table.rows({ selected: true }).indexes().length === 0) {
                    table.buttons('.selectOnOff').disable();
                }
                else if (table.rows({ selected: true }).indexes().length === 1) {
                    table.buttons('.selectOnOff').enable();
                }
                else {
                    table.buttons('.selectOnOff').enable();
                    table.buttons('.selectOnOff.selectOne').disable();
                }
                if (vendorDocEditor) vendorDocEditor.close();
                if (bulkEditor) bulkEditor.close();
                $(".profilePanel").hide();
            }
        });

        table.buttons('.selectOnOff').disable();
        $('#filterRow-@GetListId()').find('.clearFilter').on('click', function (e) {
            e.stopPropagation();
            $('#filterRow-@GetListId()').find('.customFilter').val('');
            table.search('').columns().search('').draw();
        });
        $('#filterRow-@GetListId()').find('.advancedFilter').on('click', function (e) {
            e.stopPropagation();
            $('#filterRow-@GetListId()').find('.filterToggle').toggleClass('advancedOn');
            table.columns.adjust().draw();
            table.draw();
        });
        $('#profileListRefresh').on('click', function (e) {
            e.preventDefault();
            var val = $('#profileList').val();
            let groupId = vendor_UniversalBulkEditSelectedGroup($("#@GetListId()").DataTable());
            refreshProfileList('@GetAppType()', '@GetAppTypeState()', groupId);
            $('#profileList').val('');
            $('#profileList').val(val);
        });
        $('#profileListApply').on('click', function (e) {
            e.preventDefault();
            applyProfileToEntries();
        });
        $('#profileListCompare').on('click', function (e) {
            e.preventDefault();
            hideFieldsNotInProfile(bulkEditor);
        });
        $('#profileList').on('change', function (e) {
            e.stopPropagation();
            var profileId = $(this).val();
            populateProfileForm($("#@GetListId()"), profileId);
        });
        $(".profilePanel").hide();
    });
</script>
