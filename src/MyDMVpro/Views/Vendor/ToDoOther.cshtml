    <div class="white_box p_15 mb_20">
    @{
        {
            VendorRequestViewModel list = new VendorRequestViewModel(VendorViewType.Other_Incoming, PageName)
                {
                    QueueTitle = "Incoming - Other",
                    QueueName = "Incoming",
                    AllowMove = true,
                    AllowStatusEdit = true
                };
            AddCommonColumns(list);

            list.Columns.Add_Group();
            list.Columns.Add_ClientRef();
