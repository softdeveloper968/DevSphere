<div id="modal-ship" class="modal fade hidden-print" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title" id="myModal-label">Ship Items</h4>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label for="courierName">Courier</label>
                    <input type="text" width="150" id="courierName" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="trackingNumber">Tracking #</label>
                    <input type="text" width="150" id="trackingNumber" class="form-control" />
                </div>
                <div class="form-group">
                    <label for="dateShipped" class="control-label">Date Shipped</label>
                    <input type="date" width="150" id="dateShipped" class="form-control" />
                </div>
                <div class="form-group">
                    <div class="checkbox">
                        <label>
                            <input type="checkbox" id="genReport" /> Generate Shipping Report
                        </label>
                    </div>
                </div>
                <div class="form-group m-0">
                    <label id="selectedCount"></label>
                </div>
            </div>
            <div class="alert alert-danger" style="display:none" role="alert"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" id="okButton">OK</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
<div id="modal-DeleteShipment" class="modal fade hidden-print" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title" id="myModal-label">Delete Shipment</h4>
            </div>
            <div class="modal-body">
                <form>
                    <input id="shipmentId" name="shipmentId" type="hidden" value="" />
                    <div class="form-group">
                        <div class="checkbox">
                            <label>
                                <input type="checkbox" id="moveToShipToLH" name="moveToShipToLH" /> Move individual requests back to Ship to LH queue
                            </label>
                        </div>
                    </div>
                    <div class="form-group m-0">
                        <label id="selectedCount"></label>
                    </div>
                </form>
            </div>
            <div class="alert alert-danger" style="display:none" role="alert"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" id="okButton">OK</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
<div id="modal-multiGroupShipment" class="modal fade hidden-print" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title" id="myModal-label">Multi-Group Shipment</h4>
                <p>Please note there are records for more than one group in this list</p>
                <div id="multiGroupList">
                </div>
            </div>
            <div class="modal-body">
            </div>
            <div class="alert alert-danger" style="display:none" role="alert"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" id="okButton">Accept multiple groups and process shipment</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Back to List</button>
            </div>
        </div>
    </div>
</div>
