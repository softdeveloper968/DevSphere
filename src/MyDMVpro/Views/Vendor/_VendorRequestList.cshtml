                                    data.jsonFilter = jsonFilter;
                                }
                                else { 
                                    data.jsonFilter = null;
                                }

                                var paymentCreditType; 
                                var paymentDebitType; 
                                var filterPaymentType = $('#filterPaymentTypeID').val();  
                                var paymentDate = $('#reportPaymentDate').val();  

                                if(filterPaymentType == "credit"){
                                   paymentCreditType = $('#reportCreditPaymentType').val();  

                                }
                                else{
                                   paymentDebitType = $('#reportDebitPaymentType').val();  

                                }

                                var selectedAppType = []; 

                                var appType = $('#reportAppType').val() || [];  

                                var selectedState = []; 

                                var stateType = $('#reportStateType').val() || []; 
                                var selectedStateString;
                                var selectedAppTypeString;

                                let selectedPaymentType = $("#filterPaymentTypeID").val();

                                 if (selectedPaymentType === "credit") {
                                     data.isCredit = true;
                                 } 
                                 else if (selectedPaymentType === "debit") {
                                     data.isCredit = false;
                                 }
                                 else {
                                     data.isCredit = null;
                                 }

                                if (stateType.length > 0) {
                                    selectedState = [...stateType]; 
                                    selectedStateString = selectedState.join(","); 
                                }

                                if (appType.length > 0) {
                                    selectedAppType = [...appType]; 
                                    selectedAppTypeString = selectedAppType.join(","); 
                                }

                                if (paymentCreditType) data.paymentType = paymentCreditType;
                                if (paymentDebitType) data.paymentType = paymentDebitType;
                                if (paymentDate) data.paymentDate = paymentDate; 
                                if (selectedStateString) data.stateType = selectedStateString;
                                if (selectedAppTypeString) data.appType = selectedAppTypeString;

