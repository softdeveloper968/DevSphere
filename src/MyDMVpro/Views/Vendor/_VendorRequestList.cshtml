                                            text: "Update ETAs",
                                            className: "BulkUpdateETA noEditInvoicingAccess",
                                            action: function (e, dt, button, config) {
                                                e.preventDefault();
                                                vendor_BulkUpdateETA(table);
                                            },
                                        },
                                        {
                                            text: "Universal",
                                            className: "BulkUpdateUniversal noEditInvoicingAccess",
                                            action: function (e, dt, button, config) {
                                                e.preventDefault();
                                                vendor_UniversalBulkEdit('@Model.QueueTitle', table);
                                            },
                                        }
                                    ]
                                },
                            </text> }                    
                            @if (Model.AddExpandNotesOption || Model.AddIncludeArchivedOption) {<text>
                                {
                                    extend: 'collection',
                                    text: 'Options',
                                    "dropup": true,
                                    className: "noEditInvoicingAccess",
                                    autoClose: true,
                                    background: false,
                                    buttons: [
                                        @if (Model.AddExpandNotesOption) { <text>
                                        {
                                            text: function (dt, button, config) { return GetExpandNotesButtonText("@Model.ListId"); },
                                            className: "btnExpandNotes noEditInvoicingAccess",
                                            action: function (e, dt, button, config) {
                                                e.preventDefault();
                                                var btnText = "Expand Notes";
                                                if (ToggleExpandNotes(table, "@Model.ListId") == "true") {
                                                    btnText = "Collapse Notes";
                                                }
                                                button.find('a').text(btnText);
                                            },
                                        },
                                        </text>}
                                        @if (Model.AddIncludeArchivedOption) { <text>
                                        {
                                            text: function (dt, button, config) { return GetIncludedArchivedButtonText("@Model.ListId"); },
                                            className: "btnIncludeArchived noEditInvoicingAccess",
                                            action: function (e, dt, button, config) {
                                                e.preventDefault();
                                                var btnText = "Include Archived";
                                                if (ToggleIncludeArchived(table, "@Model.ListId") == "true") {
                                                    btnText = "Exclude Archived";
                                                }
                                                button.find('a').text(btnText);
                                            }
                                        },
                                        </text>}
                                    ]
                                },
                            </text> }
                            @if (Model.EnablePresets) { <text>
                            {
                                extend: 'collection',
                                text: 'Presets',
                                className: "noEditInvoicingAccess",
                                dropup: true,
                                background: false,
                                buttons: [
                                    {
                                        extend: 'colvisGroup',
                                        text: 'Show all',
                                        className: "noEditInvoicingAccess",
                                        show: ':hidden:not(.hidcol)'
                                    },
                                    {
                                        extend: 'colvisGroup',
                                        text: 'Show none',
                                        className: "noEditInvoicingAccess",
                                        hide: ':visible:not(.nohide)'
                                    },
                                    {
                                        extend: 'colvisGroup',
                                        text: 'Vehicle Info',
                                        className: "noEditInvoicingAccess",
                                        show: '.vehinfo',
                                    },
                                    {
                                        extend: 'colvisGroup',
                                        text: 'Invoice Detail',
                                        className: "noEditInvoicingAccess",
                                        show: '.invdetail'
                                    }]
                            },
                            </text> }
                            @if (Model.EnableReportBuilder) { <text>
                            {
                                extend: 'colvis',
                                dropup: true,
                                className: "noEditInvoicingAccess",
                                text: 'Report Builder',
                                columns: ':not(.hidcol):not(.noexport)',
                                collectionLayout: 'fixed four-column',
                                columnText: function (dt, idx, title) {
                                    if (title == '') {
                                        return (idx + 1) + ':  untitled';
                                    }
                                    else {
                                        return title;
                                    }
                                }
                            },
                            </text>}
                            @if (
                                /* Ready for Printing lists */
                                Model.ViewType == VendorViewType.RT_ReadyForPrinting || 
                                Model.ViewType == VendorViewType.Other_ReadyForPrinting || 
                                Model.ViewType == VendorViewType.TC_ReadyForPrinting || 
                                Model.ViewType == VendorViewType.LI_ReadyForPrinting || 
                                /* Ready for Packing lists */
                                Model.ViewType == VendorViewType.RT_ReadyForPacking ||
                                Model.ViewType == VendorViewType.Other_ReadyForPacking || 
                                Model.ViewType == VendorViewType.TC_ReadyForPacking || 
                                Model.ViewType == VendorViewType.LI_ReadyForPacking ||
                                /* WV Rejections */
                                Model.ViewType == VendorViewType.RT_WVRejections
                                ) { 
                                <text>
                                { text: "Print Attachments", className: "selectOnOff  noEditInvoicingAccess", attr: { id: "printAttachments" }, action: function (e) { e.preventDefault(); vendorVerifyAndDisplayAttachmentsForPrinting_Action(table); } },
                                { text: "Merge Applications", className: "selectOnOff  noEditInvoicingAccess", attr: { id: "mergeApplication" }, action: function (e) { e.preventDefault(); vendorVerifyAndDisplayMergeApplicationsForPrinting_Action(table); } },
                                { text: "Merge Checks", className: "selectOnOff  noEditInvoicingAccess", attr: { id: "mergeChecks" }, action: function (e) { e.preventDefault(); vendorVerifyAndDisplayCheckMerge_Action(table); } }
                                </text>
                            }
                        ],
                             </text>
                        }
                    initComplete: function (settings, json) {
                            
                            if(json?.data.length == 0){
                               SetStartCompleteButton(tblid);
                            }

                            @if (Model.ViewType == VendorViewType.UnbilledList)
                            { <text>
                                setTimeout(() => disableButtons(), 100);
                                </text>
                            }

                            @if (Model.ViewType == VendorViewType.Audits ||
                                Model.ViewType == VendorViewType.PCodeAudit ||
                                Model.ViewType == VendorViewType.HoldAudit ||
                                Model.ViewType == VendorViewType.IncomingAudit ||
                                Model.ViewType == VendorViewType.FollowupAudit)
                            {
                                <text>
                                    SetheaderForPreviousCompleteButton(table, tblid);
                                </text>
                            }
                            var api = this.api();
                            colFilters = json.columnFilters;
                            @if (Model.ViewType == VendorViewType.Master)
                            {
                                @:defaultStatusFilterValue = '@DataHelpers.GetDefaultFilterValue("Vendor_Master", "Status")';
                            }
                            @if (Model.EnableFilter) {
                                <text>
                                api.columns(['.reqNo']).every(getfn_datatable_reqno_search(tblid)); // Make all reqNo fields searchable
                                api.columns(['.asearch']).every(getfn_datatable_asearch(tblid));
                                api.columns(['.usersearch']).every(getfn_datatable_usersearch(tblid));
                                api.columns(['.outcomesearch']).every(getfn_datatable_outcomesearch(tblid));
                                api.columns(['.dsearch']).every(getfn_datatable_dsearch(tblid));
                                api.columns(['.reqVIN']).every(getfn_datatable_vin(tblid, @getbool(Model.AllowMultilineVin)));
                                api.columns(['.reqClientRef']).every(getfn_datatable_clientref(tblid));
                                api.columns(['.emptyornot']).every(getfn_datatable_emptyornotfilter(tblid, true));
                                api.columns(['.reqSpecialBilling']).every(getfn_datatable_getyesnofilter(tblid));
                                api.columns(['.processingDaysearch']).every(getfn_datatable_processingDaysearch(tblid));
                                api.columns(['.allStatesFilter']).every(getfn_datatable_allStatesFilter(tblid));
                                refreshDropdownFilters(api, tblid, colFilters, defaultStatusFilterValue, @getbool(Model.IncludeCancelledStatus));
                                </text>
                            }
                            initCompleted = true;
                            fixupColumnWidths(this);
                            datatable_initcomplete(tblid);
                        },
                    "dom": "@Html.Raw(BuildDOM())",
                    @if ((Model.ViewType == VendorViewType.UnbilledList) && Model.AllowAddToInvoice)
                    {
                        @:"rowCallback": datatable_rowCallback_unbilled,
                    }
                    else
                    {
                    if (Model.ViewType != VendorViewType.Audits && Model.ViewType != VendorViewType.PCodeAudit && Model.ViewType != VendorViewType.HoldAudit && Model.ViewType != VendorViewType.IncomingAudit && Model.ViewType != VendorViewType.FollowupAudit) {
                        @:"rowCallback": datatable_rowCallback_etaCheck,
                    }
                    }

        });
        
        @if (Model.ViewType == VendorViewType.LinkedRequests){<text>
            @*{ // Add instance data
                var dt = $("#@Model.ListId");
                dt.data("reqid", '@Model.PrimaryRequestId');
                dt.data("reqno", '@Model.PrimaryRequestNo');
                dt.data("vin", '@Model.PrimaryVIN');
            }*@
        </text>}
        @if (Model.EnableKeyNavigation){<text>
            var shiftKeyDown = false;
            var ctrlKeyDown = false;
            document.addEventListener('keydown', function (e) {
                if (e.shiftKey) {//shift
                    shiftKeyDown = true;
                }
                else if (e.ctrlKey) {//ctrl
                    ctrlKeyDown = true;
                }
            });
            document.addEventListener('keyup', function (e) {
                if (e.keyCode === 16) { //shift
                    shiftKeyDown = false;
                }
                else if (e.keyCode === 17) { //ctrl
                    ctrlKeyDown = false;
                }
            });
            table.on('key-focus.dt', function (e, datatable, cell) {
                var row = table.row(cell.index().row);
                if (shiftKeyDown || ctrlKeyDown) {
                    //if (row.selected()) {
                    //    row.deselect();
                    //}
                    //else {
                    //    row.select();
                    //}
                    row.select();
                }
                else {
                    table.rows().deselect();
                    row.select();
                }
            });

            table.on('key-blur.dt', function (e, datatable, cell) {
                if (!shiftKeyDown && !ctrlKeyDown) {
                    table.row(cell.index().row).deselect();
                }
            });
            // Handle click on table cell
            table.on('click', 'tbody td', function(e){
                e.stopPropagation();

                // Get index of the clicked row
                var rowIdx = table.cell(this).index().row;
                var row = table.row(rowIdx);
                if (row.selected()) {
                    row.deselect();
                } else {
                    // Select row
                    row.select();
                }
            });
        </text>}
        @if (Model.EnableKeyShortcuts){<text>
            table.on('key.dt', function (e, datatable, key, cell, originalEvent) {
                if (key === 32) {
                    // Toggle selection
                    var row = table.row(cell.index().row);
                    if ($(row.node()).hasClass('selected'))
                        row.deselect();
                    else
                        row.select();
                }
                else if (key === 65) { // 'a'
                    var data = table.row(cell.index().row).data();
                    showAttachments(data.requestId, data.vin);
                }
                else if (key === 67) { // 'c'
                    var data = table.row(cell.index().row).data();
                    showChat(data.requestId, data.vin);
                }
                else if (key === 69) { // 'e'
                    var data = table.row(cell.index().row).data();
                    vendorEditRequest(data.requestId);
                }
            });
        </text>}

        @Model.TableVarName = table;

        table.on( 'order.dt', function () {
            var order = table.order();
            let html = "";
            for (let i = 0; i < order.length; i++) {
                let colidx = order[i][0];
                let title = $(table.column(colidx).header()).html();
                html += (i > 0 ? ', ' : '') + title + ' (' + order[i][1] + ')';
            }
            html = `Sorted by ${html}`;
            $('#@(Model.ListId)_wrapper').find('#orderInfo').html(html);
        } );

        
        $('#reportCreditPaymentType').on('change', function () {
            table.ajax.reload(); 
        });

         $('#reportDebitPaymentType').on('change', function () {
            table.ajax.reload(); 
        });

        $('#reportPaymentDate').on('change', function () {
            table.ajax.reload();
        });

        $('#reportAppType').on('change', function () {
            table.ajax.reload();
        });

        $('#reportStateType').on('change', function () {
            table.ajax.reload();
        });

        $('#paymentFilterResetButton').on('click', function () {
             var $form = $("#payment_disbursement_filter_section");
             $form.find("#creditTypePaymentDiv").hide();
             $form.find("#debitTypePaymentDiv").hide();
             var paymentCreditType = $('#reportCreditPaymentType').val("");  
             var paymentDebitType = $('#reportDebitPaymentType').val("");  
             $(".js-select2-multi").val(null).trigger('change');
             $('#filterPaymentTypeID').val("");  
             $("#reportPaymentDate").val('');
             table.ajax.reload();


        });

         $("#filterPaymentTypeID").change(function () {
            var $form = $("#payment_disbursement_filter_section");
            var selectedType = ($(this).val());

            if (selectedType === "credit") {
                var paymentDebitType = $('#reportDebitPaymentType').val("");  
                table.ajax.reload();
                $form.find("#creditTypePaymentDiv").show();
                $form.find("#debitTypePaymentDiv").hide();
            } else if(selectedType === "debit") {
                var paymentCreditType = $('#reportCreditPaymentType').val("");  
                table.ajax.reload();
                $form.find("#debitTypePaymentDiv").show();
                $form.find("#creditTypePaymentDiv").hide();
            }
            else{
                $form.find("#creditTypePaymentDiv").hide();
                $form.find("#debitTypePaymentDiv").hide();
            }
        });

         var selectedGroupID;
         var selectedAttachmentTypeId;

        $('#GroupId_NoRequest').change(function () {
            var selectedId = $(this).val(); 
            selectedGroupID = selectedId
        });

         $('#AttachmentType_NoRequest').change(function () {
            var selectedId = $(this).val(); 
            selectedAttachmentTypeId = selectedId
        });

        $("#addDocumentForm").off("submit").on("submit", function (event) {
            event.preventDefault();
            var formData = new FormData(this);
            if(selectedGroupID == "" || selectedGroupID == null){
                alert("please select Group First")
                return
            }

            if(selectedAttachmentTypeId == "" || selectedAttachmentTypeId == null){
                 alert("please select attachment type First")
                 return
            }

            formData.append("GroupId", selectedGroupID);
            formData.append("AttachmentTypeId", selectedAttachmentTypeId);

            $.ajax({
                url: '@Url.Action("Create", "DocumentsReceivedNoRequest")',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    if (response.success) {
                        $('#addDocumentModal').modal('hide');
                        $('#addDocumentForm')[0].reset();
                        selectedGroupID = null;
                        var table = $('#DocumentsReceived_NoRequest').DataTable();
                        table.ajax.reload();
                    }
                    else
                    {
                      alert(response.message);
                    }
                    
                },
                error: function (xhr) {
                    alert('Error adding document. Please try again.');
                    jqToast.error({ text: 'Error adding document. Please try again.' });
                }
            });
        });

        @if (Model.ViewType != VendorViewType.LinkedRequests)
        { <text>
            $('#@Model.ListId tbody').on('click', 'td.details-control', function(e) {
                e.stopPropagation();
                var tr = $(this).closest('tr');
                var row = table.row(tr);

                if (row.child.isShown()) {
                    // This row is already open - close it
                    row.child.hide();
                    tr.removeClass('shown');
                }
                else {
                    // Open this row
                    vendorShowNotes(row.data(), tr, row);
                }
            });
        </text>}
      
        $('#@Model.ListId tbody').on('click', 'td.attDD', function (e) {
            e.stopPropagation();
            var tr = $(this).closest('tr');
            var row = table.row(tr);
            var rdata = row.data();
            showAttachments(rdata.requestId, rdata.vin);
        });
       
        table.on('draw', function () {
            if (table.rows({ selected: true }).indexes().length === 0) {
                table.buttons('.selectOnOff').disable();
            }
            else if (table.rows({ selected: true }).indexes().length === 1) {
                table.buttons('.selectOnOff').enable();
            }
            else {
                table.buttons('.selectOnOff').enable();
                table.buttons('.selectOnOff .selectOne').disable();
            }
        });

        @if (Model.ViewType == VendorViewType.Audits || Model.ViewType == VendorViewType.PCodeAudit ||Model.ViewType == VendorViewType.HoldAudit || Model.ViewType == VendorViewType.IncomingAudit 
        || Model.ViewType == VendorViewType.FollowupAudit)
            {   <text>
                    table.on('select deselect', function (e, dt, type, indexes) {
                if (type === 'row') {
                var allRowsHaveClass = true;
        
                table.rows().every(function () {
                    if (!$(this.node()).hasClass('row-Frozen')) {
                        allRowsHaveClass = false;
                        return false; 
                    }
                });

                if (!allRowsHaveClass || table.rows({ selected: true }).indexes().length === 0) {
                    table.buttons('.selectOnOff').disable();
                } else if (table.rows({ selected: true }).indexes().length === 1) {
                    table.buttons('.selectOnOff').enable();
                } else {
                    table.buttons('.selectOnOff').enable();
                    table.buttons('.selectOnOff .selectOne').disable();
                }
            }
        });          
        </text>
        }
        else
        {
            <text>
                table.on('select deselect', function (e, dt, type, indexes) {
                if (type === 'row') {
                    if (table.rows({ selected: true }).indexes().length === 0) {
                        table.buttons('.selectOnOff').disable();
                    }
                    else if (table.rows({ selected: true }).indexes().length === 1) {
                        table.buttons('.selectOnOff').enable();
                    }
                    else {
                        table.buttons('.selectOnOff').enable();
                        table.buttons('.selectOnOff .selectOne').disable();
                    }
                }
            });
            </text>
        }

        table.buttons('.selectOnOff').disable();

        $('#filterRow-@Model.ListId').find('.clearFilter').on('click', function (e) {
            e.stopPropagation();
            $('#filterRow-@Model.ListId').find('.customFilter').val('');
            table.search('').columns().search('').draw();
        });

        $('#filterRow-@Model.ListId').find('.advancedFilter').on('click', function (e) {
            e.stopPropagation();
            $('#filterRow-@Model.ListId').find('.filterToggle').toggleClass('advancedOn');
            table.columns.adjust().draw();
            //table.draw();
        });

        @if (Model.ViewType == VendorViewType.UnbilledList)
        {
            <text>
                $("#feePanel").empty('');
                table.on('select deselect', function (e, dt, type, indexes) {
                    vendorSelectUnbilledInvoiceItem_Action(table);
                });
            </text>
        }   
        
  });
</script>
