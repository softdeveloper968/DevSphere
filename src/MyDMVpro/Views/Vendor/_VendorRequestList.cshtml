@model VendorRequestViewModel
@using MyDMVpro.Common.ViewHelpers;
@{
    string SortableIconColumnWidth()
    {
        return "36px";
    }
    string IconColumnWidth() {
        return "30px";
    }
    var columnCount = 0;
    string filterList()
    {
        List<string> filterFields = new List<string>();
        foreach (DatatableColumnInfo col in Model.Columns)
        {
            if (!string.IsNullOrEmpty(col.FilterField))
            {
                filterFields.Add(col.FilterField);
            }
        }
        return string.Join(",", filterFields);
    }
    string BuildDOM()
    {
        if (Model.ViewType == VendorViewType.FormAnalyzer)
        {
            return "t";
        }

        string dom = "";
        if (Model.ViewType == VendorViewType.LinkedRequests || Model.ViewType == VendorViewType.LinkSearch)
        {
            dom = "<'row'<'col-sm-12't>"
                    + "<'col-sm-12'B>>";
        }
        else
        {
            dom = "<'row'<'col-sm-6'l><'col-sm-6'<'#buttonContainer.site-datatable-button-container'C>>>"
            + "<'row'<'col-sm-12'tr>>"
            //+ "<'row'<'col-sm-5'i><'col-sm-7'p>><'#feePanel'><'alert row'><'col-sm-12'B>";
            + "<'row'<'col-sm-4'i><'col-sm-1'><'#orderInfo.col-sm-4'><'col-sm-3'p>><'#feePanel'><'alert row'><'col-sm-12'B>";
            if (Model.ShowColVisButton)
            {
                //dom = dom + "C";
            }
        }
        return dom;
    }
    string OrderableOption(bool f)
    {
        if (Model.AllowSort && f)
        {
            return "true";
        }
        return "false";
    }
    string OrderSequenceOption()
    {
        if (Model.AllowSort)
        {
            return ",\"orderSequence\": [\"desc\",\"asc\"]";
        }
        return "";
    }
    string SortableOption(bool f)
    {
        if (Model.AllowSort && f)
        {
            return "true";
        }
        return "false";
    }
    string SearchableOption(bool f)
    {
        if (Model.EnableFilter && f)
        {
            return "true";
        }
        return "false";
    }
    if (Model.AddLinkIcon)
    {
        for (int i = 0; i < Model.Columns.Count; i++)
        {
            if (Model.Columns[i].Class == "reqChkbx")
            { 
                Model.Columns.Insert(i+1, new DatatableColumnInfo(){ Title="", Class="reqHasLink"});
                break;
            }
        }
    }
    if (Model.AddLastModified)
    {
        Model.Columns.Add("Modified", "reqLastMod dsearch nowrap");
    }
    if (Model.AddLastModifiedBy)
    {
        bool hasFilter = false;
        foreach (var c in Model.Columns)
        {
            if (!string.IsNullOrEmpty(c.FilterField))
            {
                hasFilter = true;
                break;
            }
        }
        Model.Columns.Add_ModifiedBy(hasFilter);
    }
    Model.Columns.Add_RequestId();

    string getbool(bool f)
    {
        if (f) return "true";
        return "false";
    }
}
