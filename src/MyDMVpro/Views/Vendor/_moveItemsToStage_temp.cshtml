<div id="modal-moveToStage" class="modal fade hidden-print" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title" id="myModal-label">Move Items to <span style="font-weight:bold" id="moveItemsToStage"></span></h4>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="form-group" style="text-align:center;margin:5px 25px 5px 25px">
                        Applications that are not ready for processing must have a client facing note detailing what is needed
                    </div>
                </div>
                <div class="row">
                    <div style="" class="col-lg-6">
                        <input type="hidden" id="requestId" name="requestId" />
                        <div class="form-group" style="display:none">
                            <label for="stage" class="control-label">Stage</label>
                            <input id="stage" name="stage" maxlength="25" class="form-control" />
                        </div>
                        <div class="form-group">
                            <label for="code" class="control-label required">Code</label>
                            <input id="code" name="code" maxlength="10" class="form-control" required="required" />
                        </div>
                        <div class="form-group">
                            <label for="Note" class="required">Note</label>
                            <textarea id="note" name="note" cols="80" placeholder="" required="required" class="form-control"></textarea>
                        </div>
                        <div class="form-group">
                            <label for="Remark">Internal remarks</label>
                            <textarea id="remark" name="remark" cols="80" placeholder="" class="form-control"></textarea>
                        </div>
                    </div>
                    <div style="" class="col-lg-6 pull-right">
                        <div class="">
                            <div class="chatsEditPanel" tabindex="-1">
                                <div class="">
                                    <fieldset>
                                        <legend id="myModal-label">Chat</legend>
                                        <div class="panel-body chat-body" style="max-height: 300px;"></div>
                                        <div class="panel-footer" style="">
                                            <form asp-controller="Chats" asp-action="Create" method="post" class="chatform">
                                                <input type="hidden" name="RequestId" id="chat-RequestId" />
                                                <textarea class="form-control" name="Message" id="chat-newMsg" rows="4" width="100%" placeholder="Type message" style="resize:none;"></textarea>
                                                <div style="width:100%;">
                                                    <input type="submit" value="Send" class="btn btn-primary" />
                                                    <button type="button" id="chatMarkAsRead" class="btn btn-default">Mark As Read</button>
                                                    <button type="button" id="chatRefreshBtn" class="btn">Refresh</button>
                                                </div>
                                            </form>
                                        </div>
                                    </fieldset>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div style="display:none" class="alert alert-danger">Code and client facing note are required</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" id="okButton">OK</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
