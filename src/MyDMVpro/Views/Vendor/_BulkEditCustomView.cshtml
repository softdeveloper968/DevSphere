    }
    #bulkEditForm {
        display: flex;
        flex-flow: row wrap;
        width: 860px;
    }
        #bulkEditForm fieldset {
            flex: 1;
            border: 1px solid #aaa;
            margin: 0.5em;
        }
            #bulkEditForm fieldset legend {
                padding: 5px 20px;
