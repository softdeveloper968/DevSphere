            }
                #bulkEditForm fieldset.profileType legend {
                    background: #ffffbf;
                }
            #bulkEditForm fieldset.profileValues {
                flex: 2 100%;
            }
                #bulkEditForm fieldset.profileValues legend {
                    background: #ffbfbf;
                }
        #bulkEditForm div.DTE_Field {
            padding: 5px;
        }
    html.dark #bulkEditForm fieldset.profileName legend {
        background: #005c00;
    }
    html.dark #bulkEditForm fieldset.profileType legend {
        background: #6a6a00;
    }
    html.dark #bulkEditForm fieldset.profileValues legend {
        background: #ffff77;
    }
    .inputHolder {
        display: inline-block;
        width: 100%;
    }
    .hiddenHolder {
        display: none !important;
    }
    .BEDIT_dualcolumn > label.control-label {
        width: 20% !important;
    }
    .BEDIT_dualcolumn > input.BEDIT_textRightInput {
        width: 40% !important;
    }
    .BEDIT_dualcolumn > input.BEDIT_textLeftInput {
        width: 40% !important;
    }
    .BEDIT_textRightInput {
        background-color: aqua;
    }
    .BEDIT_textLeftInput {
        padding-right: 50px;
    }
    .BEDIT_textRightHidden {
        display: none;
    }
    .BEDIT_centerSpan {
        display: inline-block;
        width: 50px;
    }
    div.bulkRadio > label {
        margin-right: 10px;
    }
