    $(document).ready(function () {

        let amountInput = document.getElementById("StripeAmount");
        let serviceChargeInput = document.getElementById("StripeServiceCharge");
        let StripePaymentMethod = document.getElementById("StripePaymentTypeId");


        StripePaymentMethod.addEventListener("change", function () {
            var StripePaymentMethod = $("#StripePaymentTypeId").val();

            let X = parseFloat(amountInput.value) || 0;
            let Y = 0;

            if (StripePaymentMethod === "card") {
                // Credit Card Fee Calculation
                Y = (X + 0.30) / 0.971;
            } else if (StripePaymentMethod === "us_bank_account") {
                // ACH Fee Calculation
                if (X <= 625) {
                    Y = X / 0.992;
                } else {
                    Y = X + 5.00;
                }
            }

            // Ensure Y is rounded to two decimal places
            serviceChargeInput.value = (Y - X).toFixed(2);
        });

        amountInput.addEventListener("input", function () {
            var StripePaymentMethod = $("#StripePaymentTypeId").val();

            let X = parseFloat(amountInput.value) || 0;
            let Y = 0;

            if (StripePaymentMethod === "card") {
                // Credit Card Fee Calculation
                Y = (X + 0.30) / 0.971;
            } else if (StripePaymentMethod === "us_bank_account") {
                // ACH Fee Calculation
                if (X <= 625) {
                    Y = X / 0.992;
                } else {
                    Y = X + 5.00;
                }
            }

            // Ensure Y is rounded to two decimal places
            serviceChargeInput.value = (Y - X).toFixed(2);
        });

        $("#copyPayLinkButton").click(function () {
            var amount = $("#StripeAmount").val();
            var StripePaymentType = $("#StripePaymentTypeId").val();
            var StripeServiceCharge = $("#StripeServiceCharge").val();
            var reqid = '@ViewData["RequestId"]';
            var reqno = '@ViewData["RequestNo"]';
            var vin = '@ViewData["VIN"]';

            if (amount == null || amount == "" || amount == undefined) {
                jqToast.error({ text: 'Please enter amount first!' });
            }
            else if (StripePaymentType == null || StripePaymentType == "" || StripePaymentType == undefined) {
                jqToast.error({ text: 'Please select payment type!' });
            }
            else {

                $.ajax({
                    url: "/Stripe/CreatePaymentLink",
                    type: "POST",
                    headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                    data: {
                        amount: amount,
                        currency: "usd",
                        successUrl: "",
                        cancelUrl: "",
                        requestId: reqid,
                        vin: vin,
                        paymentMethodType: StripePaymentType,
                        serviceCharge: StripeServiceCharge
                    },
                    success: function (response) {
                        if (!response.url) {
                            jqToast.error("Failed to generate payment link.")
                            return;
                        }

                        if (response.message) {
                            $("#paymentMessage").text(response.message);
                            $("#paymentMessage1").text(response.url);
                            const paymentSection = document.getElementById('paymentMessageDiv');
                            paymentSection.style.display = 'block'; 
                        } else {
                            const paymentSection = document.getElementById('paymentMessageDiv');
                            paymentSection.style.display = 'none';
                        }

                        const tempInput = document.createElement('input');
                        tempInput.value = response.url;
                        document.body.appendChild(tempInput);
                        tempInput.select();
                        try {
                            document.execCommand('copy');
                            jqToast.success({
                                text: 'Link copied to clipboard!'
                            });
                        } catch (err) {
                            console.error("Fallback: Failed to copy text: ", err);
                            jqToast.error({
                                text: 'Failed to copy the link. Please try again.'
                            });
                        }
                        document.body.removeChild(tempInput);
                       
                        getPaymentLinks(reqid)
                    },
                    error: function (xhr, status, error) {
                        console.error("Error:", xhr.responseText);
                        alert("Payment request failed. Please try again.");
                    }
                });
            }
        });

        $("#payNowBtn").click(function () {
            var amount = $("#StripeAmount").val();
            var StripePaymentType = $("#StripePaymentTypeId").val();
            var StripeServiceCharge = $("#StripeServiceCharge").val();
            var reqid = '@ViewData["RequestId"]';
