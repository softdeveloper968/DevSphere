        function displayTax(data) {
            var $tbody = $("#itemGridRP");
            $tbody.empty(); // Clear existing rows
            if (!data || typeof data !== "object") {
                console.error("Invalid data format", data);
                return;
            }
            // Normalize object keys to lowercase for case-insensitive access
            const normalizedData = {};
            Object.keys(data).forEach(key => {
                normalizedData[key.toLowerCase()] = data[key];
            });
            const taxItems = normalizedData.calculatedtaxitems || [];
            if (!Array.isArray(taxItems)) {
                console.error("Invalid data format", data);
                return;
            }
            // Loop through tax items and append them to the table
            taxItems.forEach(item => {
                const normalizedItem = {};
                Object.keys(item).forEach(key => {
                    normalizedItem[key.toLowerCase()] = item[key];
                });
                var row = `
                <tr>
                    <td>${normalizedItem.itemname || ''}</td>
                    <td>
                        <div class="d-flex items-center" style="display: flex;">
                            <span class="tax-currency-symbol">$</span>
                            <input type="number" class="form-control" placeholder="Enter value"
                                   name="itemValueRP_${normalizedItem.itemid || ''}" data-item-name="${normalizedItem.itemname || ''}"
                                   value="${normalizedItem.value || ''}" />
                        </div>
                    </td>
                    <td>
                        <div class="d-flex items-center" style="display: flex;">
                            <span class="tax-currency-symbol">$</span>
                            <input type="text" class="form-control taxable-amount"
                                       name="taxableAmountRP_${normalizedItem.itemid || ''}" data-item-name="${normalizedItem.itemname || ''}"
                                               value="${normalizedItem.taxableamount || ''}"
                                   readonly />
                        </div>
                    </td>
                    <td>
                        <div class="d-flex items-center" style="display: flex;">
                            <span class="tax-currency-symbol">$</span>
                            <input type="text" class="form-control tax-due"
                                       name="taxDueRP_${normalizedItem.itemid || ''}" data-item-name="${normalizedItem.itemname || ''}"
                                               value="${normalizedItem.taxdue || ''}"
                                   readonly />
                        </div>
                    </td>
                </tr>
            `;
                $tbody.append(row);
            });
            // Populate totals
            $("#calTotalTaxableAmountRP").val(
                !normalizedData.totaltaxableamount || isNaN(normalizedData.totaltaxableamount) ?
                '$0' :
                '$' + parseFloat(normalizedData.totaltaxableamount).toString()
            );
            $("#calTotalTaxDueRP").val(
                !normalizedData.totaltaxdue || isNaN(normalizedData.totaltaxdue) ?
                '$0' :
                '$' + parseFloat(normalizedData.totaltaxdue).toString()
            );
            $("#calTotalTaxPaidOtherStateRP").val(
                !normalizedData.totaltaxpaidotherstate || isNaN(normalizedData.totaltaxpaidotherstate) ?
                '$0' :
                '$' + parseFloat(normalizedData.totaltaxpaidotherstate).toString()
            );
            $("#calTotalLeftOverTitlingStateRP").val(
                !normalizedData.totalleftovertitlingstate || isNaN(normalizedData.totalleftovertitlingstate) ?
                '$0' :
                '$' + parseFloat(normalizedData.totalleftovertitlingstate).toString()
            );
        }

        function displayRegistration(regItems, calculatedRegResult) {
            var $regTbody = $("#regItemGrid");
