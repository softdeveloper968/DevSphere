<div>
    <div id="calculateSectionPanel" style="display: none;">
        <div class="table-responsive white_box p_15 mb_20">
            <div style="display: flex; justify-content: space-between; align-items: center;gap:20px; margin:inherit">
                <div style="display: flex;align-items: center;">
                    <h2 class="sub_heading">Tax Items</h2>
                    <i class="fa fa-info-circle info-icon" id="infoIconRP"></i>
                </div>
                <button type="button" class="btn btn-success custom_btn" id="saveTaxButton">Save</button>
                <button type="button" class="btn btn-primary custom_btn" id="calculateButtonRP">Calculate</button>

            </div>
            <table class="table table-responsive">
                <thead>
                    <tr>
                        <th>Item Name</th>
                        <th>Value</th>
                        <th>Taxable Amount</th>
                        <th>Tax Due</th>
                    </tr>
                </thead>
                <tbody id="itemGridRP">
                </tbody>
            </table>
            <div>
                <label>Total Taxable Amount:</label>
                <input type="text" id="calTotalTaxableAmountRP" class="form-control" readonly />

                <label>Total Tax Due:</label>
                <input type="text" id="calTotalTaxDueRP" class="form-control" readonly />

                <label>Total Tax Paid (Other State):</label>
                <input type="text" id="calTotalTaxPaidOtherStateRP" class="form-control" readonly />

                <label>Total Leftover (Titling State):</label>
                <input type="text" id="calTotalLeftOverTitlingStateRP" class="form-control" readonly />
            </div>
        </div>
    </div>
