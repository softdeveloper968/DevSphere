@using MyDMVpro.Models.VendorViewModels
@{
    const string PageName = VendorPageNames.RequestLookup;
    ViewData["Title"] = "Request Lookup";
    UserInfo ui = UserInfo.GetCurrentUser(User, false);
    string GetUrl(string name)
    {
        return MyDMVpro.Controllers.RequestStatusController.GetEndpointUrl(this.Context, name);
    }
}

<script src="~/js/vendor.js" asp-append-version="true"></script>
<script src="~/js/requestcodes.js" asp-append-version="true"></script>
<script src="~/js/taxcalculator.js" asp-append-version="true"></script>
<link rel="stylesheet" href="~/css/vendor.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/requesttags.css" asp-append-version="true" />

<div class="row gap_15">
    <div class="col-sm-12 col-md-12 col-lg-12">
        <div id="detailSummaryPanel" class="detailSummaryPanel" tabindex="-1" style="display:none;">
            <div class="container vertical-alignment-helper">
                <div class="col-sm-4">R#: <span id="request_reqno"></span></div>
                <div class="col-sm-4">Status: <span id="request_status"></span></div>
                <div class="col-sm-4">Process: <span id="request_process"></span></div>
            </div>
        </div>
        <div class="form-horizontal">
            <div class="container vertical-alignment-helper" style="display:none;">
                <div class="form-group">
                    <p class="form-control-static" id="summary-Status">ACTIVE</p>
                </div>
                <div class="form-group">
                    <label for="summary-VIN" style="float:left" class="control-label">VIN</label>
                    <p class="form-control-static" id="summary-VIN">VIN GOES HERE</p>
                </div>
                <div class="form-group col-sm-12 col-md-2 col-lg-1">
                    <label for="summary-RequestNo" style="float:left" class="control-label">R#</label>
                    <p class="form-control-static" id="summary-RequestNo">00000</p>
                </div>
                <div class="form-group col-sm-12 col-md-2 col-lg-1">
                    <label for="summary-State" style="float:left" class="control-label">State</label>
                    <p class="form-control-static" id="summary-State">XX</p>
                </div>
                <div class="form-group col-sm-12 col-md-4 col-lg-2">
                    <label for="summary-GroupName" style="float:left" class="control-label">Group</label>
                    <p class="form-control-static" id="summary-GroupName">BANK OF USA</p>
                </div>
                <div class="form-group col-sm-12 col-md-2 col-lg-1">
                    <label for="summary-SubmittedBy" style="float:left" class="control-label">Submitted By</label>
                    <p class="form-control-static" id="summary-SubmittedBy">JOHN Q. PUBLIC</p>
                </div>
                <div class="form-group col-sm-12 col-md-4 col-lg-2">
                    <label for="summary-ModifiedBy" style="float:left" class="control-label">Modified By</label>
                    <p class="form-control-static" id="summary-ModifiedBy">Jane Doe</p>
                    <p class="form-control-static" id="summary-Modified">Dec. 31, 2019 10am</p>
                </div>
                @*                    <div class="form-group">
                <label for="summary-Stage" style="float:left" class="control-label">Stage</label>
                <input type="text" class="form-control" name="summary-Stage" id="summary-Stage" readonly />
                </div>*@
                <div class="form-group">
                    <div class="">
                        <img href="/images/" /> @*auto ims*@
                        <img href="/images/" /> @*duplicates*@
                    </div>
                </div>
            </div>

            @*[RequestNo]
            ,[Vin]
            ,[AppType]
            ,[State]
            ,[GroupName]
            ,[SubmittedBy]
            ,[LastModified]
            ,[LastModifiedBy]
            ,[StatusID]
            ,[ProcessStageID]
            ,[HasNewChat]
            ,[HasActiveChat]
            ,[WaitingForVendorReply]
            ,[WaitingForUserReply]

            ,[AutoImsStatus]
            ,[AutoImsError]
            ,[DupeAppTypeForVin]
            ,[ActiveCountForVin]

            -- LH only
            ,[VendorCode]*@
        </div>
    </div>
    <div class="col-sm-6 col-md-6 col-lg-4">
        <div id="detailsEditPanel" class="detailsEditPanel" tabindex="-1" style="display:none;">
            <div class="white_box">
                <div class="panel-body">
                </div>
                <div class="panel-footer" style="background-color:inherit;">
                    <button type="button" class="btn btn-success custom_btn" id="detailsEditPanel_saveButton">Save Form</button>
                    <button type="button" class="btn btn-default custom_btn pull-right" id="detailsEditPanel_changeAppTypeButton">Change App Type&nbsp;<span style="font-family:FontAwesome;">&#x0F078;</span></button>
                </div>
                <div class="panel-footer">
                    @{
                        await Html.RenderPartialAsync("_changeAppType");
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-6 col-lg-4">
        <div id="requestCodesPanel" class="requestCodesPanel" tabindex="-1" style="display:none;">
            <div class="white_box p_15">
                <h2>Codes</h2>
                <div class="panel-body p-0">
                    @{
                        {
                            VendorRequestCodesViewModel list = new VendorRequestCodesViewModel(VendorViewType.RequestCodes)
                {
                    //ControllerName = "Requests",
                    DataUrl = $"/Requests/RequestCodes/{Guid.Empty}",
                    ListId = "DT_RequestCodes",
                    AllowDelete = false,
                    TableVarName = "vendorRequestCodes",
                    EnableFilter = false,
                    EnableAdvancedSearch = false,
                    EnablePresets = false,
                    EnableReportBuilder = false,
                    AllowSort = false,
                    AddLastModified = false,
                    AddLastModifiedBy = false,
                    EnableExport = false,
                    DisplayFullNotesAsChildRow = false,
                    PageLength = 50
                };

                            if (!DataHelpers.UpdateViewColumns("Vendor_RequestCodes", list))
                            {
                                list.Columns.Add_Select();
                                list.Columns.Add("Code", "reqCode");
                                list.Columns.Add("Fields", "reqFields");
                                list.Columns.Add("Notes", "reqNote");
                                list.Columns.Add("Suggested Resolution", "reqResolution");

                                //list.SortColumns.Add("");
                            }
                            list.RequestId = new Guid();
                            await Html.RenderPartialAsync("~/Views/Shared/_requestcodesupport.cshtml");
                            await Html.RenderPartialAsync("_vendorRequestCodesList", list);
                        }
                    }
                </div>
            </div>
        </div>
        <div id="notesEditPanel" class="notesEditPanel" tabindex="-1" style="display:none;">
            @if (ViewBag.HelpLink != null)
            {
                <div style="position:absolute;top:0;right:0;"><a href="@ViewBag.HelpLink" target="_blank"><span style="font-family:FontAwesome;font-size:x-large">&#x0f05a;</span></a></div>
            }
            <div class="white_box">
                <div class="p_15">
                    <h2>Notes/Remarks</h2>
                    <div class="panel-body p-0">
                    </div>
                </div>
            </div>
        </div>
        <div id="chatsEditPanel" class="chatsEditPanel" tabindex="-1" style="display:none;">
            <div class="white_box">
                <div class="p_15">
                    <h2>Chat</h2>
                    <div class="panel-body chat-body" style="display:none; max-height: 300px;"></div>
                    <div class="panel-footer chat_footer" style="display:none;">
                        <form asp-controller="Chats" asp-action="Create" method="post" id="chat-SendMessageForm" class="w-100">
                            <input type="hidden" name="RequestId" id="chat-RequestId" />
                            <textarea class="form-control" name="Message" id="chat-newMsg" rows="4" width="100%" placeholder="Type message" style="resize:none;"></textarea>
                            <div class="mt_10">
                                <input type="submit" value="Send" class="btn btn-primary custom_btn" />
                                <button type="button" id="chatMarkAsRead" class="btn btn-default custom_btn">Mark As Read</button>
                                <button type="button" id="chatRefreshBtn" class="btn custom_btn">Refresh</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div id="modal-miscAttachment" class="modal fade hidden-print" tabindex="-1" role="dialog">
            <div class="container vertical-alignment-helper">
                <div class="row vertical-align-center">
                    <div class="col-sm-4"></div>
                    <div class="modal-dialog">
                        <div class="modal-content">
                            <div class="modal-header">
                                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                                <div class="modal-title h4" style="margin-right:20px" id="REQ_VIN_RNO_HEADER">Special Requirement</div>
                            </div>
                            <div class="modal-body">
                                <input type="hidden" id="miscAttachment_requestId" />
                                <div class="form-group">
                                    <label for="miscAttachment_attachmentTypeId">Type:</label>
                                    <select name="miscAttachment_attachmentTypeId" id="miscAttachment_attachmentTypeId" class="form-control" required>
                                    </select>
                                </div>
                                <div class="form-group">
                                    <label for="miscAttachment_comment">Comment</label>
                                    <textarea name="miscAttachment_comment" id="miscAttachment_comment" class="form-control vresize" required></textarea>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-success custom_btn" id="okButton">Save</button>
                                <button type="button" class="btn btn-default custom_btn" data-dismiss="modal">Cancel</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="attachmentsEditPanel" class="attachmentsEditPanel" tabindex="-1" style="display:none;">
            <div class="white_box">
                <div class="p_15">
                    <h2>Attachments</h2>
                    <div class="panel-body p-0" style="display:none;">
                    </div>
                    <div class="panel-footer attachment_footer mt_10" style="display:none;">
                        <form id="att-addAttachment" asp-controller="Requests" asp-action="UploadAttachment" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="id" id="att-RequestId" />
                            <div id="attUploadPanel" style="display:none;">
                                <h4 class="hrheader">Upload Attachments</h4>
                                <div class="form-group">
                                    <input type="file" name="file" class="form-control" required />
                                </div>
                                <div class="form-group" id="attachmentTypePanel">
                                    <label for="attachmentTypeId">Type:</label>
                                    <select name="attachmentTypeId" id="attachmentTypeId" class="form-control" required>
                                    </select>
                                    <span style="font-size:small">Please confirm the type of document you are attaching. If you do not see an option that describes your document, choose the “extra” type</span>
                                </div>
                                <div class="form-group">
                                    <label for="att-FileDesc" class="control-label">Description (optional): </label>
                                    <input type="text" class="form-control" name="filedesc" id="att-FileDesc" />
                                </div>
                                <div class="form-group mb-0">
                                    <button type="submit" class="btn btn-success custom_btn">Upload File</button>
                                </div>
                            </div>
                        </form>
                        <div class="text-right">
                            <button type="button" style="float: left" class="btn btn-default custom_btn" id="btnAttMisc">Miscellaneous</button>
                            <button type="button" class="btn btn-default custom_btn" id="btnAttUpload">Upload Attachment&nbsp;<span style="font-family:FontAwesome;">&#x0F078;</span></button>
                            <button type="button" style="display:none;" class="btn btn-default custom_btn" id="btnAttUploadClose"><span style="font-family:FontAwesome;">&#x0F077;</span></button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div id="followUpsPanel" class="followUpsPanel" tabindex="-1" style="display:none;">
            <div class="white_box">
                <div class="p_15">
                    <h2>Follow-Ups</h2>
                    <div class="panel-body p-0">
                        @{
                            {
                                VendorFollowUpViewModel list = new VendorFollowUpViewModel(VendorViewType.RequestFollowUps, PageName)
                {
                    QueueName = "FollowUps",
                    DataUrl = $"/FollowUp/VendorFollowUps/{Guid.Empty}", /* Changed by javascript actions */
                    ListId = "DT_FollowUps",
                    AllowMove = false,
                    TableVarName = "vendorFollowUp",
                    EnableFilter = false,
                    EnableAdvancedSearch = false,
                    EnablePresets = false,
                    EnableReportBuilder = false,
                    AllowSort = false,
                    AddLastModified = false,
                    AddLastModifiedBy = false,
                    EnableExport = false,
                    DisplayFullNotesAsChildRow = false
                };

                                if (!DataHelpers.UpdateViewColumns("Vendor_RequestFollowUps", list))
                                {
                                    list.Columns.Add_Select();
                                    list.Columns.Add("Title", "reqTitle");
                                    list.Columns.Add("Due Date", "reqDueDate");
                                    list.Columns.Add("Codes", "reqTags");
                                    list.Columns.Add("Completed Date", "reqCompletedDate");
                                    list.Columns.Add("Notes", "reqFUPNotes");

                                    list.SortColumns.Add("reqDueDate");
                                }
                                list.RequestId = new Guid();
                                await Html.RenderPartialAsync("~/Views/Shared/_followupsupport.cshtml");
                                await Html.RenderPartialAsync("_vendorFollowUpsList", list);
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        <div id="linkedRequestsPanel" class="linkedRequestsPanel" tabindex="-1" style="display:none;">
            <div class="white_box">
                <div class="p_15">
                    <h2>Linked Records</h2>
                    <div class="panel-body p-0" style="max-width:600px">
                        @{
                            {
                                VendorRequestViewModel list = new VendorRequestViewModel(VendorViewType.LinkedRequests, PageName)
                {
                    QueueTitle = "Linked Requests",
                    QueueName = "LinkedRequests",
                    Prefix = "", /* both LH and Vendor */
                    PageName = "", /* multiple pages */
                    //DataUrl = GetUrl("LinkedRequests"), @* This url always returns 0 results - the url is updated in code later *@
                    //ListId = "DT_LinkedRequests",
                    AllowMove = false,
                    //TableVarName = "vendorLinkedTable",
                    IsLinkedRequestView = true,
                    EnableFilter = false,
                    EnableAdvancedSearch = false,
                    EnablePresets = false,
                    EnableReportBuilder = false,
                    AllowSort = false,
                    AddLastModified = false,
                    AddLastModifiedBy = false,
                    AddExpandNotesOption = false,
                    AddIncludeArchivedOption = false,
                    AddSelectDeselectButtons = true,
                    AllowMultiSelect = false
                };
                                list.Columns.Add_Select();
                                //list.Columns.Add_Chat();
                                //list.Columns.Add_Attachments();
                                list.Columns.Add_Links();
                                list.Columns.Add_RNo();
                                list.Columns.Add_VIN();
                                list.Columns.Add_AppType(true);
                                list.Columns.Add_AppState();

                                list.SortColumns.Add("reqNo");
                                list.SortColumns.Add("reqType");
                                list.SortColumns.Add("reqState");

                                await Html.RenderPartialAsync("_VendorRequestList", list);
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        @{
            await Html.RenderPartialAsync("~/Views/Shared/_vendorLinkedRequestsSupport.cshtml");
        }
        <div id="requestHistoryPanel" class="requestHistoryPanel" tabindex="-1" style="display:none;">
            <div class="text-right">
                <button type="button" class="btn btn-success custom_btn" id="okButton">View History</button>
            </div>
            <div class="panel-body">
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-6 col-lg-4">
        <div id="statusEditPanel" class="statusEditPanel" tabindex="-1" style="display:none;">
            <div class="white_box">
                <div class="p_15">
                    <h2>Status</h2>
                    <div class="panel-body p-0">
                    </div>
                    @* <button type="button" class="btn btn-success custom_btn" id="okButton">Update Status</button> *@
            </div>
            </div>
        </div>
