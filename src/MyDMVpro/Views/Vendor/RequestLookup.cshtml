                    $feeGrid.append(gridRow);
                });
            } else {
                console.error("Invalid CalculatedRegResult format", calculatedRegResult);
            }
        }

        function calculateRegFee() {
            var regItems = {};
            $("#regItemGrid tr").each(function() {
                var key = $(this).find("td:first").text().trim();
                var value = $(this).find("input").val().trim();
                if (!["unladenweight", "mgw", "mpg"].includes(key.toLowerCase() )) {
                    value = value.toLowerCase();
                }
                regItems[key] = value;
            });
            // Assign StateCode from stateId
            regItems["STATECODE"] = stateId;
            $.ajax({
                url: '/RegistrationCalculator/CalculateRegistrationFee',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(regItems),
                headers: {
                    'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    if (response.success) {
                        const formattedData = response.data.map(item => ({
                            tableName: item.tableName,
                            shippingCost: item.shippingCost
                        }));
                        const totalShippingCost = formattedData.reduce((sum, item) =>
                            sum + (isNaN(parseFloat(item.shippingCost)) ? 0 : parseFloat(item.shippingCost)), 0
                        );
                        formattedData.push({
                            tableName: "Total",
                            ShippingCost: totalShippingCost
                        });
                        displayRegistration(regItems, formattedData);
                        jqToast.success({
                            text: "Registration fee calculated successfully."
                        })
                    } else {
                        console.error("Error in API response", response.message);
                        jqToast.error({
                            text: response.message
                        })
                    }
                },
                error: function(xhr, status, error) {
                    jqToast.error({
                        text: error.message
                    });
                }
            });
        }

        function parseCurrency(value) {
            return value.replace(/[^0-9.-]+/g, ""); // Removes "$" and parses float
        }

        function saveTaxData(reqid) {
            const calculatedTaxItems = [];
            // Loop through rows in #itemGridRP to collect data
            $("#itemGridRP tr").each(function() {
                const $row = $(this);
                const itemId = $row.find("input[name^='itemValueRP_']").attr("name")?.split("_")[1] || "";
                const itemName = $row.find("input[name^='itemValueRP_']").data("item-name") || "";
                const value = parseFloat($row.find("input[name^='itemValueRP_']").val()) || 0;
                const taxableAmount = parseFloat($row.find("input[name^='taxableAmountRP_']").val()) || 0;
                const taxDue = parseFloat($row.find("input[name^='taxDueRP_']").val()) || 0;
                if (itemId) {
                    calculatedTaxItems.push({
                        ItemId: parseInt(itemId),
                        ItemName: itemName,
                        Value: value,
                        TaxDue: taxDue,
                        TaxableAmount: taxableAmount
                    });
                }
            });
            // Collect total amounts from summary fields
            const calculatedTaxResult = {
                TotalTaxableAmount: parseCurrency($("#calTotalTaxableAmountRP").val()),
                TotalTaxDue: parseCurrency($("#calTotalTaxDueRP").val()),
                TotalTaxPaidOtherState: parseCurrency($("#calTotalTaxPaidOtherStateRP").val()),
                TotalLeftOverTitlingState: parseCurrency($("#calTotalLeftOverTitlingStateRP").val()),
                CalculatedTaxItems: calculatedTaxItems,
                        TotalCollectionTaxDetails:totalTaxDetails
            };
            // Prepare data to send
            const requestData = {
                RequestId: reqid,
                CalculatedTaxResult: calculatedTaxResult
            };
            // Send data via AJAX
            $.ajax({
                url: '/Tax/SaveTax',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(requestData),
                headers: {
                    'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    jqToast.success({
                        text: "Tax details saved successfully!"
                    });
                },
                error: function(xhr) {
                    jqToast.error({
                        text: "Failed to save tax details. Please try again."
                    });
                }
            });
        }

        function saveRegistrationData(reqid) {
            var regItems = {};
            $("#regItemGrid tr").each(function() {
                var key = $(this).find("td:first").text().trim();
                var value = $(this).find("input").val().trim();
                if (key) {
                    if (["unladenweight", "mgw", "mpg"].includes(key.toLowerCase() )) {
                        regItems[key] = parseInt(value) || 0;
                    } else {
                        regItems[key] = value;
                    }
                }
            });
            var calculatedFeeResult = [];
            $("#calculatedFeeGrid input").each(function() {
                var tableName = $(this).attr("name").replace("feeValue_", "");
                var value = $(this).val().replace("$", "").trim();
                calculatedFeeResult.push({
                    TableName: tableName,
                    ShippingCost: parseFloat(value) || 0
                });
            });
            var saveData = {
                RequestId: reqid,
                RegItems: regItems,
                CalculatedFeeResult: calculatedFeeResult
            };
            $.ajax({
                url: "/RegistrationCalculator/SaveRegistration",
                type: "POST",
                contentType: "application/json",
                data: JSON.stringify(saveData),
                headers: {
                    'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val()
                },
                success: function(response) {
                    jqToast.success({
                        text: "Registration fee details saved successfully!"
                    });
                },
                error: function(xhr) {
                    jqToast.error({
                        text: "Failed to save registration fee details. Please try again."
                    });
                }
            });
        }

        function getPaymentLinks(requestId) {
            var $panel = $("#paymentLinksList");
            var $container = $("#paymentLinksContainer");

            $panel.addClass("d-none"); // Hide panel initially
            $container.empty(); // Clear previous data

            $.ajax({
                url: '/Stripe/GetPaymentLink/' + requestId,
                type: 'GET',
                dataType: 'json',
                cache: false,
                async: true,
            }).done(function (res) {
                if (res.data && res.data.length > 0) {
                    $.each(res.data, function (index, item) {
                        var paymentHtml = `
                                    <div class="payment-item mb_10">
                                        <p class="mb_5">
                                            <strong>Payment Method:</strong> ${item.paymentMethod !== 'card' ? 'ACH' : item.paymentMethod}<br>
                                            <strong>Amount:</strong> ${item.amount} ${item.currency} + ${item.serviceCharge} Service Fee
                                        </p>
                                        <p class="mb_5">${item.paymentLinkUrl}</p>
                                        <div class="d-flex items-center gap-2">
                                                <button class="btn btn-primary btn-sm" onclick="copyPaymentLink('${item.paymentLinkUrl}', this)">Copy</button>
                                            <button class="btn btn-danger btn-sm" onclick="deletePaymentLink('${item.id}', this)">Remove</button>
                                        </div>
                                    </div>
                            `;
                        $container.append(paymentHtml);
                    });

                    $panel.removeClass("d-none"); // Show panel after data is loaded
                } else {
                    $container.html('<p class="text-muted text-center">No payment links available.</p>');
                    $panel.removeClass("d-none");
                }
            }).fail(function (xhr) {
                console.error("Error fetching payment links", xhr);
            });
        }

        function deletePaymentLink(id, element) {

            const formData = new FormData();
            formData.append('id', id);

            $('#confirmDeletePaymentLinkModal').modal('show');

            $('#confirmDeletePaymentLinkButton').off('click').on('click', function () {

                $.ajax({
                    url: '/Stripe/DeleteLink',
                    type: 'POST',
                    data: formData,
                    processData: false,
                    contentType: false,
                    headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                    cache: false,
                    success: function (response) {
                        if (response.success) {
                            jqToast.success({ text: response.message });
                            $(element).closest('.payment-item').fadeOut(300, function () {
                                $(this).remove();
                            });
                        } else {
                            jqToast.error({ text: 'Error occured while deleting the link.' });
                        }
                    },
                    error: function (xhr, status, error) {
                        jqToast.error({ text: 'An error occurred while clearing the data.' });
                    }
                });

                $('#confirmDeletePaymentLinkModal').modal('hide');
            });
        }

        function copyPaymentLink(url, element) {
            const tempInput = document.createElement('input');
            tempInput.value = url;
            document.body.appendChild(tempInput);
            tempInput.select();
            try {
                document.execCommand('copy');
                jqToast.success({
                    text: 'Link copied to clipboard!'
                });
            } catch (err) {
                console.error("Fallback: Failed to copy text: ", err);
                jqToast.error({
                    text: 'Failed to copy the link. Please try again.'
                });
            }
            document.body.removeChild(tempInput);
        }

</script>
