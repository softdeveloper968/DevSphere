                        data: form.serialize(),
                        headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                        success: function (data) {
                            if (data.status == 'error') {
                                alert(data.message);
                            }
                            else {
                                requestLookup_vendorShowNotes(requestId);
                            }
                            jqToast.success({ text: 'Notes updated successfully' });
                            enableFormSubmit(form);
                        },
                        error: function (xhr) {
                            jqToast.error({
                                text: `Some error occurred, Please try again.`
                            });
                            enableFormSubmit(form);
                        }
                    });
                }));
            });
        }
        function requestLookup_showChat(requestId) {
            var $panel = $("#chatsEditPanel");
            $panel.find(".panel-body").hide();
            $panel.find(".panel-footer").hide();
            $panel.data("reqid", requestId);
            $panel.find(".panel-body").empty().html('');

            var succeeded = false;
            $.ajax({
                url: '/Chats/View/' + requestId,
                type: 'GET',
                async: true,
                dataType: 'text',
                cache: false,
                contentType: false,
                processData: false,
            }).done(function (data) {
                $panel.find("#chat-RequestId").val(requestId);
                var $body = $panel.find(".panel-body");
                $body.html(data);
                $body.show();
                $body.animate({ scrollTop: $body.prop("scrollHeight") }, 1000);
                //$body.scrollTop = $body.scrollHeight;
                $panel.find(".panel-footer").show();
