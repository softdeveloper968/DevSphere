            $panel.data("reqid", reqid);
            $panel.find(".panel-body").empty().html('');
            $panel.hide();

            var succeeded = false;
            $.ajax({
                url: '/AppForm/VendorOpen/' + reqid,
                type: 'GET',
                async: true,
                dataType: 'text',
                cache: false,
                contentType: false,
                processData: false,
            }).done(function (res) {
                if ($panel.data("reqid") == reqid) {
                    $panel.find(".panel-body").html(res);

                    $panel = $("#detailsEditPanel"); //refresh after reload
                    var $saveBtn = $panel.find('#detailsEditPanel_saveButton');
                    var $changeAppTypeBtn = $panel.find('#detailsEditPanel_changeAppTypeButton');

                    $changeAppTypeBtn.off('click').on('click', function () {
                        requestLookup_initChangeAppType(reqid);
                    });

                    var $form = $panel.find('.panel-body').find('form');
                    resetFormValidator("#dynamicAppForm");

                    $form.off('submit').on('submit', function (e) {
                        e.preventDefault();
                        var $thisForm = $(this);
                        $saveBtn.attr('disabled', true);
                        $.ajax({
                            url: $thisForm.attr('action'),
                            type: 'POST',
                            headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                            data: $thisForm.serialize()
                        }).done(function (data) {
                            try {
                                formAnalyzer_update_request(uploadId, reqid, null);
                            } catch (e) { };
                           
                            jqToast.success({ text: 'Data updated successfully!' });
                            $saveBtn.attr('disabled', false);
                            $thisForm.find('input, select, textarea').removeClass('highlighted');
                            $thisForm.find('.sectionBox').removeClass('highlighted-section');

                            var reqid = '@ViewData["RequestId"]';
                            var reqno = '@ViewData["RequestNo"]';
                            var vin = '@ViewData["VIN"]';

                            requestLookup_fill_form(reqid, reqno, vin);

                        }).fail(function () {
                            $saveBtn.attr('disabled', false);
                            jqToast.error({
                                text: `Some error occurred, Please try again.`
                            });
                        });
                        return false;
                    });
                   
                    var $footer = $panel.find(".panel-footer");
                    $saveBtn.prop('disabled', false);
                    $saveBtn.off('click').on('click', function (e) {
                        e.preventDefault();
                        $form.trigger("submit");
                    });
                    $panel.find(".panel-body").show();
                    $panel.show();

                    requestcodes_updateFormTags();
                }
            });
            return false;
    }

        function requestLookup_vendorShowNotes(requestId) {
            var $panel = $("#notesEditPanel");
