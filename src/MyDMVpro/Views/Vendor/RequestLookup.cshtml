    <div id="dataTagsPanel" class="dataTagsPanel" tabindex="-1" style="display:none;">
        <div class="white_box">
            <div class="p_15">
                <h2>Data Tags</h2>
                <div class="panel-body p-0"></div>
            </div>
        </div>
