            requestLookup_showFollowUps(requestId, reqno, vin);
            requestLookup_showRequestCodes(requestId, reqno, vin);
            requestLookup_vendorViewRequestHistory(requestId);
            requestLookup_getPaymentTypes(requestId, reqno, vin);
            requestLookup_dataTags(requestId);
            requestLookup_TaxAndRegFee(requestId);
            getCalculatedFields(requestId);
            loadPaymentAndDisbursement(true, requestId);
            $("#stripePaymentPanel").show();
            $("#feePanel").show();
            getPaymentLinks(requestId)
        }
        else {
            requestLookup_clearEditForm();
        }
    }

