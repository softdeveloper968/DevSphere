</div>

<div id="paymentAndDisbursementPanel" class="paymentAndDisbursementPanel" tabindex="-1" style="display: none">
    <div class="white_box p_15 mt_15">
        <h2>Payment And Disbursement </h2>
        <div class="row">
            <div class="form-group col-md-4">
                <label for="paymentTypeSelect">Select Payment Type</label>
                <select id="paymentTypeSelect" class="form-control">
                    <option value="credit">Credit</option>
                    <option value="debit">Debit</option>
                </select>
            </div>
        </div>
        <table id="paymentAndDisbursementPanelDataTable" class="table table-striped" style="width:100%"></table>
        <div id="export-button-paymentAndDisbursement"></div>
    </div>
</div>

<div class="modal fade" id="editPaymentModal" tabindex="-1" aria-labelledby="editPaymentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editPaymentModalLabel">Edit Payment</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form id="editPaymentForm">
                    <input type="hidden" name="id" id="modalPay-Id" />
                    <input type="hidden" name="requestId" id="modalPay-RequestId" />
                    <input type="hidden" name="vin" id="modalPay-vin" />
                    <input type="hidden" name="isCredit" id="modalPay-isCredit" />

                    <div class="form-group">
                        <label for="PaymentTypeIDForModal">Transaction Type</label>
                        <select class="form-control" name="PaymentTypeIDForModal" id="PaymentTypeIDForModal" disabled>
                            <option value="">Select Type</option>
                            <option value="1">Check</option>
                            <option value="2">Credit Card</option>
                            <option value="3">ACH</option>
                            <option value="4">Disbursement Check</option>
                            <option value="5">Electronic Disbursement</option>
                            <option value="6">Maggard Service Fee</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="AmountForModal">Amount ($)</label>
                        <input type="number" class="form-control" name="AmountForModal" id="AmountForModal" />
                    </div>

                    <div class="form-group">
                        <label for="ReferenceNumberForModal">Reference Number (#)</label>
                        <input type="text" class="form-control" name="ReferenceNumberForModal" id="ReferenceNumberForModal" />
                    </div>

                    <div class="form-group">
                        <label for="paymentDateForModal">Payment Date</label>
                        <input type="date" class="form-control" name="paymentDateForModal" id="paymentDateForModal" />
                    </div>

                    <div class="form-group">
                        <label for="ProcessingFeeForModal">Processing Fee</label>
                        <input type="number" class="form-control" name="ProcessingFeeForModal" id="ProcessingFeeForModal" />
                    </div>

                    <div class="form-group">
                        <label for="TotalChargeForModal">Total Charge</label>
                        <input type="number" readonly class="form-control" name="TotalChargeForModal" id="TotalChargeForModal" />
                    </div>

                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="confirmDeletePayDisbursementModal" tabindex="-1" role="dialog" aria-labelledby="confirmDeletePayDisbursementModalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
