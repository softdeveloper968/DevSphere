            formData.append('id', requestId);
            formData.append('standaloneForm', 'true');
            $.ajax({
                url: '/Requests/EditNotes',
                type: 'POST',
                async: true,
                data: formData,
                dataType: 'text',
                cache: false,
                contentType: false,
                processData: false,
                headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
            }).done(function (data) {
                $panel.find('.panel-body').html(data);
                var form = $panel.find('form').first();
                form.find('.btn-close').hide();
                $panel.show();

                $(form).off('submit').on('submit', (function (e) {
                    e.preventDefault();
