        function displayDataTags(dataTags) {
            var $panelBody = $("#dataTagsPanel .panel-body");
            for (var docName in dataTags) {
                if (dataTags.hasOwnProperty(docName)) {
                    var dataTag = dataTags[docName];
                    var docHeader = $('<h5>')
                        .text(docName)
                        .addClass('box-header')
                        .css({
                            'background-color': '#d2d2d2',
                            'padding': '10px',
                            'cursor': 'pointer',
                            'position': 'relative',
                            'margin-bottom': '0px'
                        });
                    var collapseIcon = $('<i>')
                        .addClass('fa fa-chevron-down')
                        .css({
                            'font-size': '12px',
                            'position': 'absolute',
                            'right': '10px',
                            'top': '50%',
                            'transform': 'translateY(-50%)'
                        });
                    var docContent = $('<div>')
                        .addClass('doc-content')
                        .css({
                            'background-color': '#f0f0f0',
                            'padding': '10px',
                            'display': 'none'
                        });
                    docHeader.on('click', function() {
                        var $content = $(this).next('.doc-content');
                        var $icon = $(this).find('i');
                        var isVisible = $content.is(':visible');
                        if (isVisible) {
                            $content.slideUp();
                            $icon.removeClass('fa-chevron-up').addClass('fa-chevron-down');
                        } else {
                            $content.slideDown();
                            $icon.removeClass('fa-chevron-down').addClass('fa-chevron-up');
                        }
                    });
                    docHeader.append(collapseIcon);
                    $panelBody.append(docHeader);
                    $panelBody.append(docContent);
                    appendTags(docContent, 'C1', dataTag.C1);
                    appendTags(docContent, 'C2', dataTag.C2);
                }
            }
        }
        // Helper function to append tags
        function appendTags($panelBody, column, tags) {
            if (tags && tags.length > 0) {
                var colHeader = $('<h5>').text('\u07E6 ' + column + ' Tags');
                $panelBody.append(colHeader);
                    var table = $('<table>').addClass('table table-responsive');
                var headerRow = $('<tr>').append(
                    $('<th>').text('Field Name'),
                    $('<th>').text('Discrepancy'),
                    $('<th>').text('Correct Value')
                );
                table.append(headerRow);
                tags.forEach(function(tag) {
                    var fieldNameCell = $('<td>').text(tag.fieldName);
                    // Apply color based on column type
                    if (column === 'C1') {
                        fieldNameCell.css('color', 'red');
                    } else if (column === 'C2') {
                        fieldNameCell.css('color', 'orange');
                    }
                    var row = $('<tr>').append(
                        fieldNameCell,
                        $('<td>').text(tag.discrepancy),
                        $('<td>').text(tag.correctValue || '')
                    );
                    table.append(row);
                });
                $panelBody.append(table);
            }
        }

