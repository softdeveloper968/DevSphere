@model SignRequestViewModel

<form asp-controller="Forms" asp-action="SignSingle" method="post">
    <input asp-for="RequestId" type="hidden" value="@Model.RequestId" />
    <div class="form-group">
        <label asp-for="Signature" class="col-md-2 control-label"></label>
        <div class="col-md-10">
            <input asp-for="Signature" class="form-control" />
            <span asp-validation-for="Signature" class="text-danger"></span>
        </div>
    </div>
    <button type="submit">Sign</button>
</form>
<object data="/Forms/ViewBatch/@Model.RequestId" type="application/pdf" style="width: 100%; height:1000px;">
    <p>
        <b>Error</b>:
        This browser does not support PDFs. Please download the PDF to view it: <a href="/Forms/ViewBatch/@Model.RequestId">Download PDF</a>.
    </p>
</object>

