@model ViewSignedRequestViewModel
<div>
    <div>Signed By: @Model.Signature &nbsp;&nbsp;  @Model.DateSigned.ToShortDateString()</div>
</div>

<object data="/Forms/ViewForm/@Model.RequestId" type="application/pdf" style="width: 100%; height:1000px;">
    <p>
        <b>Error</b>:
        This browser does not support PDFs. Please download the PDF to view it: <a href="/Forms/ViewForm/@Model.RequestId" target="_blank">Download PDF</a>.
    </p>
</object>

