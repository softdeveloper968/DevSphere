                        "data": "tagName",
                    },
                     {
                        "targets": "reqRequestNumber",
                        "data": "requestNumber",
                    },
                    ],
                    "processing": true,
                    "serverSide": true,
                    //"filter": true,
                    "ajax":
                    {
                        "url": "@Model.DataUrl",
                        "type": "POST",
                        "dataType": "JSON",
                        "data": function (data) {
                            var all = GetDtSetting("@Model.ListId","includeArchived");
                            if (all == "true") data.includeArchived = "true";

                            var expandNotes = GetDtSetting("@Model.ListId", "expandNotes");
                            if (expandNotes == 'true') {
                                var expandedNotesLength = GetGlobalSetting("ExpandNotesLength","500");
                                data.notesLength = `${expandedNotesLength}`;
                            }

                            if(isFilterEnabled){
                                data.allGroupChats = true
                            }
                            else{
                               data.allGroupChats = false
                            }

                        },
                        headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                         "dataSrc": function (json) {
                             @if(Model.ViewType == MyServicesViewType.Communication_Chat){
                              <text>
                              messageParts.chats = (json.recordsTotal && json.recordsTotal > 0) ? `${json.recordsTotal} chat requests` : "";
                              updateMessageContainer();
                              </text>
                             }
                             return json.data; 
                         },
                    },
                    "buttons": [
                        {
                            extend: 'selectAll',
                            className: 'selectall',
                            action: function (e) {
                                e.preventDefault();
                                table.rows({ search: 'applied' }).deselect();
                                table.rows({ search: 'applied' }).select();
                            }
                        },
                        'selectNone',
                    @if (Model.ViewType == MyServicesViewType.Pending && Model.EnablePDF)
                    {
<text>
                        {
                            "text": 'Review', "action": datatbl
                        },
</text>
                    }
                    @if (Model.ViewType == MyServicesViewType.Master)
                    {
<text>
                        { text: "Reassign", className: "btnReassignUser", action: function (e) { e.preventDefault(); AssignToUser(table, ''); } },
</text>
                    }
                    @if (Model.ViewType == MyServicesViewType.Pending)
                    {
                        <text>
                           
                            { text: "Ship to Vendor", className: "btnShipToVendor", action: function (e) { e.preventDefault(); ShowShipToVendor(table); } },
                            { text: "Direct to Vendor", action: function (e) { e.preventDefault(); ShowDirectToVendor(table); } },
                            { text: "Remove", action: function (e) { e.preventDefault(); ShowRemovePending(table); } },
                      
                        </text>
                    }
                    {
                        extend: 'collection',
                        text: 'Export',
                        dropup: true,
                        background: false,
                        buttons: [
                            {
                                extend: 'copy',
                                exportOptions: {
                                    columns: '@Model.CopyExportSelector'
                                }
                            },
                            {
                                extend: "csvHtml5",
                                exportOptions: {
                                    columns: '@Model.CsvExportSelector'
                                }
                            },
                            {
                                extend: "excelHtml5",
                                exportOptions: {
                                    columns: '@Model.ExcelExportSelector'
                                }
                            },
                            {
                                extend: "pdfHtml5",
                                orientation: 'landscape',
                                pageSize: 'LEGAL',
                                exportOptions: {
                                    columns: '@Model.PdfExportSelector'
                                }
                            },
                            {
                                extend: "print",
                                exportOptions: {
                                    columns: '@Model.PrintExportSelector'
                                }
                            },
                        ]
                    },
    @if (Model.EnablePrintInstructionPacket)
    {
        @: { text: "Print Instruction packet", className: "selectOnOff", action: function (e) { e.preventDefault(); vendor_PrintInstructionPackets(table); } },
    }
                    { text: "", titleAttr: "Refresh", className: "listRefresh", action: function (e) { e.preventDefault(); table.ajax.reload(); } },
                    @if(Model.ViewType != MyServicesViewType.DocumentReceived_NoRequest && Model.ViewType != MyServicesViewType.DocumentShipped_NoRequest )
                    { <text>
                       {
                        extend: 'collection',
                        text: 'Options',
                        "dropup": true,
                        autoClose: true,
                        background: false,
                        buttons: [
                            {
                                text: function (dt,button,config) { return GetExpandNotesButtonText("@Model.ListId"); },
                                className: "btnExpandNotes",
                                action: function (e,dt,button,config) {
                                    e.preventDefault();
                                    var btnText = "Expand Notes";
                                    if (ToggleExpandNotes(table, "@Model.ListId") == "true") {
                                        btnText = "Collapse Notes";
                                    }
                                    button.find('a').text(btnText);
                                },
                            },
                            {
                                text: function (dt,button,config) { return GetIncludedArchivedButtonText("@Model.ListId"); },
                                className: "btnIncludeArchived",
                                action: function (e,dt,button,config) {
                                    e.preventDefault();
                                    var btnText = "Include Archived";
                                    if (ToggleIncludeArchived(table, "@Model.ListId") == "true") {
                                        btnText = "Exclude Archived";
                                    }
                                    button.find('a').text(btnText);
                                },
                            },
                        ]
                    },
                    {
                        extend: 'colvis',
                        dropup: true,
                        text: 'Report Builder',
                        columns: ':not(.hidcol):not(.noexport)',
                        collectionLayout: 'fixed four-column',
                        columnText: function (dt, idx, title) {
                            if (title == '') {
                                return (idx + 1) + ':  untitled';
                            }
                            else {
                                return title;
                            }
                        }
                    }
                        </text>
                    },

                        @*{
                            extend: 'collection',
                            text: 'Presets',
                            dropup: true,
                            background: false,
                            buttons: [
                                {
                                    extend: 'colvisGroup',
                                    text: 'Show all',
                                    show: ':hidden:not(.hidcol)'
                                },
                                {
                                    extend: 'colvisGroup',
                                    text: 'Show none',
                                    hide: ':visible:not(.nohide)'
                                },
                                {
                                    extend: 'colvisGroup',
                                    text: 'Vehicle Info',
                                    show: '.vehinfo',
                                },
                                {
                                    extend: 'colvisGroup',
                                    text: 'Invoice Detail',
                                    show: '.invdetail'
                                }]
                        },*@
                       
                    ],
                    "dom": "<'row'<'col-sm-6'l><'col-sm-6'<'#buttonContainer.site-datatable-button-container'>>><'row'<'col-sm-12'tr>><'row'<'col-sm-5'i><'col-sm-7'p>><'#sec425'><'alert row'>B",
                    "initComplete": function (settings, json) {
                        var api = this.api();
                        @if (Model.ViewType == MyServicesViewType.Pending)
                        {
                            @:api.buttons('.btnShipToVendor').enable(false);
                            @:datatable_group_shiptovendor_sec425(api);
                        }
                        var defaultStatusFilterValue = '';
                        @if (Model.ViewType == MyServicesViewType.Master)
                        {
                            @:defaultStatusFilterValue = '@DataHelpers.GetDefaultFilterValue("LH_Master", "Status")';
                        }
                        var colFilters = json.columnFilters;
                        @if (true) /*add filter enabled check*/
                        {
                            @:var tblid = '@Model.ListId';
                            @:api.columns(['.reqNo']).every(getfn_datatable_reqno_search(tblid)); @* Make all reqNo fields searchable *@
                            @:api.columns(['.drfilter', '.dfilter']).every(getfn_datatable_drfilter(tblid, false, colFilters));
                            @:api.columns(['.drofilter']).every(getfn_datatable_drofilter(tblid));
                            @:api.columns(['.dsearch']).every(getfn_datatable_dsearch(tblid));
                            @:api.columns(['.asearch']).every(getfn_datatable_asearch(tblid));
                            @:api.columns(['.afilter']).every(getfn_datatable_afilter(tblid, true, colFilters));
                            @:api.columns(['.statusFilter']).every(getfn_datatable_statusfilter(tblid, defaultStatusFilterValue, @(Model.IncludeCancelledStatus ? "true" : "false"), colFilters));
                            @:api.columns(['.stageFilter']).every(getfn_datatable_stagefilter(tblid, colFilters));
                            @:api.columns(['.reqVIN']).every(getfn_datatable_vin(tblid, @getbool(false)));
                            @:api.columns(['.reqClientRef']).every(getfn_datatable_clientref(tblid));
                            @:api.columns(['.emptyornot']).every(getfn_datatable_emptyornotfilter(tblid, true));
                        }
                        fixupColumnWidths(this);
                    }
            });

        @if (Model.EnableKeyNavigation)
        {
        <text>
        table.on('key-focus.dt', function (e, datatable, cell) {
            table.row(cell.index().row).select();
        });

        table.on('key-blur.dt', function (e, datatable, cell) {
            table.row(cell.index().row).deselect();
        });
        </text>
        }
        @if (Model.EnableKeyShortcuts)
        {
        <text>
        $('#@Model.ListId').on('key.dt', function (e, datatable, key, cell, originalEvent) {
            if (key === 32) {
                // Toggle selection
                var row = table.row(cell.index().row);
                if ($(row.node()).hasClass('selected'))
                    row.deselect();
                else
                    row.select();
            }
            else if (key === 65) { // 'a'
                var data = table.row(cell.index().row).data();
                showAttachments(data.requestId, data.vin);
            }
            else if (key === 67) { // 'c'
                var data = table.row(cell.index().row).data();
                showChat(data.requestId, data.vin);
            }
            else if (key === 69) { // 'e'
                var data = table.row(cell.index().row).data();
                if ((data.processStageId == '1' || data.processStageId == '2') // Pending or Incoming
                        && (data.statusId == '0' || data.statusId == '1') // Pending or Active
                        && (data.userId.toLowerCase() == '@CurrentUserId')) {
                    editRequest(data.requestId);
                }
                else {
                    viewRequest(data.requestId);
                }
            }
        });
        </text>
        }

        @* @Model.TableVarName = table;*@

        $("div.dataTables_filter input").unbind();
        $("div.dataTables_filter input").keyup(function (e) {
            if (e.keyCode == 13) {
                table.search(this.value).draw();
            }
        });
        $('#@Model.ListId tbody').on('click', 'td.lh-details-control', function (e) {
            e.stopPropagation();
            var tr = $(this).closest('tr');
            var row = table.row(tr);
            var data = row.data();
            var note = data["notesAbbrev"];
            if (note && note.length > 1 && note.substr(-3) == "...") {
                if (row.child.isShown()) {
                    // This row is already open - close it
                    row.child.hide();
                    tr.removeClass('shown');
                }
                else {
                    // Open this row
                    lienholderShowNotes(row.data(), tr, row);
                }
            }
        });

        var isFilterEnabled;
        $("#filterByClientSwitch").change(function() {
            console.log($(this).prop("checked")); 
            isFilterEnabled = $(this).is(":checked");
            $(this).next("label").text(isFilterEnabled ? "Enabled" : "Disabled");

            if (isFilterEnabled) {
                 table.ajax.reload();
            }
            else{
                table.ajax.reload();
            }
        });


        $('#@Model.ListId tbody').on('click', 'td.attDD', function (e) {
            e.stopPropagation();
            var tr = $(this).closest('tr');
            var row = table.row(tr);
            var rdata = row.data();
            showAttachments(rdata.requestId, rdata.vin);
        });
        datatable_filter_setup(table, '@Model.ListId', true);
        @*datatable_multivin_search_setup(table);*@
    });
    function showReqDetails(ctl,vin) {
        var href = ctl.href;

        var succeeded = false;
        $.ajax({
            url: href,
            type: 'GET',
            async: true,
            dataType: 'text',
            cache: false,
            contentType: false,
            processData: false,
        }).done(function (res) {
            $mymodal = $("#modal-reqDetails");
            $mymodal.find("#myModal-label").html("Notifications (VIN " + vin + ")");
            $mymodal.find(".modal-body").html(res);
            $mymodal.modal("show");
        });
        return false;
    }
</script>
