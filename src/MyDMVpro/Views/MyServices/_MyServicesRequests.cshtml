@model RequestViewModel
@using MyDMVpro.Common.ViewHelpers;
@{
    var columnCount = 0;
    var CurrentUserId = MyDMVpro.Common.ClaimsHelpers.GetUserId(User);
    var IsGroupAdmin = MyDMVpro.Common.ClaimsHelpers.IsGroupAdmin(User) ? "true" : "false";

    string getbool(bool f)
    {
        if (f) return "true";
        return "false";
    }
    string filterList()
    {
        List<string> filterFields = new List<string>();
        foreach (DatatableColumnInfo col in Model.Columns)
        {
            if (!string.IsNullOrEmpty(col.FilterField))
            {
                filterFields.Add(col.FilterField);
            }
        }
        return string.Join(",", filterFields);
    }
    // TODO: Add last mod columns
    if (Model.AddLastModified)
    {
        Model.Columns.Add("Modified", "reqLastMod drofilter nowrap");
    }
    if (Model.AddLastModifiedBy)
    {
        Model.Columns.Add("Modified By", "reqLastModBy afilter");
    }
    string SortableOption(bool f)
    {
        if (Model.AllowSort && f)
        {
            return "true";
        }
        return "false";
    }
    string SearchableOption(bool f)
    {
        if (Model.EnableFilter && f)
        {
            return "true";
        }
        return "false";
    }
    Model.Columns.Add("RequestId", "reqId");
}
@if (Model.ViewType == MyServicesViewType.Pending)
{
    /*    removePendingItemsDialog*/
    <div id="modal-removePendingItems" class="modal fade hidden-print" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title" id="myModal-label">Remove pending requests</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label id="selectedCount"></label>
                    </div>
                </div>
                <div class="alert alert-danger" style="display:none" role="alert"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" data-dismiss="modal" onclick="RemovePendingItems();">OK</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
    <div id="modal-ship" class="modal fade hidden-print" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title" id="myModal-label">Ship To Vendor</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="vendCourierName">Courier</label>
                        <input type="text" width="150" id="vendCourierName" list="CourierList" />
                        <datalist id="CourierList">
                            @foreach (var courierName in Model.CourierNames)
                            {
                                <option value="@(courierName)" />
                            }
                        </datalist>
                    </div>
                    <div class="form-group">
                        <label for="vendTrackingNumber">Tracking #</label>
                        <input type="text" width="150" id="vendTrackingNumber" />
                    </div>
                    <div class="form-group">
                        <label id="selectedCount"></label>
                    </div>
                </div>
            <div class="alert alert-danger" style="display:none" role="alert"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" data-dismiss="modal" onclick="ShipItemsToVendor();">OK</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
    <div id="modal-directShip" class="modal fade hidden-print" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                    <h4 class="modal-title" id="myModal-label">Direct To Vendor</h4>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label id="selectedCount"></label>
                    </div>
                </div>
            <div class="alert alert-danger" style="display:none" role="alert"></div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-success" data-dismiss="modal" onclick="DirectItemsToVendor();">OK</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                </div>
            </div>
        </div>
    </div>
}
<div id="modal-reqDetails" class="modal fade hidden-print" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title" id="myModal-label">Notifications</h4>
            </div>
            <div class="modal-body">
            </div>
            <div class="alert alert-danger" style="display:none" role="alert"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-dismiss="modal" onclick="UpdateNotifications();">Save</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>

<script asp-add-nonce="true">
    function isNotBlankOrEmpty(val) {
        return (val != '' && val != '(empty)' && val != '(not empty)');
    }
    function UpdateNotifications() {
        $('#requestNoticeForm').on('submit', function (e) {
            e.preventDefault();
            var succeeded = false;
            $.ajax({
                url: '/Requests/UpdateNotices',
                type: 'POST',
                async: true,
                data: $('#requestNoticeForm').serialize(),
                dataType: 'text',
                cache: false,
                contentType: 'application/x-www-form-urlencoded',
                processData: false,
                complete: function () {
                },
                success: function (data) {
                    succeeded = true;
                },
                error: function (err) {
                    succeeded = false;
                }
            });
            return false;
        });
        $("#requestNoticeForm").trigger("submit");
    }
</script>

<style asp-add-nonce="true">
    .advancedFilter {
    }
    .filterToggle .advanced {
            display: none;
        }
    .filterToggle .simple {
            display: inline-block;
        }
    .filterToggle.advancedOn
        .advanced {
            display: inline-block;
        }
    .filterToggle.advancedOn
        .simple {
            display: none;
        }
    .mindate {
        display: block;
        width: 100%;
    }
    .maxdate {
        display: block;
        width: 100%;
    }
    #@Model.ListId tfoot {
        display: table-footer-group;
    }
    #@Model.ListId thead {
        display: table-header-group;
    }
   #sec425 {
        width: 100%;
        padding: 5px 0 10px;
    }
    #sec425:empty {
        display: none;
    }
    .notesview {
        margin-left: 50px;
    }
    .notesview::before {
        content: 'notes:';
        margin-right: 5px;
    }
</style>
<div class="white_box p_15 mb_15">
    <table class="display stripe" id="@Model.ListId" cellspacing="0" align="left">
        <thead>
            <tr id="headerRow-@Model.ListId">
                @if (Model.Columns.Count > 0)
                {
                    foreach (var c in Model.Columns)
                    {
                        <th class="@c.Class" @Html.Raw(c.GetHoverTextAttribute())>@c.Title</th>
                    }
                    columnCount = Model.Columns.Count;
                }
            </tr>
            <tr id="filterRow-@Model.ListId">
                <th class="clearFilter" data-toggle="tooltip" title="Clear filter"></th>
                @if (Model.EnableAdvancedSearch)
                {
                    <th class="advancedFilter" data-toggle="tooltip" title="Advanced filter"></th>
                }
                else
                {
                    <th>&nbsp;</th>
                }
                @for (int i = 2; i < columnCount; i++)
                {
                    <th>&nbsp;</th>
                }
            </tr>
        </thead>
        <tbody></tbody>
        <tfoot>
            <tr></tr>
        </tfoot>

    </table>
</div>

<script asp-add-nonce="true">
    $(document).ready(function () {
            var table = $('#@Model.ListId')
                .on('preXhr.dt', function (e, settings, data) {
                    data.dropdownFilters = '@filterList()';
                })
                .DataTable(
                {
                    @if (Model.EnableKeyNavigation)
                    {
                        @:@Model?.KeyNavigation
                    }
                    "colReorder": true,
                    "scrollX": true,
                    bSortCellsTop: true,
                    select: {
                        selector: 'td:not(.norowselect)',
                        items: "row"
                    },
                    "searching": true,
                    "pageLength": @Model.PageLength,
                    "language": {
                        select: {
                            rows: "<span class='info_xrowsselected'>%d rows selected</span>"
                            ,selector: 'td:not(.norowselect)'
                        }
                    },
                    "lengthMenu": @Model.LengthMenu,
                    @*fixedColumns: { leftColumns: 2 },*@
                    @if (Model.SortColumns.Count > 0)
                    {
                        @:order: [
                        for (var i = 0; i < Model.SortColumns.Count; i++)
                        {
                            if (i > 0) { @:,
                            } @:[$('#@Model.ListId .@Model.SortColumns[i].Name').index(), '@(Model.SortColumns[i].Descending ? "desc" : "asc")']
                        }
                        @:],
                    }
                    else {
                        @:order: [[$('#@Model.ListId .reqType').index(), 'asc'], [$('#@Model.ListId .reqState').index(), 'asc'], [$('#@Model.ListId .reqVIN').index(), 'asc']],
                    }
                    searchDelay: 500,
                    @if (Model.ViewType == MyServicesViewType.Master)
                    {
                        <text>
                        "searchCols": [
                        @if (Model.Columns.Count > 0)
                        {
                            foreach (var c in Model.Columns)
                            {
                                if (!string.IsNullOrEmpty(c.DefaultFilterValue))
                                {
                                    @:{ "search": "@c.DefaultFilterValue" },
                                }
                                else
                                {
                                    @:null,
                                }
                            }
                            columnCount = Model.Columns.Count;
                        }
                        ],
                        </text>
                    }
                    "createdRow": function (row, data, dataIndex) {
                            if (data.attachmentCount && data.attachmentCount > 0)
                                $(row).addClass('hasAttachments');
                        @if (Model.DisplayFullNotesAsChildRow)
                        {
                            <text>
                            if (typeof data.notesAbbrev !== 'undefined' && data.notesAbbrev != null && data.notesAbbrev.length > 0) {
                                var api = this.api();
                                var div = $("<div class='notesview'></div>");
                                div.text(data.notesAbbrev);
                                api.row(row).child(div[0].outerHTML).show();
                            }
                            </text>
                        }
                        },
                    "columnDefs": [
                        {
                            "targets": "reqChkbx",
                            "orderable": false,
                            "className": "select-checkbox nohide iconColumn dt-center noexport",
                            "width": "20px"
                        },
                        {
                            "targets": "reqAtt",
                            "width": "30px",
                            "searchable": false,
                            "orderable": false,
                            "className": "iconColumn dt-center noexport norowselect",
                            "render": datatable_render_attIcon
                        },
                        {
                            "targets": "reqHelpLink",
                            "orderable": false,
                            "className": "iconColumn dt-center noexport",
                            "autowidth": false,
                            "visible": false,
                            "width": "30px",
                            "render": datatable_render_publichelplink
                        },
                    {
                        "targets": "reqChat",
                        "width": "30px",
                        "orderable": true,
                        "data": "chatSort",
                        "orderSequence": ["desc", "asc"],
                        "className": "chatcol iconSortableColumn dt-center noexport norowselect",
                        "render": function (data, type, full, meta) {
                            var val = 0;
                            if (full.waitingForUserReply) val = 3;
                            else if (full.waitingForVendorReply) val = 2;
                            else if (full.hasActiveChat) val = 1;

                            if (type == "display") {
                                var chatClass = 'chatIcon';
                                if (full.waitingForUserReply) {
                                    chatClass += ' chatAlert';
                                }
                                else if (full.waitingForVendorReply) {
                                    chatClass += ' chatWaiting';
                                }
                                else if (full.hasActiveChat) {
                                    chatClass += ' chatActive';
                                }
                                else if (full.hasNewChat) {
                                    chatClass += ' chatNew';
                                }
                                var html = '<a title="Chat" tabIndex="-1" href="#" data-requestid="' + htmlEncode(full.requestId) +'" class="' + chatClass + '" onclick="return showChat(\'' + htmlEncode(full.requestId) + '\', \'' + htmlEncode(full.vin) + '\');"></a>';
                                return html;
                            }
                            if (type == "sort" || type == "type")
                                return val;
                            return val;
                        }
                    },
                    {
                        "targets": "reqCommunicationChat",
                        "width": "30px",
                        "orderable": true,
                        "data": "chatSort",
                        "orderSequence": ["desc", "asc"],
                        "className": "chatcol iconSortableColumn dt-center noexport norowselect",
                        "render": function (data, type, full, meta) {
                            var val = 0;
                            if (full.waitingForUserReply) val = 3;
                            else if (full.waitingForVendorReply) val = 2;
                            else if (full.hasActiveChat) val = 1;
                            if (type == "display") {
                                var chatClass = 'chatIcon';
                                if (full.waitingForUser) {
                                    chatClass += ' chatAlert';
                                }
                                else if (full.waitingForVendorReply) {
                                    chatClass += ' chatWaiting';
                                }
                                else if (full.hasActiveChat) {
                                    chatClass += ' chatActive';
                                }
                                else if (full.hasNewChat) {
                                    chatClass += ' chatNew';
                                }
                                var html = '<a title="Chat" tabIndex="-1" href="#" data-requestid="' + htmlEncode(full.requestId) +'" class="' + chatClass + '" onclick="return showChat(\'' + htmlEncode(full.requestId) + '\', \'' + htmlEncode(full.vin) + '\');"></a>';
                                return html;
                            }
                            if (type == "sort" || type == "type")
                                return val;
                            return val;
                        }
                    },
                    {
                        "targets": "reqDupeCheck",
                        "orderable": false,
                        "min-width": "30px",
                        "sortable": false,
                        "className": "iconColumn dt-center noexport",
                        "render": function (data, type, full, meta) {
                            @*
                            -1 == NO CALL TO AUTOIMS
                            0 = SUCCESSFUL AUTOIMS UPDATE
                            1 = ERROR PROCESSING AUTOIMS
                            *@
                            if (type == "display") {
                                if (full.dupeAppTypeForVin > 0 || full.activeCountForVin > 0) {
                                    var className = '';
                                    var dupeMsg = '';
                                    if (full.dupeAppTypeForVin > 1) {
                                        className = 'dupeAppTypeForVin';
                                        dupeMsg = '' + htmlEncode(full.dupeAppTypeForVin) + ' instances found for this vin and application type';
                                    }
                                    else if (full.activeCountForVin > 0) {
                                        className = 'activeCountForVin';
                                        dupeMsg = '' + htmlEncode(full.activeCountForVin) + ' instances found for this vin for other application types';
                                    }
                                    else {
                                        return '';
                                    }
                                    var html = '<div title="' + htmlEncode(dupeMsg) + '" class="' + className + '" />';
                                    return html;
                                }
                                return '';
                            }
                            return '';
                        }
                    },
                    { "targets": "reqAutoIMS", "orderable": false, "className": "autoIMS dt-center noexport", "min-width": "30px", "sortable": false, "render": datatable_render_group_autoims },
                    { "targets": "reqViewRequest", "min-width": "32px", "className": "dt-center noexport", "width": "70px", "searchable": false, "orderable": false, "render": datatable_render_group_viewrequest },
                    {
                        "targets": "reqEditRequest", "min-width": "32px", "className": "dt-center noexport", "width": "70px", "searchable": false, "orderable": false,
                        "render": getfn_datatable_render_group_editrequest('@CurrentUserId', @IsGroupAdmin)
                    },
                    @if (Model.EnablePDF)
                    {
                        @:{ "targets": "reqViewSign", "width": "40px", "className": "dt-center noexport", "orderable": false, "searchable": false, "render": datatable_render_group_viewsign },
                    }
                    @* reqLinks is Deprecated - use more specific (reqNotices, reqViewSign, etc...) *@
                    @*
                    reqLinks and ReqNotices are no longer used
                    { "targets": "reqLinks", "width": "40px", "orderable": false, "searchable": false, "render": datatable_render_group_links },
                    { "targets": "reqNotices", "width": "40px", "orderable": false, "searchable": false, "render": datatable_render_group_notices },
                    *@
                    { "targets": "reqLH", "data": "lienholderName" },
                    { "targets": "reqAuctioneer", "data": "auction" },
                    { "targets": "reqVIN", "sortable": true, "width": "120px", "searchable": true, "type": "text-vin", "orderable": true, "data": "vin", "render": datatable_render_vin },
                    {
                        "targets": "reqClientRef", "sortable": true, "searchable": true, "orderable": true,
                        "data": "clientRef", "autowidth": true, "max-width": "120px"
                    },
                    { "targets": "reqMake", "sortable": true, "width": "120px", "searchable": true, "data": "vehicleMake" },
                    { "targets": "reqType", "sortable": true, "searchable": true, "data": "appType", "name": "AppType" },
                    { "targets": "reqChatAppType", "sortable": true, "searchable": true, "data": "type", "name": "AppType" },
                    { "targets": "reqState", "width": "60px", "searchable": true, "data": "state" },
                    { "targets": "reqYear", "sortable": true, "width": "60px", "searchable": true, "data": "vehicleYear" },
                    { "targets": "reqDateToVendor", "data": "dateToVendor"  },
                    { "targets": "reqDateFromLH", "data": "dateReceived", "render": datatable_render_date },
                    { "targets": "reqSigned", "data": "dateReceived" },
                    { "targets": "reqPrinted", "data": "datePrinted" },
                    { "targets": "reqDateToDMV", "data": "dateToDmv" },
                    { "targets": "reqDateFromDMV", "data": "dateFromDmv" },
                    { "targets": "reqLIDateToDMV", "data": "lI_DateToDmv" },
                    { "targets": "reqLIDateFromDMV", "data": "lI_DateFromDmv" },
                    { "targets": "reqRejection", "data": "rejectionDate" },
                    { "targets": "reqCode", "data": "code" },
                    { "targets": "reqFinished", "data": "dateShipped","orderSequence": ["desc","asc"], "render": datatable_render_date },
                    { "targets": "reqLienExpDate", "data": "lienExpDate" },
                    { "targets": "reqLastModBy", "sortable": true, "data": "lastModifiedBy", "className": "dt-nowrap" },
                    { "targets": "reqLastMod", "sortable": true, "data": "lastModified", "className": "dt-nowrap", "render": getfn_datatable_render_datetime_short() },
                    { "targets": "reqRepoDate", "data": "repoDate" },
                    { "targets": "reqLH_ETA", "data": "lh_eta", "render": datatable_render_date },
                    {
                        "targets": ["dfilter", "drfilter", "dsearch", "drofilter", "datefmt" ],
                        "sortable": true,
                        "width": "100px",
                        "defaultContent": "",
                        "render": datatable_render_date
                    },
                    {
                        "targets": ["reqNotes"], "sortable": false, "className": "lh-details-control",
                        "orderable": false, "data": "notesAbbrev", "defaultContent": '',
                        "searchable": false, "autowidth": false, "width": "150px"
                    },
                    {
                        "targets": ["reqFullNotes"], "sortable": false,
                        "orderable": false, "data": "notesAbbrev", "defaultContent": '',
                        "searchable": false, "autowidth": true, "visible": false
                    },
                    { "targets": "reqCourier", "sortable": true, "searchable": true, "data": "courier" },
                    { "targets": "reqTracking", "sortable": true, "searchable": true, "data": "trackingNumber" },
                    { "targets": "reqSubmittedBy", "data": "submittedBy", "searchable": true },
                    { "targets": "reqVendor", "sortable": true, "searchable": true, "data": "vendorCode" },
                    { "targets": "reqTitleIssued", "data": "dateTitleIssued" },
                    { "targets": "reqId", "visible": false, "className": "hidcol noexport", "sortable": false, "data": "requestId", "searchable": false },
                    {
                        "targets": "reqBlank", "defaultContent": "", "sortable": false, "orderable": false,
                        "className": "noexport",
                        "autowidth": false,
