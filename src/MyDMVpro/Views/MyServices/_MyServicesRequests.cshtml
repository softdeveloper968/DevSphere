                        "min-width": "30px",
                        "max-width": "30px",
                    },
                    { "targets": "reqStage", "data": "processStageId", "searchable": true, "sortable": true, "render": datatable_render_stage },
                    { "targets": "reqStatus", "data": "statusId", "searchable": true, "sortable": true, "render": datatable_render_status },
                    {
                        "targets": "_all", "searchable": true, "className": "dt-center", "autowidth": true, "defaultContent": "", "sortable": true,
                        render: $.fn.dataTable.render.text()
                    },
                    {
                        "targets": "reqAttachmentType",
                        "data": "attachmentType",
                        "title": "Attachment Type",
                        "searchable": true,
                        "orderable": true,
                        "render": function (data, type, full, meta) {
