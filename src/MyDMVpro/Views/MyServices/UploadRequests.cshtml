<script src="~/js/vendor.js" asp-append-version="true"></script>
<script asp-add-nonce="true">
    function signBatch(idList) {

    }
    function createBatch(idList) {
        var formData = new FormData();

        if (idList == undefined)
            return;

        if (!Array.isArray(idList) || idList.length == 0)
            return;

        idList.forEach(function (id) {
            formData.append("ids[]", id);
        });

        var succeeded = false;
        $.ajax({
            url: '/Forms/CreateBackgroundBatch',
            type: 'POST',
            headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
            async: true,
            data: formData,
            dataType: 'json',
            cache: false,
            contentType: false,
            processData: false,
            complete: function () {
            },
            success: function (data) {
                if (data.error) {
                    if (data.error !== '') {
                        alert(data.error);
                        return;
                    }
                }
                window.location = "/Forms/SignBatch/" + data.batchId;
            },
            error: function () {
                succeeded = false;
            }
        });
    }
</script>

