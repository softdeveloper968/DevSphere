<script asp-add-nonce="true">
    $(document).ready(() => {
        var acc = document.getElementsByClassName("accordion");
        var i;

        for (i = 0; i < acc.length; i++) {
            acc[i].addEventListener("click", function () {
                this.classList.toggle("active");
                var panel = this.nextElementSibling;
                if (panel.style.display === "block") {
                    panel.style.display = "none";
                } else {
                    panel.style.display = "block";
                }
            });
        }
    });
</script>
<script asp-add-nonce="true">
    var pendingTable;
    var pendingTable_Items;
    function ShowRemovePending(t) {
        pendingTable = t;
        pendingTable_Items = lhGetSelectedItems(t);
        var html = "No items selected";
        var disabled = true;
        if (pendingTable_Items.length != 0) {
            html = "Operation will remove the " + pendingTable_Items.length + " selected requests.";
            disabled = false;
        }
        $("#modal-removePendingItems").find("#selectedCount").html(html);
        $("#modal-removePendingItems").modal("show");
    }
    function RemovePendingItems() {
        var formData = new FormData();

        if (pendingTable_Items) {
            $.each(pendingTable_Items, function (i, id) {
                formData.append('ids', id);
            });
            var succeeded = false;
            $.ajax({
                url: '@Url.Action("RemovePending", "MyServices")',
                type: 'POST',
                headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                async: true,
                data: formData,
                dataType: 'text',
                cache: false,
                contentType: false,
                processData: false,
                complete: function () {
                    // refresh list
                    if (typeof PendingRequests !== 'undefined')
                        PendingRequests.ajax.reload(null, false);
                },
                success: function (data) {
                    succeeded = true;
                },
                error: function () {
                    succeeded = false;
                }
            });
        }
    }
</script>
<script asp-add-nonce="true">
    var lhShipTable;
    var lhShipTable_Items;

    function ShowDirectToVendor(t) {
        lhShipTable = t;
        lhShipTable_Items = lhGetSelectedItems(t);
        var html = "No items selected";
        var disabled = true;
        if (lhShipTable_Items.length != 0) {
            html = "Operation will submit the " + lhShipTable_Items.length + " selected items for processing.";
            disabled = false;
        }
        $("#modal-directShip").find("#vendVendorName").prop('disabled', disabled);
        $("#modal-directShip").find("#selectedCount").html(html);
        $("#modal-directShip").modal("show");
    }
    function DirectItemsToVendor() {
        var formData = new FormData();

        if (lhShipTable_Items) {
            $.each(lhShipTable_Items, function (i, id) {
                formData.append('ids', id);
            });
            var succeeded = false;
            $.ajax({
                url: '@Url.Action("DirectToVendor", "MyServices")',
                type: 'POST',
                headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                async: true,
                data: formData,
                dataType: 'text',
                cache: false,
                contentType: false,
                processData: false,
                complete: function () {
                    // refresh list
                    if (typeof PendingRequests !== 'undefined')
                        PendingRequests.ajax.reload(null, false);
                },
                success: function (data) {
                    succeeded = true;
                },
                error: function () {
                    succeeded = false;
                }
            });
        }
    }
    function ShowShipToVendor(t) {
        lhShipTable = t;
        lhShipTable_Items = lhGetSelectedItems(t);
        var html = "No items selected";
        var disabled = true;
        if (lhShipTable_Items.length != 0) {
            html = "Operation will mark the " + lhShipTable_Items.length + " selected items as shipped today, " + moment().format('MM-DD-YYYY');
            disabled = false;
        }
        $("#modal-ship").find("#vendCourierName").prop('disabled', disabled);
        $("#modal-ship").find("#vendTrackingNumber").prop('disabled', disabled);
        $("#modal-ship").find("#selectedCount").html(html);
        $("#modal-ship").modal("show");
    }
    function ShipItemsToVendor() {
        var formData = new FormData();

        if (lhShipTable_Items) {
            var courierName = $("#vendCourierName").val();
            var trackingNumber = $("#vendTrackingNumber").val();
            formData.append('courierName', courierName);
            formData.append('trackingNumber', trackingNumber);
            $.each(lhShipTable_Items, function (i, id) {
                formData.append('ids', id);
            });
            var succeeded = false;
            $.ajax({
                url: '@Url.Action("ShipItems", "MyServices")',
                type: 'POST',
                headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                async: true,
                data: formData,
                dataType: 'text',
                cache: false,
                contentType: false,
                processData: false,
                complete: function () {
                    // refresh list
                    if (typeof PendingRequests !== 'undefined')
                        PendingRequests.ajax.reload(null, false);
                },
                success: function (data) {
                    succeeded = true;
                },
                error: function () {
                    succeeded = false;
                }
            });
        }
    }
    function lhGetSelectedItems(t) {
        var a = [];
        $.each(t.rows({ selected: true }).data(), function () {
            a.push(this["requestId"]);
        });
        return a;
    }

</script>

