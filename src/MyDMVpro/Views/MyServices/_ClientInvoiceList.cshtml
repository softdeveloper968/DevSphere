@model VendorInvoiceViewModel
@using MyDMVpro.Common.ViewHelpers;
@{
    var columnCount = 0;
}
<style asp-add-nonce="true">
    td.numericCol {
        text-align: right !important;
        padding-right: 30px;
    }
    .advancedFilter {
    }
    .filterToggle .advanced {
            display: none;
        }
    .filterToggle .simple {
            display: inline-block;
        }
    .filterToggle.advancedOn
        .advanced {
            display: inline-block;
        }
    .filterToggle.advancedOn
        .simple {
            display: none;
        }

    td.sum {
        border-top: 4px double black;
    }

    #@(Model.ListId)_wrapper tfoot {
        display: table-footer-group;
        font-weight: bold;
    }
    #@(Model.ListId)_wrapper thead {
        display: table-header-group;
    }

    div.selectedInvoiceTotal {
        display: inline-block;
        font-text: right;
    }
</style>

<div id="invoiceList" class="box">
    <div class="box-body table-responsive" height="80%">
        <table class="display stripe" id="@Model.ListId" cellspacing="0" align="left">
            <thead>
                <tr id="headerRow-@Model.ListId">
                    @if (Model.Columns.Count > 0)
                    {
                        foreach (var c in Model.Columns)
                        {
                            <th class="@c.Class dt-center">@c.Title</th>
                        }
                        columnCount = Model.Columns.Count;
                    }
                </tr>
                <tr id="filterRow-@Model.ListId">
                    @for (var i = 0; i < Model.Columns.Count; i++)
                    {
                        DatatableColumnInfo c = Model.Columns[i];
                        string cls = c.Class;//.Split(" ")[0];

                        if (i == 0)
                        {
                            <th class="clearFilter @cls" data-toggle="tooltip" title="Clear filter"></th>
                        }
                        else if (i == 1 && Model.EnableAdvancedSearch)
                        {
                            <th class="advancedFilter @cls" data-toggle="tooltip" title="Advanced filter"></th>
                        }
                        else
                        {
                            if (cls == "")
                            {
                                <th></th>
                            }
                            else
                            {
                                <th class="@cls"></th>
                            }
                        }
                    }
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot>
                <tr>
                    @if (Model.Columns.Count > 0)
                    {
                        foreach (var c in Model.Columns)
                        {
                            <td></td>
                        }
                    }
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<script asp-add-nonce="true">
    $(document).ready(function () {
        $.fn.dataTable.render.shortDate = datatable_render_shortdate;

        var table = $('#@Model.ListId').DataTable(
            {
                @if  (Model.EnableKeyNavigation)
                { 
                    @:@Model?.KeyNavigation
                }
                "colReorder": true,
                "scrollX": true,
                scrollY: false,
                "select": true,
                "searching": true,
                "pageLength": @Model.PageLength,
                "language": {
                    select: {
                        rows: "<span class='info_xrowsselected'>%d rows selected</span>"
                    }
                },
                bSortCellsTop: true,
                "lengthMenu": @Model.LengthMenu,
                @if (Model.SortColumns.Count > 0)
                {
                    @:order: [
                    for(var i = 0; i<Model.SortColumns.Count; i++)
                    {
                        if (i > 0) { @:,
                        } @:[$('#@Model.ListId .@Model.SortColumns[i].Name').index(), '@(Model.SortColumns[i].Descending?"desc":"asc")']
                    }
                    @:],
                }
                searchDelay: 500,
                "columnDefs": [
                    {
                        "targets": "reqChkbx",
                        "orderable": false,
                        "className": "select-checkbox",
                        "min-width": "40px",
                        "sortable": false,
                    },
                    { "targets": "reqInvoiceNo", "data": "invoiceNo" },
                    { "targets": "reqInvoiceDate", "data": "invoiceDate","orderSequence": ["desc","asc"] },
                    { "targets": "datefmt", "defaultContent": "", "render": datatable_render_date },
                    // { "targets": "reqInvoiceDatePaid", "data": "invoiceDatePaid","orderSequence": ["desc","asc"] },
                    // { "targets": "reqInvoiceNote", "data": "invoiceNote" },
                    { "targets": "reqServiceFees", "data": "serviceFees" },
                    { "targets": "reqDmvFees", "data": "dmvFees" },
                    { "targets": "reqOtherFees", "data": "otherFees" },
                    {
                        "targets": "reqInvoiceAmount", "data": "invoiceAmount"
                    },
                    {
                        "targets": ["currency", "currencyFmt"], className: "numericCol", width: "130px",
                        "render": $.fn.dataTable.render.number(',', '.', 2, '$ ')
                    },
                    {
                        "targets": [ "dfilter", "drfilter" ],
                        "sortable": true,
                        "width": "100px",
                        "defaultContent": "",
                        "render": datatable_render_date
                    },
                    {
                        "targets": ["reqInvoiceNote"], "sortable": false, "orderable": false, "data": "invoiceNote", "defaultContent": '',
                            "searchable": true, "autowidth": true, "max-width": "200px", "width": "150px"
                    },
                    { "targets": "reqGroup", "data": "groupName", "width": "150px" },
                    { "targets": "reqBillTo", "data": "billToName", "width": "150px" },
                    { "targets": "reqCreatedBy", "data": "createdBy" },
                    {
                        "targets": "reqLinks", "data": "", width: "40px",
                        "sortable": false,
                        "render": function (data, type, full, meta) {
                            if (type == "display") {
                                var html = '<a target="_blank" title="View Invoice" class="viewInvoice" tabIndex="-1" href="/Vendor/ViewInvoice/' + full.invoiceId + '"></a>';
                                return html;
                            }
                            return '';
                        }
                    },
                    {
                        "targets": "reqPdf", "data": "", width: "40px",
                        "sortable": false,
                        "render": function (data, type, full, meta) {
                            if (type == "display") {
                                var html = '<a title="Download Invoice" class="downloadInvoice" tabIndex="-1" href="/Vendor/ViewInvoice/' + full.invoiceId + '?fmt=pdf"></a>';
                                return html;
                            }
                            return '';
                        }
                    },
                    { "targets": "reqInvoiceId", "visible": false, "sortable": false, "data": "invoiceId", "searchable": false },
                    {
                        "targets": "_all", "searchable": true, "className": "dt-center", "autowidth": true, "defaultContent": "", "sortable": true,
                        render: $.fn.dataTable.render.text()
                    },
                ],
                "processing": true,
                "serverSide": true,
                "ajax":
                    {
                        "url": "@Model.DataUrl",
                        "type": "POST",
                        "dataType": "JSON",
                        headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() }
                    },
                "createdRow": function (row, data, dataIndex) {
                    if (data.attachmentCount && data.attachmentCount > 0)
                        $(row).addClass('hasAttachments');
                    },
                "buttons": [
                    {
                        extend: 'selectAll',
                        className: 'selectall',
                        action: function (e) {
                            e.preventDefault();
                            table.rows({ search: 'applied' }).deselect();
                            table.rows({ search: 'applied' }).select();
                        }
                    },
                    'selectNone',
                    {
                        extend: 'collection',
                        text: 'Export',
                        dropup: true,
                        background: false,
                        buttons: [
                            {
                                extend: 'copy',
                                exportOptions: {
                                    columns: ':visible'
                                }
                            },
                            {
                                extend: 'excelHtml5',
                                exportOptions: {
                                    columns: ':visible'
                                }
                            },
                            {
                                extend: 'pdfHtml5',
                                orientation: 'landscape',
                                pageSize: 'LETTER',
                                exportOptions: {
                                    columns: ':visible',
                                },
                                footer: true
                            },
                            {
                                extend: "print",
                                exportOptions: {
                                    columns: ':visible'
                                }
                            },
                            {
                                name: 'ExportCsvData',
                                className: 'exportCsvData selectOnOff',
                                text: 'Data as CSV',
                                action: function (e) {
                                    e.preventDefault();
                                    exportInvoicesToCsv(table);
                                }
                            },
                        ]
                    },
                    { text: "", titleAttr: "Refresh", className: "listRefresh", action: function (e) { e.preventDefault(); table.ajax.reload(); }},
                ],
                "initComplete": function (settings, json ) {

                    var colFilters = json.columnFilters;
                    var api = this.api();

                    api.columns(['.dfilter']).every(function () {
                        var column = this;
                        var select = $('<select class="customFilter"><option value=""></option></select>')
                            .appendTo($("#filterRow-@Model.ListId th").eq(column.index()).empty())
                            .on('change', function () {
                                var val = $(this).val();
                                let col = getTransposedColumn(column);
                                col
                                    .search(val ? val : '', false, false)
                                    .draw();
                            });
                        var colName = column.dataSrc();
                        if (!(colName === undefined) && !(colFilters[colName] === undefined)) {
                            $.each(colFilters[colName], function (index, value) {
                                if (value) {
                                    select.append(buildOption_Date(value));
                                }
                            });
                        }
                    });
                    api.columns(['.drfilter','.dfilter']).every(function () {
                        var column = this;
                        var select = $('<div class="filterToggle"><select class="customFilter simple"><option value=""></option></select><div class="customFilter advanced"><input id="min" class="mindate" type="date"></input><input id="max" class="maxdate" type="date"></input></div></div>')
                            .appendTo($("#filterRow-@Model.ListId th").eq(column.index()).empty());
                        select.find('select').on('change', function () {
                                var val = $(this).val();
                                var dt;
                                if (val != '')
                                    dt = moment.utc(val);
                                if (val != '' && !dt.isValid()) {
                                    $(this).addClass("invalidDate");
                                }
                                else {
                                    $(this).removeClass("invalidDate");
                                    let col = getTransposedColumn(column);
                                    if (val != '') {
                                        val = dt.format('MM-DD-YYYY');
                                        col
                                            .search(val ? val : '', false, false)
                                            .draw();
                                    }
                                    else {
                                        col
                                            .search('', false, false)
                                            .draw();
                                    }
                                }
                            });
                            select.find('div').find("#min, #max").on('change', function () {
                                if ($(this).is(":visible")) {
                                    var fromval = $(this).parent().find("#min").val();
                                    var toval = $(this).parent().find("#max").val();
                                    var rangeVal = "";
                                    if (fromval != "" || toval != "")
                                        rangeVal = fromval + ";-to-;" + toval;

                                    let col = getTransposedColumn(column);
                                    col
                                        .search(rangeVal ? rangeVal : '', false, false)
                                        .draw();
                                }
                            });
                        var colName = column.dataSrc();
                        if (!(colName === undefined) && !(colFilters[colName] === undefined)) {
                            $.each(colFilters[colName], function (index, value) {
                                if (value) {
                                    //var d = moment.utc(value).format('MM-DD-YYYY');
                                    //var dval = moment.utc(value).format('YYYY-MM-DD');
                                    select.find('select').append(buildOption_Date(value));
                                }
                            });
                        }
                    });
                    api.columns(['.afilter']).every(function () {
                        var column = this;
                        var select = $('<select class="customFilter"><option value=""></option></select>')
                            .appendTo($("#filterRow-@Model.ListId th").eq(column.index()).empty())
                            .on('change', function () {
                                var val = $(this).val();
                                let col = getTransposedColumn(column);
                                col
                                    .search(val ? val : '', false, false)
                                    .draw();
                        });
                        var colName = column.dataSrc();
                        if (!(colName === undefined) && !(colFilters[colName] === undefined)) {
                            $.each(colFilters[colName], function (index, value) {
                                if (value) {
                                    var opt = $('<option></option>').attr({ value: value }).text(value);
                                    select.append(opt);
                                }
                            });
                        }
                    });
                    api.columns(['.statusFilter']).every(function () {
                        var column = this;
                        var select = getStatusSelectFilter()
                            .appendTo($("#filterRow-@Model.ListId th").eq(column.index()).empty())
                            .on('change', function () {
                                var val = $(this).val();
                                let col = getTransposedColumn(column);
                                col
                                    .search(val ? val : '', false, false)
                                    .draw();
                            });
                    });
                    api.columns(['.asearch']).every(function () {
                        var column = this;
                        var select = $('<input class="customFilter" type="text" placeholder="Search" />')
                            .appendTo($("#filterRow-@Model.ListId th").eq(column.index()).empty())
                            .on('change', function () {
                                var val = $(this).val();
                                let col = getTransposedColumn(column);
                                col
                                    .search(val ? val : '', false, false)
                                    .draw();
                            });
                    });
                    fixupColumnWidths(this);
                },
                "footerCallback": function (row, data, start, end, display) {
                    var api = this.api();
                    var fmtCurrency = $.fn.dataTable.render.number(',', '.', 2, '$ ');

                    api.columns('.sum', {
                        page: 'current'
                    }).every(function () {
                        var sum = this
                            .data()
                            .reduce(function (a, b) {
                                var x = roundMoney(parseFloat(a)) || 0;
                                var y = roundMoney(parseFloat(b)) || 0;
                                return x + y;
                            }, 0);
                        let text = fmtCurrency.display(sum);
                        $(this.footer()).html(text);
                    });
                },
                "dom": "<'row'<'col-sm-6'l><'col-sm-6'<'#buttonContainer.site-datatable-button-container'>>>" + "<'row'<'col-sm-12'tr>>" + "<'row'<'col-sm-5'i><'col-sm-7'p>><'alert row'>B<'selectedInvoiceTotal'>",
            });

        @if (Model.EnableKeyNavigation)
        {
        <text>
        $('#@Model.ListId').on('key-focus.dt', function (e, datatable, cell) {
            //table.row(cell.index().row).select();
        });

        $('#@Model.ListId').on('key-blur.dt', function (e, datatable, cell) {
            //table.row(cell.index().row).deselect();
        });

        $('#@Model.ListId').on('key.dt', function (e, datatable, key, cell, originalEvent) {
            if (key === 32) {
                // Toggle selection
                var row = table.row(cell.index().row);
                if ($(row.node()).hasClass('selected'))
                    row.deselect();
                else
                    row.select();
            }
            else if (key === 65) { // 'a'
                var data = table.row(cell.index().row).data();
                showAttachments(data.requestId, data.vin);
            }
            else if (key === 67) { // 'c'
                var data = table.row(cell.index().row).data();
                showChat(data.requestId, data.vin);
            }
            else if (key === 69) { // 'e'
                var data = table.row(cell.index().row).data();
                vendorEditRequest(data.requestId);
            }
        });
        </text>
        }
        @Model.TableVarName = table;
       
        table.on('select deselect', function (e, dt, type, indexes) {
            if (type === 'row') {
                let $outerDiv = $('#invoiceList');
                var ctl = $outerDiv.find("div.selectedInvoiceTotal");
                if (table.rows({ selected: true }).indexes().length === 0) {
                    table.buttons('.selectOnOff').disable();
                    ctl.html('');
                }
                else {
                    table.buttons('.selectOnOff').enable();
                }
            }
        });

        table.buttons('.selectOnOff').disable();

        $('#filterRow-@Model.ListId').find('.clearFilter').on('click', function (e) {
            e.stopPropagation();
            $('#@Model.ListId').find('.customFilter').val('');
            table.search('').columns().search('').draw();
        });

        $('#filterRow-@Model.ListId').find('.advancedFilter').on('click', function (e) {
            e.stopPropagation();
            $('#@Model.ListId').find('.filterToggle').toggleClass('advancedOn');
            table.columns.adjust().draw();
        });
    });
</script>
<form id="downloadInvoices" action="/Vendor/ViewMultipleInvoice?fmt=pdf" method="post"></form>
