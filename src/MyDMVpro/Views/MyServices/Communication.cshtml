<script>
 
    $(document).ready(function () {
        $('[data-toggle="popover"]').popover();
        loadAttachments()
        loadData();       
    });

    var messageParts = {
        attachments: "",
        dataRequests: "",
        chats: ""
    };

    function updateMessageContainer() {
        let combinedMessage = "Hello, you currently have ";
        
        let allZero = !messageParts.attachments && !messageParts.dataRequests && !messageParts.chats;

        let messageArray = Object.values(messageParts).filter(part => part !== ""); // Remove empty messages

        if (messageArray.length > 0) {
            combinedMessage += messageArray.join(" and ") + ".";
        } else {
            combinedMessage = "Hello, you do not have any current requests for follow-up documents, data, or chat. Please check back here later! Thank you!";
        }

        $('#messageContainer').html(combinedMessage).show();
    }

    function loadAttachments(){
       
        $.ajax({
            url: '/MyServices/GetMissingAttachmentsListOptimized',
            type: 'POST', 
            async: true,
            dataType: 'html',
            cache: false,
            contentType: 'application/x-www-form-urlencoded; charset=UTF-8',
            processData: true, 
            headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
            success: function (response) {
                var data = JSON.parse(response)

                messageParts.attachments = (data && data.length > 0) ? `${data.length} attachment requests` : "";
                updateMessageContainer();
              

                if ($.fn.DataTable.isDataTable('#missingAttachmentsTable')) {
                    $('#missingAttachmentsTable').DataTable().destroy();
                }

                var table = $('#missingAttachmentsTable').DataTable({
                     data: data,
                    "paging": true,
                    "pageLength": 10,
                    "scrollX": true,
                    "scrollY": "400px",
                    "scrollCollapse": true,
                    "searching": true,
                    "info": true,
                    "lengthChange": true,
                    "ordering": true,
                    "language": {
                        emptyTable: "No missing attachments available"
                    },
                    "buttons": [
                        {
                            extend: 'collection',
                            className: 'btn-export-auditlookup',
                            text: 'Export',
                            buttons: [
                                {
                                    extend: 'copy',
                                    text: 'Copy',
                                    exportOptions: {
                                        columns: ':visible'
                                    }
                                },
                                {
                                    extend: 'excelHtml5',
                                    text: 'Excel',
                                    autoFilter: true,
                                    sheetName: 'myDMV.pro',
                                    exportOptions: {
                                        columns: ':visible'
                                    }
                                },
                                {
                                    extend: 'pdfHtml5',
                                    text: 'PDF',
                                    orientation: 'landscape',
                                    pageSize: 'LEGAL',
                                    exportOptions: {
                                        columns: ':visible'
                                    }
                                },
                                {
                                    extend: 'print',
                                    text: 'Print',
                                    exportOptions: {
                                        columns: ':visible'
                                    }
                                }
                            ]
                        }
                    ],
                     columns: [
                        { data: 'requestNumber', render: function (data) { return `<input type="checkbox" class="selectRow" value="${data}" data-id="${data}" />`; } },
                        { data: null, render: getfn_datatable_render_group_editrequest() },
                        { data: 'attachmentType' },
                        { data: 'hardcopyOrDigital', render: function (data) { return data ? "Hardcopy" : "Digital"; } },
                        { data: 'attachmentDescription' },
                        { data: 'processStageId', render: function (data) { return getProcessstageName(data); } },
                        { data: 'vin' },
                        { data: 'state' },
                        { data: 'type' },
                        { data: 'dateToVendor', render: function (data) { return data ? formatDateForDisplay(data) : ''; } },
                        { data: 'requestNumber' }
                    ]
                });                

                function formatDateForDisplay(date) {
                    return new Date(date).toLocaleDateString();  // Customize as needed
                }

                function getProcessstageName(id) {
                    switch (id) {
                        case 2:
                            return "Incoming";
                            break;
                        case 12:
                            return "Not Ready To Process";
                            break;
                        case 99:
                            return "Hold";
                            break;
                        default:
                            return "";
                    }
                }

                table.buttons().container().appendTo('#export-button-audit');

                table.columns.adjust();

                const uploadDocumentSection = document.getElementById('missing-uploadDocument');

                $('#missingAttachmentsTable').on('click', '.selectRow', function () {
                    $('.selectRow').not(this).prop('checked', false);
                    $('.selectRow').not(this).closest('tr').removeClass('selected');

                    var isChecked = $(this).prop('checked');
                    var id = $(this).prop("data-id");

                    if (isChecked) {
                        $(this).closest('tr').addClass('selected');
                        var selectedRow = $(this).closest('tr');
                        const rowData = table.row(selectedRow).data(); // Use DataTable API to get the data
                        updateSelectAllCheckbox(rowData.requestId, rowData.attachmentTypeId);
                       
                    }
                    else {
                        $(this).closest('tr').removeClass('selected');
                        uploadDocumentSection.style.display = 'none'; // Hide the div
                        const warningSection = document.getElementById('warningContainer');
                        warningSection.style.display = 'none'; // Show the div

                    }

                });

                function updateSelectAllCheckbox(dataId, attachmentId) {
                    var totalRows = $('.selectRow').length;
                    var selectedRows = $('.selectRow:checked').length;
                    $('#selectAll').prop('checked', totalRows === selectedRows);
                    fetchAttachmentData(dataId, attachmentId)
                }
            },
            error: function (xhr, status, error) {
                $('#loadingSkeleton').show();
            }
        });

    }

    function loadData() {

        $.ajax({
            url: "/MyServices/NeededDataRequestCodes",
            type: 'POST', 
            async: true,
            dataType: 'html', 
            cache: false,
            contentType: 'application/x-www-form-urlencoded; charset=UTF-8', 
            processData: true, 
            headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
            success: function (response) {

                var data = JSON.parse(response)
                messageParts.dataRequests = (data && data.length > 0) ? `${data.length} data requests` : "";
                updateMessageContainer();

                if ($.fn.DataTable.isDataTable('#missingDataTable')) {
                    $('#missingDataTable').DataTable().clear().destroy();
                    $('#missingDataTable tbody').empty();
                }
              
                var table = $('#missingDataTable').DataTable({
                    data: data,
                    "autoWidth": false,
                    "paging": true,
                    "pageLength": 10,
                    "scrollX": true,
                    "scrollY": "400px",
                    "scrollCollapse": true,
                    "searching": true,
                    "info": true,
                    "lengthChange": true,
                    "ordering": true,
                    "language": {
                        emptyTable: "No missing attachments available"
                    },
                    "buttons": [
                        {
                            extend: 'collection',
                            className: 'btn-export-auditlookup',
                            text: 'Export',
                            buttons: [
                                {
                                    extend: 'copy',
                                    text: 'Copy',
                                    exportOptions: {
                                        columns: ':visible'
                                    }
                                },
                                {
                                    extend: 'excelHtml5',
                                    text: 'Excel',
                                    autoFilter: true,
                                    sheetName: 'myDMV.pro',
                                    exportOptions: {
                                        columns: ':visible'
                                    }
                                },
                                {
                                    extend: 'pdfHtml5',
                                    text: 'PDF',
                                    orientation: 'landscape',
                                    pageSize: 'LEGAL',
                                    exportOptions: {
                                        columns: ':visible'
                                    }
                                },
                                {
                                    extend: 'print',
                                    text: 'Print',
                                    exportOptions: {
                                        columns: ':visible'
                                    }
                                }
                            ]
                        }
                    ],
                    columns: [
                        { data: 'requestNumber', title: '', render: function (data) { return `<input type="checkbox" class="selectRow" value="${data}" data-id="${data}" />`; } },
                        { data: null, title: '', render: getfn_datatable_render_group_editrequest() }, 
                        { data: 'tagName', title: 'Tag Name' },
                        { data: 'note',title: 'Note' },
                        { data: 'resolution', title: 'Resolution' },
                        { data: 'processStageId', title: 'Process Stage Name', render: function (data) { return getProcessstageName(data); } },
                        { data: 'vin', title: 'VIN' },
                        { data: 'state', title: 'State' },
                        { data: 'type', title: 'Type' },
                        { data: 'dateToVendor', title: 'Date To Vendor', render: function (data) { return data ? formatDateForDisplay(data) : ''; } },
                        { data: 'requestNumber', title: 'Request Number' }
                    ]
                });

                function formatDateForDisplay(date) {
                    return new Date(date).toLocaleDateString();
                }

                function getProcessstageName(id) {
                    switch (id) {
                        case 2:
                            return "Incoming";
                            break;
                        case 12:
                            return "Not Ready To Process";
                            break;
                        case 99:
                            return "Hold";
                            break;
                        default:
                            return "";
                    }
                }

                table.buttons().container().appendTo('#export-button-data-needed');

                table.columns.adjust();

                const uploadDocumentSection = document.getElementById('missing-DataWidget');

                $('#missingDataTable').on('click', '.selectRow', function () {
                    $('.selectRow').not(this).prop('checked', false);
                    $('.selectRow').not(this).closest('tr').removeClass('selected');

                    var isChecked = $(this).prop('checked');
                    var id = $(this).prop("data-id");

                    if (isChecked) {
                        $(this).closest('tr').addClass('selected');
                        var selectedRow = $(this).closest('tr');
                        const rowData = table.row(selectedRow).data();
                        updateSelectAllCheckbox(rowData.requestCodeId, rowData.fieldId);

                    }
                    else {
                        $(this).closest('tr').removeClass('selected');
                        uploadDocumentSection.style.display = 'none'; 
                        const warningSection = document.getElementById('warningContainer');
                        warningSection.style.display = 'none';

                    }

                });
                
                function updateSelectAllCheckbox(checkboxValue, dataFieldId) {
                    var totalRows = $('.selectRow').length;
                    var selectedRows = $('.selectRow:checked').length;
                    $('#selectAll').prop('checked', totalRows === selectedRows);

                    fetchRequestFieldData(checkboxValue, dataFieldId)
                }
                
            },
            error: function (xhr, status, error) {
                container.html("<div class='error'>Failed to load data. Please try again.</div>");
                console.error("Error loading partial view:", error);
            }
        });
    }

    function fetchAttachmentData(requestId, attachmentId) {
        $.ajax({
            url: '@Url.Action("GetAttachmentForUpload", "Requests")' +'?attachmentId=' + attachmentId + '&requestId=' + requestId,
            type: 'GET',
            headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
            cache: false,
            contentType: false,
            processData: false,
            data: {
                attachmentId: attachmentId,
                requestId: requestId
            },
            success: function (response) {
                const warningSection = document.getElementById('warningContainer_docs');
                warningSection.style.display = 'none'; 

                const uploadDocumentSection = document.getElementById('missing-uploadDocument');
                uploadDocumentSection.style.display = 'block'; 

                $('#documentUploaderSection').find('.panel-body').html(response);

            },
            error: function () {
                alert("An error occurred while fetching the data.");
            }
        });
    }

    function fetchRequestFieldData(requestCodeId, fieldId) {
        $.ajax({
            url: '@Url.Action("EditMissingRequestFields", "MyServices")' + '?requestCodeId=' + requestCodeId + '&fieldId=' + fieldId,
            type: 'GET',
            headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
            cache: false,
            contentType: false,
            processData: false,
            data: {
                requestCodeId: requestCodeId,
            },
            success: function (response) {
                const warningSection = document.getElementById('warningContainer_data');
                warningSection.style.display = 'none'; // Show the div

                const uploadDataSection = document.getElementById('missing-DataWidget');
                uploadDataSection.style.display = 'block'; // Show the div

                $('#dataWidgetSection').find('.panel-body').html(response);

            },
            error: function () {
                alert("An error occurred while fetching the data.");
            }
        });
    }

    function getfn_datatable_render_group_editrequest() {
        return function (data, type, full, meta) {
            if (type == "display") {
                var url = `/MyServices/RequestLookup/${encodeURIComponent(full.vin)}/${encodeURIComponent(full.requestNumber)}`;
                var html = `<a class="editForm" tabIndex="-1" title="Edit" href="${url}" target="_blank"></a>`;
                return html;
            }
            return '';
        }
    }

    function showTooltip(event) {
        event.preventDefault(); 
    }
</script> 
