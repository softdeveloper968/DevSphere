<script>

    $(document).ready(function () {
        $("#dynamicProcessEditForm .field-input").each(function () {
            $(this).attr("data-original-value", $(this).val());
        });

        $("#dynamicProcessEditForm").on("input", ".field-input", function () {
            let fieldName = $(this).attr("name");
            let fieldValue = $(this).val();
            let originalValue = $(this).data("original-value");
            let actionButtons = $(this).siblings(".action-buttons");
            let parent = $(this).closest(".input-group");
            let inputField = parent.find(".field-input");

            console.log("Field Changed:", fieldName, "Value:", fieldValue);

            if (fieldValue !== originalValue) {
                actionButtons.removeClass("hidden");
                inputField.addClass("highlight-input")

            } else {
                actionButtons.addClass("hidden");
                inputField.removeClass("highlight-input")


            }
        });

        $("#dynamicProcessEditForm").on("click", ".save-btn", function () {
            let parent = $(this).closest(".input-group");
            let inputField = parent.find(".field-input");
            let fieldName = inputField.attr("name"); // Get field name
            let fieldValue = inputField.val(); // Get new value
            let requestId = $("input[name='RequestId']").val(); // Get request ID
            let actionButtons = $(this).closest(".action-buttons");

            const formData = new FormData();
            formData.append('RequestId', requestId);
            formData.append('FieldName', fieldName);
            formData.append('FieldValue', fieldValue);

            $.ajax({
                url: "/AppForm/VendorEditStatusIndividual",
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                cache: false,
                success: function () {
                    inputField.data("original-value", fieldValue); // Update original value
                    actionButtons.addClass("hidden");
                    inputField.removeClass("highlight-input")
                    var updatedFieldName = fieldName.replace(/([A-Z])/g, ' $1').trim()
                    var sucessMessage = `${updatedFieldName} updated successfully!`;
                    jqToast.success({ text: sucessMessage });
                },
                error: function () {
                    alert("Error saving field.");
                }
            });
        });

        $("#dynamicProcessEditForm").on("click", ".cancel-btn", function () {
            let inputField = $(this).closest(".input-group").find(".field-input");
            let actionButtons = $(this).closest(".action-buttons");

            inputField.val(inputField.data("original-value"));
            actionButtons.addClass("hidden");
            inputField.removeClass("highlight-input")

        });
    });


</script>
