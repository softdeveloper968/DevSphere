@model MyDMVpro.Models.AppFormModels.ProcessStatus
@{
    int count = 0;
    string ALTFORMDIV()
    {
        return ((count++) % 2) == 0 ? "evenrow" : "oddrow";
    }
    Dictionary<string, string> excludeFields = new Dictionary<string, string>();
    List<string> fields = new List<string>();

    bool FieldInList(string fieldName)
    {
        if (Model.EnabledFields.Count == 0)
            return true;
        return Model.EnabledFields.Any(f => f.FieldName == fieldName);
    }
}

<style>

    .action-buttons {
        display: flex;
        align-items: center;
        gap: 4px;
        margin-left: 4px;
    }

    .highlight-input {
        background-color: #e5fae4 !important;
    }
</style>

