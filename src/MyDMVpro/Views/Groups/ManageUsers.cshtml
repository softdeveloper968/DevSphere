@model MyDMVpro.Models.Groups

@{
    ViewData["Title"] = "Manage Users";
    var CurrentUserId = new Guid(MyDMVpro.Common.ClaimsHelpers.GetUserId(User));
    ICollection<MyDMVpro.Models.GroupInvite> invites = (ICollection<MyDMVpro.Models.GroupInvite>)ViewData["Invites"];
}

<div class="manageUsers">
    <h2 class="sub_heading">
        @Html.DisplayFor(model => model.GroupName)
    </h2>
    <div class="white_box p_15 mb_15">
        <div class="activeUsers">Active Users</div>
        <div>
            <table class="table" id="DT_activeUsers" cellpadding="2" cellspacing="2">
                <thead>
                    <tr>
                        <th class="reqChkbx"></th>
                        <th>User Name</th>
                        <th>User Login</th>
                        <th class="checksort">Admin</th>
                        <th class="checkbilling">Billing Access</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ug in Model.UserGroups)
                    {
                        if (!ug.User.Active)
                        {
                            // show disabled users separately
                            continue;
                        }
                        <tr data-groupid='@ug.GroupId' data-userid='@ug.UserId' data-isadmin="@ug.IsGroupAdmin" data-isBillingReadonly='false'
                                @if (ug.UserId == CurrentUserId)
                                {
                                    <text>data-disable='True'</text>
                                }>
                                <td></td>
                                <td>@ug.User.DisplayName</td>
                                <td>@ug.User.UserPrincipalName</td>
                                <td>
                                 @Html.DisplayFor(modelItem => ug.IsGroupAdmin)
                                </td>
                                <td>
                                 <input type="checkbox" class="billing-checkbox" disabled="disabled" />
                                 <span class="invoicing-access"></span>
                                </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                </tfoot>
            </table>
        </div>
    </div>
    <div class="white_box p_15 mb_15">
        <div class="inactiveUsers">Inactive Users</div>
        <table class="table" id="DT_inactiveUsers" cellpadding="2" cellspacing="2">
            <thead>
                <tr>
                    <th class="reqChkbx"></th>
                    <th>User Name</th>
                    <th>User Login</th>
                    <th class="checksort">Admin</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var ug in Model.UserGroups)
                {
                    if (ug.User.Active)
                    {
                        continue;
                    }
                    <tr data-groupid='@ug.GroupId' data-userid='@ug.UserId' data-active="@ug.User.Active"
                    @if (ug.UserId == CurrentUserId)
                    {
                        <text>data-disable='True'</text>
                    }>
                                        <td></td>
                                        <td>@ug.User.DisplayName</td>
                                        <td>@ug.User.UserPrincipalName</td>
                                        <td>@Html.DisplayFor(modelItem => ug.IsGroupAdmin)</td>
                                    </tr>
                }
            </tbody>
            <tfoot>
            </tfoot>
        </table>
    </div>
    <div class="white_box p_15 mb_5">
        <div class="pendingInvites">Pending Invites</div>
        <table class="table" id="DT_pendingInvites" cellpadding="2" cellspacing="2">
            <thead>
                <tr>
                    <th class="reqChkbx"></th>
                    <th>Created</th>
                    <th>User Email</th>
                    <th class="checksort">Admin</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invite in invites)
                {
                    <tr data-inviteid='@invite.Id' data-email="@invite.UserEmail">
                        <td></td>
                        <td>@DateTimeHelpers.EasternDateTime(invite.DateCreated, "MM/dd/yyyy h:mm tt")</td>
                        <td>@invite.UserEmail</td>
                        <td>@Html.DisplayFor(modelItem => invite.MakeGroupAdmin)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
            </tfoot>
        </table>
    </div>
</div>
<script asp-add-nonce="true">
    /* Create an array with the values of all the checkboxes in a column */
    $.fn.dataTable.ext.order['dom-checkbox'] = function (settings, col) {
        return this.api().column(col, { order: 'index' }).nodes().map(function (td, i) {
            return $('input', td).prop('checked') ? '1' : '0';
        });
    }
  
    function guserActivate(groupId, userId, flag) {
        if (typeof flag === 'undefined')
            return;

        var msg = "Activate user?"
        if (flag == false) {
            msg = "Deactivate user?";
        }
        var r = yesnoconfirm(msg, function (r) {
            if (r == false) {
                return false;
            }
            var url = "@Url.Action("EnableMember")"
            if (flag == false) {
                url = "@Url.Action("DisableMember")"
            }
            var formData = new FormData();
            formData.append("groupId", groupId);
            formData.append("userId", userId);

            var succeeded = false;
            $.ajax({
                url: url,
                type: 'POST',
                headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                async: true,
                cache: false,
                dataType: 'text',
                contentType: false,
                processData: false,
                data: formData
            }).done(function (data) {
                succeeded = true;
                location.reload();
            }).fail(function (jqXHR, textStatus) {
                // do nothing?
                succeeded = false;
            });
        });
    }

    function yesnoconfirm(msg, callbackfn) {
        var dlg = bootbox.confirm({
            @*title: "myDMV.pro",*@
            message: msg,
            className: "small",
            swapButtonOrder: true,
            buttons: {
                confirm: {
                    label: 'Yes',
                    className: 'btn-success'
                },
                cancel: {
                    label: 'No',
                    className: 'btn-default'
                }
            },
            callback: function (result) {
                if (typeof result === 'unknown')
                    result = false;
                callbackfn(result);
            }
        });
        @* to resize dialog:
            dlg.find("div.modal-dialog").addClass("modal-sm");*@
        // dlg.find('.modal-content').css({
        //     'margin-top': function () {
        //         var w = $(window).height();
        //         var b = $(this).height();
        //         // should not be (w-h)/2
        //         var h = (w - b) / 2;
        //         return h + "px";
        //     }
        // });

    }
    function removeGroupUser(groupid, userid) {
        var msg = "Are you sure you want to remove user from this group?"
        var r = yesnoconfirm(msg, function (r) {
            if (r == false) {
                return false;
            }
            var formData = new FormData();
            formData.append("groupid", groupid);
            formData.append("userid", userid);

            var succeeded = false;
            $.ajax({
                url: "@Url.Action("RemoveMember")",
                type: 'POST',
                headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                async: true,
                cache: false,
                dataType: 'text',
                contentType: false,
                processData: false,
                data: formData
            }).done(function (data) {
                // do nothing
                succeeded = true;
                location.reload();
            }).fail(function (jqXHR, textStatus) {
                // do nothing
                succeeded = false;
                location.reload();
            });
        });
    }
    function copyInviteLink(inviteid, email) {
        var inviteLink = window.location.protocol + "//" + window.location.host + "/Groups/Register/" + inviteid;
        var msg = 'Invitation link for ' + email + ' : ' + inviteLink;
        copyStringToClipboard(msg);
    }
    function copyStringToClipboard(string) {
        function handler(event) {
            event.clipboardData.setData('text/plain', string);
            event.preventDefault();
            document.removeEventListener('copy', handler, true);
        }
        document.addEventListener('copy', handler, true);
        document.execCommand('copy');
    }    
    function resendInvite(inviteid) {
        var msg = "Resend user invite?";
        var r = yesnoconfirm(msg, function (r) {
            if (r == false) {
                return false;
            }
            var formData = new FormData();
            formData.append("inviteId", inviteid);

            var succeeded = false;
            $.ajax({
                url: "@Url.Action("ResendInvite")",
                type: 'POST',
                headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                async: true,
                cache: false,
                dataType: 'text',
                contentType: false,
                processData: false,
                data: formData
            }).done(function (data) {
                // do nothing
                succeeded = true;
            }).fail(function (jqXHR, textStatus) {
                // do nothing
                succeeded = false;
            });
        });
    }
    function removeInvite(inviteid) {
        var msg = "Are you sure you want to remove the user invite?"
        var r = yesnoconfirm(msg, function (r) {
            if (r == false) {
                return false;
            }
            var formData = new FormData();
            formData.append("inviteId", inviteid);

            var succeeded = false;
            $.ajax({
                url: "@Url.Action("RemoveInvite")",
                type: 'POST',
                headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                async: true,
                cache: false,
                dataType: 'text',
                contentType: false,
                processData: false,
                data: formData
            }).done(function (data) {
                // do nothing
                succeeded = true;
                location.reload();
            }).fail(function (jqXHR, textStatus) {
                // do nothing
                succeeded = false;
            });
        });
    }

    function setAdminRole(groupid, userid, flg) {
        var msg = "Grant user administrative permissions?";
        if (flg == false)
            msg = "Remove administrative permissions for user?";
        var r = yesnoconfirm(msg, function (r) {
            if (r == false) {
                return false;
            }
            var formData = new FormData();
            formData.append("groupid", groupid);
            formData.append("userid", userid);
            formData.append("isAdmin", flg);

            var succeeded = false;
            $.ajax({
                url: "@Url.Action("SetAdminRole")",
                type: 'POST',
                headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                async: true,
                cache: false,
                dataType: 'text',
                contentType: false,
                processData: false,
                data: formData
            }).done(function (data) {
                // do nothing
                succeeded = true;
                location.reload();
            }).fail(function (jqXHR, textStatus) {
                // do nothing
                succeeded = false;
                location.reload();
            });
        });
    }

    function setBillingAccess(groupid, userid) {
        var modalHtml = `
                <div id="accessModal" class="modal fade" tabindex="-1" role="dialog">
               <div class="modal-dialog modal-dialog-centered modal_md" role="document">
                <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h5 class="modal-title">Set Billing Access</h5>
                </div>

                <div class="modal-body">
                    <label for="accessLevel" class="label-text">Select Access Level:</label>
                    <select id="accessLevel" class="styled-select form-control">
                        <option value="0">No Access</option>
                        <option value="1">Read-Only Access</option>
                        <option value="2">Full Edit Access</option>
                    </select>
                </div>

                <div class="modal-footer">
                    <button onclick="saveAccess('${groupid}', '${userid}')" class="btn btn-primary">Save</button>
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                </div>
            </div>
            </div>
        </div>
    `;

        $("body").append(modalHtml);
        $("#accessModal").modal('show');

        // $("body").append(modalHtml);
        // $("#accessModal").show();
    }

    function closeModal() {
        $("#accessModal").remove();
    }

    function saveAccess(groupid, userid) {
        var accessLevel = $("#accessLevel").val(); // Get selected value

        var formData = new FormData();
        formData.append("groupid", groupid);
        formData.append("userid", userid);
        formData.append("accessLevel", accessLevel);

        $.ajax({
            url: "@Url.Action("SaveFeaturePermission")",
            type: 'POST',
            headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
            async: true,
            cache: false,
            contentType: false,
            processData: false,
            data: formData
        }).done(function (data) {
            jqToast.success({ text: 'Access updated successfully!' });
            closeModal();
            location.reload();
        }).fail(function () {
            jqToast.error({ text: 'Failed to update access.' });

        });
    }

    function GetBillinAccessDataByUserId(userid) {
        var formData = new FormData();
        formData.append("userid", userid);
        
        $.ajax({
            url: "@Url.Action("GetFeaturePermission")",
            type: 'POST',
            headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
            async: true,
            cache: false,
            contentType: false,
            processData: false,
            data: formData
        }).done(function (response) {
            if (response.data) {
                var row = $('#DT_activeUsers tbody tr').filter(function () {
                    return $(this).data('userid') == userid;
                });

                if (row.length) {
                    var checkbox = row.find(".billing-checkbox");
                    checkbox.prop("checked", response.data.readState || response.data.writeState);

                    var accessType = "";
                    if (response.data.readState && response.data.writeState) {
                        accessType = "Full edit access";
                    } else if (response.data.readState) {
                        accessType = "Read only access";
                    } else {
                        accessType = " ";
                    }

                    row.find(".invoicing-access").text(accessType);
                }
            }
        }).fail(function () {
            alert("Failed to update access.");
        });
    }

    function showSpinner(ctl) {
        $(ctl).find('span').removeClass('collapse');
    }
   
    function hideSpinner(ctl) {
        $(ctl).find('span').addClass('collapse');
    }
   
    $(document).ready(function () {
        var inviteTable = $("#DT_pendingInvites").DataTable({
            "select": { style: 'single' },
            columnDefs: [
                {
                    "targets": "nosort",
                    "orderable": false
                },
                {
                    targets: "checksort",
                    orderDataType: 'dom-checkbox'
                },
                {
                    "targets": "reqChkbx",
                    "orderable": false,
                    "className": "select-checkbox",
                    "width": "40px", // Adjusted width setting
                    "sortable": false,
                },
            ],
            dom: "lfr<'row'tipB>",
            buttons: [
                {
                    text: 'New Invite',
                    action: function (e, dt, node, config) {
                        e.preventDefault();
                        window.location.href = '@Url.Action("Invite", "Groups", new { groupId = @Model.GroupId })';
                    }
                },
                {
                    text: 'Resend',
                    className: "selectOnOff",
                    action: function (e, dt, node, config) {
                        e.preventDefault();
                        var row = $(getSelectedRow(inviteTable));
                        var iid = row.data('inviteid');
                        resendInvite(iid);
                    }
                },
                {
                    text: 'Copy Link',
                    className: "selectOnOff",
                    action: function (e, dt, node, config) {
                        e.preventDefault();
                        var row = $(getSelectedRow(inviteTable));
                        var iid = row.data('inviteid');
                        var email = row.data('email');
                        copyInviteLink(iid, email);
                    }
                },
                {
                    text: 'Delete',
                    className: "selectOnOff",
                    action: function (e, dt, node, config) {
                        e.preventDefault();
                        var row = $(getSelectedRow(inviteTable));
                        var iid = row.data('inviteid');
                        removeInvite(iid);
                    }
                },
            ],
            scrollX: true, 
            autoWidth: true,
        });


        configureTableSelect(inviteTable);

        var activeTable = $("#DT_activeUsers").DataTable({
            "select": { style: 'single' },
            "columnDefs": [
                {
                    "targets": "nosort",
                    "orderable": false
                },
                {
                    targets: "checksort",
                    orderDataType: 'dom-checkbox'
                },
                {
                    targets: "checkbilling",
                    orderDataType: 'dom-checkbox'
                },
                {
                    "targets": "reqChkbx",
                    "orderable": false,
                    "className": "select-checkbox",
                    "min-width": "40px",
                    "max-width": "40px",
                    "sortable": false,
                },

            ],
            dom: "lfr<'row'tipB>",
            scrollX: true,
            autoWidth: true,
            buttons: [
               
                {
                    text: 'Toggle Admin',
                    className: "selectOnOff",
                    action: function (e, dt, node, config) {
                        e.preventDefault();
                        var row = $(getSelectedRow(activeTable));
                        var gid = row.data('groupid');
                        var uid = row.data('userid');
                        var isadmin = row.data('isadmin');
                        setAdminRole(gid, uid, !(isadmin == 'True'));
                    }
                },
                {
                    text: 'Toggle Billing',
                    className: "selectOnOff",
                    action: function (e, dt, node, config) {
                        e.preventDefault();
                        var row = $(getSelectedRow(activeTable));
                        var gid = row.data('groupid');
                        var uid = row.data('userid');
                        setBillingAccess(gid, uid);
                    }
                },
                {
                    text: 'Deactivate',
                    className: "selectOnOff",
                    action: function (e, dt, node, config) {
                        e.preventDefault();
                        var row = $(getSelectedRow(activeTable));
                        var gid = row.data('groupid');
                        var uid = row.data('userid');
                        guserActivate(gid, uid, false);
                    }
                },
            ],
            initComplete: function () {
                // Get all user IDs from table and call the function for each
                $('#DT_activeUsers tbody tr').each(function () {
                    var userid = $(this).data("userid"); // Assuming the userid is stored as data attribute
                    if (userid) {
                        GetBillinAccessDataByUserId(userid);
                    }
                });
            }
        });
        configureTableSelect(activeTable);

        var inactiveTable = $("#DT_inactiveUsers").DataTable({
            "select": { style: 'single' },
            "columnDefs": [
                {
                    "targets": "nosort",
                    "orderable": false
                },
                {
                    targets: "checksort",
                    orderDataType: 'dom-checkbox'
                },
                {
                    "targets": "reqChkbx",
                    "orderable": false,
                    "className": "select-checkbox",
                    "min-width": "40px",
                    "max-width": "40px",
                    "sortable": false,
                },
            ],
            dom: "lfr<'row'tipB>",
            autoWidth: true,
            scrollX: true,
            buttons: [
                {
                    text: 'Activate',
                    className: "selectOnOff",
                    action: function (e, dt, node, config) {
                        e.preventDefault();
                        var row = $(getSelectedRow(inactiveTable));
                        var gid = row.data('groupid');
                        var uid = row.data('userid');
                        guserActivate(gid, uid, true);
                    }
                },
                {
                    text: 'Remove',
                    className: "selectOnOff",
                    action: function (e, dt, node, config) {
                        e.preventDefault();
                        var row = $(getSelectedRow(inactiveTable));
                        var gid = row.data('groupid');
                        var uid = row.data('userid');
                        removeGroupUser(gid, uid);
                    }
                }
            ]
        });
        configureTableSelect(inactiveTable);

        $(':checkbox').on('change', function (e) {
            var row = $(this).closest('tr');
            var hmc = row.find(':checkbox:checked').length;
            var kluj = parseInt(hmc);
            row.find('td.counter').text(kluj);
            table.row(row).invalidate('dom');
        });
    });
    function configureTableSelect(table) {
        table.on('select deselect', function (e, dt, type, indexes) {
            if (type === 'row') {
                if (table.rows({ selected: true }).indexes().length !== 1) {
                    table.buttons('.selectOnOff').disable();
                }
                else {
                    var row = $(getSelectedRow(table));
                    if (row.data("disable") == 'True') {
                        table.buttons('.selectOnOff').disable();
                    }
                    else {
                        table.buttons('.selectOnOff').enable();
                    }
                }
            }
        });
        table.buttons('.selectOnOff').disable();
    }
    function getSelectedRow(table) {
        var a = [];
        return table.rows({ selected: true }).nodes()[0];
    }
</script>