@model IEnumerable<MyDMVpro.Models.Groups>

@{
    ViewData["Title"] = "Index";
}

<h2>Groups</h2>

<table class="table" id="DT_groupsTable">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.GroupName)
            </th>
            <th class="checksort">
                Active
            </th>
            <th class="nosort"></th>
            <th class="nosort"></th>
            <th class="nosort"></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.GroupName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Active)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.GroupId">Edit</a>
            </td>
            <td>
                <a asp-action="ManageUsers" asp-route-id="@item.GroupId">Users</a>
            </td>
            <td>
                <a asp-action="Delete" asp-route-id="@item.GroupId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
<script asp-add-nonce="true">
    /* Create an array with the values of all the checkboxes in a column */
    $.fn.dataTable.ext.order['dom-checkbox'] = function (settings, col) {
        return this.api().column(col, { order: 'index' }).nodes().map(function (td, i) {
            return $('input', td).prop('checked') ? '1' : '0';
        });
    }

    $(document).ready(function () {
        var table = $("#DT_groupsTable").DataTable({
            "columnDefs": [
                {
                    "targets": "nosort",
                    "orderable": false
                },
                {
                    targets: "checksort",
                    orderDataType: 'dom-checkbox'
                }
            ],
            dom: 'lfrtipB',
            buttons: [
                {
                    text: 'New Group',
                    action: function (e, dt, node, config) {
                        e.preventDefault();
                        window.location.href = '/Groups/Create';
                    }
                }
            ]
        });
        $(':checkbox').on('change', function (e) {
            var row = $(this).closest('tr');
            var hmc = row.find(':checkbox:checked').length;
            var kluj = parseInt(hmc);
            row.find('td.counter').text(kluj);
            table.row(row).invalidate('dom');
        });
    });
</script>