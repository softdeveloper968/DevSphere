<div class="search-box-div">
    <input type="hidden" id="selectedVin" value="" data-requestid="" data-reqno="" />
    <div class="search-box-wrap">
        <div class="search-box">
            <svg id="magnifyingGlass" data-name="magnifyingGlass" xmlns="http://www.w3.org/2000/svg" width="15.53" height="15.47" viewBox="0 0 15.53 15.47">
                <g id="Group-Copy">
                    <path id="Stroke-4" d="M6,11A5,5,0,1,0,1,6,5,5,0,0,0,6,11Z" fill="none" stroke="#fff" stroke-width="2"></path>
                    <path id="Stroke-6" d="M9.73,9.72l4.8,4.75" fill="none" stroke="#fff" stroke-linecap="round" stroke-width="2"></path>
                </g>
            </svg>
            <div class="easy-autocomplete">
                <input type="text" id="requestsearch" class="requestSearch textEntry vinupper" placeholder="Enter VIN" autocomplete="off">
                <div class="easy-autocomplete-container" id="eac-container-search">
                    <ul style="display: none;">
                    </ul>
                </div>
            </div>
        </div>
    </div>
    <div class="search-box-icon">
        <svg class="search-or-close" id="magnifyingGlass" xmlns="http://www.w3.org/2000/svg" width="15.53" height="15.47" viewBox="0 0 15.53 15.47">
            <g id="Group-Copy">
                <path id="Stroke-4" d="M6,11A5,5,0,1,0,1,6,5,5,0,0,0,6,11Z" fill="none" stroke="#fff" stroke-width="2"></path>
                <path id="Stroke-6" d="M9.73,9.72l4.8,4.75" fill="none" stroke="#fff" stroke-linecap="round" stroke-width="2"></path>
            </g>
        </svg>
        <svg class="hideMe search-or-close" id="searchClose" xmlns="http://www.w3.org/2000/svg" width="15.6" height="15.6" viewBox="0 0 15.6 15.6">
            <path id="Stroke-6" d="M3.7,4.3,17.3,17.75" transform="translate(-2.7 -3.23)" fill="none" stroke="#fff" stroke-linecap="round" stroke-width="2"></path>
            <path id="Stroke-6-2" data-name="Stroke-6" d="M17.23,4.23,3.78,17.82" transform="translate(-2.7 -3.23)" fill="none" stroke="#fff" stroke-linecap="round" stroke-width="2"></path>
