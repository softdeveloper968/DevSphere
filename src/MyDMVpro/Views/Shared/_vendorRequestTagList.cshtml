@model RequestTagViewModel
@using MyDMVpro.Common.ViewHelpers;
@{
    var columnCount = 0;
    string filterList()
    {
        List<string> filterFields = new List<string>();
        foreach (DatatableColumnInfo col in Model.Columns)
        {
            if (!string.IsNullOrEmpty(col.FilterField))
            {
                filterFields.Add(col.FilterField);
            }
        }
        return string.Join(",", filterFields);
    }
}
<script asp-add-nonce="true">
    function attachmentDropdown() {
        document.getElementById("myDropdown").classList.toggle("show");
    }
    var GetUniqueID = function () {
        // Math.random should be unique because of its seeding algorithm.
        // Convert it to base 36 (numbers + letters), and grab the first 9 characters
        // after the decimal.
        return '_' + Math.random().toString(36).substr(2, 9);
    };
    // Close the dropdown menu if the user clicks outside of it
    window.onclick = function (event) {
        if (!event.target.matches('.dropbtn')) {
            var dropdowns = document.getElementsByClassName("dropdown-content");
            var i;
            for (i = 0; i < dropdowns.length; i++) {
                var openDropdown = dropdowns[i];
                if (openDropdown.classList.contains('show')) {
                    openDropdown.classList.remove('show');
                }
            }
        }
    }
</script>
<style asp-add-nonce="true">
    td.numericCol {
        text-align: right !important;
        padding-right: 30px;
    }
    .advancedFilter {
    }
    .filterToggle .advanced {
            display: none;
        }
    .filterToggle .simple {
            display: inline-block;
        }
    .filterToggle.advancedOn
        .advanced {
            display: inline-block;
        }
    .filterToggle.advancedOn
        .simple {
            display: none;
        }

    td.sum {
        border-top: 4px double black;
    }

    #@(Model.ListId)_wrapper tfoot {
        display: table-footer-group;
        font-weight: bold;
    }
    #@(Model.ListId)_wrapper thead {
        display: table-header-group;
    }
</style>

<div class="box">
    <div class="box-body table-responsive" height="80%">
        <table class="display stripe" id="@Model.ListId" cellspacing="0" align="left">
            <thead>
                <tr id="headerRow-@Model.ListId">
                    @if (Model.Columns.Count > 0)
                    {
                        foreach (var c in Model.Columns)
                        {
                            <th class="@c.Class dt-center">@c.Title</th>
                        }
                        columnCount = Model.Columns.Count;
                    }
                </tr>
                <tr id="filterRow-@Model.ListId">
                    @for (var i = 0; i < Model.Columns.Count; i++)
                    {
                        DatatableColumnInfo c = Model.Columns[i];
                        string cls = c.Class;//.Split(" ")[0];

                        if (i == 0)
                        {
                            <th class="clearFilter @cls" data-toggle="tooltip" title="Clear filter"></th>
                        }
                        else if (i == 1 && Model.EnableAdvancedSearch)
                        {
                            <th class="advancedFilter @cls" data-toggle="tooltip" title="Advanced filter"></th>
                        }
                        else
                        {
                            if (cls == "")
                            {
                                <th></th>
                            }
                            else
                            {
                                <th class="@cls"></th>
                            }
                        }
                    }
                </tr>
            </thead>
            <tbody></tbody>
            <tfoot>
                @*                <tr>
                        @if (Model.Columns.Count > 0)
                        {
                            foreach (var c in Model.Columns)
                            {
                                <td class="@c.Class"></td>
                            }
                            columnCount = Model.Columns.Count;
                        }
                    </tr>
                *@
            </tfoot>
        </table>
    </div>
</div>

<script asp-add-nonce="true">
    $(document).ready(function () {
        $.fn.dataTable.render.shortDate = datatable_render_shortdate;

        var table = $('#@Model.ListId')
            @if (Model.AddFilterList)
            {
            <text>
            .on('preXhr.dt', function(e, settings, data) {
                    data.dropdownFilters = '@filterList()';
            })
            </text>
            }
            .DataTable(
            {
                @if  (Model.EnableKeyNavigation)
                {
                    @:@Model?.KeyNavigation
                }
                "colReorder": true,
                "scrollX": true,
                scrollY: false,
                "select": true,
                "searching": true,
                "pageLength": @Model.PageLength,
                "language": {
                    select: {
                        rows: "<span class='info_xrowsselected'>%d rows selected</span>"
                        ,selector: 'td:not(.norowselect)'
                    }
                },
                bSortCellsTop: true,
                "lengthMenu": @Model.LengthMenu,
                @*fixedColumns: { leftColumns: 2 },*@
                @if (Model.SortColumns.Count > 0)
                {
                    @:order: [
                    for(var i = 0; i<Model.SortColumns.Count; i++)
                    {
                        if (i > 0) { @:,
                        } @:[$('#@Model.ListId .@Model.SortColumns[i].Name').index(), '@(Model.SortColumns[i].Descending?"desc":"asc")']
                    }
                    @:],
                }
                searchDelay: 500,
                "columnDefs": [
                    {
                        "targets": "reqChkbx",
                        "orderable": false,
                        "className": "select-checkbox",
                        "min-width": "40px",
                        "sortable": false,
                        "data": null
                    },
                    { "targets": "reqBlank", "data": null },
                    { "targets": "reqTag", "data": "tagName", "width": "100px" },
                    { "targets": "reqTagCategory", "data": "tagCategory.tagCategoryName", "width": "100px" },
                    { "targets": "reqTagDisabled", "data": "disabled", "width": "40px", autowidth: false, render: datatable_render_checkbox },
                    { "targets": "reqDesc", "data": "tagDesc", "min-width": "200px", "width": "200px" },
                    { "targets": "reqTagId", "visible": false, "sortable": false, "className": "hidcol", "data": "tagId", "searchable": false },
                    {
                        "targets": "_all", "searchable": true, "className": "dt-center", "autowidth": true, "defaultContent": "", "sortable": true,
                        render: $.fn.dataTable.render.text()
                    },
                ],
                "processing": true,
                "serverSide": true,
                "ajax":
                    {
                        "url": "@Model.DataUrl",
                        "type": "POST",
                        "dataType": "JSON",
                        headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() }
                    },
                "buttons": [
                    {
                        extend: 'selectAll',
                        className: 'selectall',
                        action: function (e) {
                            e.preventDefault();
                            table.rows({ search: 'applied' }).deselect();
                            table.rows({ search: 'applied' }).select();
                        }
                    },
                    'selectNone',
                    { text: "New", action: function (e) { e.preventDefault(); vendor_show_RequestTag_New(table); } },
                    { text: "Edit", className: "selectOnOff selectOne", action: function (e) { e.preventDefault(); vendor_show_RequestTag_Edit(table); } },
                    { text: "Delete", className: "selectOnOff selectOne", action: function (e) { e.preventDefault(); vendor_show_RequestTag_Delete(table); } },
                    { text: "", titleAttr: "Refresh", className: "listRefresh", action: function (e) { e.preventDefault(); table.ajax.reload(); }}
                ],
                "initComplete": function (settings, json ) {
                        var colFilters = json.columnFilters;
                        var api = this.api();
                        api.columns(['.dfilter']).every(function () {
                            var column = this;
                            var select = $('<select class="customFilter"><option value=""></option></select>')
                                .appendTo($("#filterRow-@Model.ListId th").eq(column.index()).empty())
                                .on('change', function () {
                                var val = $(this).val();
                                let col = getTransposedColumn(column);
                                col
                                    .search(val ? val : '', false, false)
                                    .draw();
                            });
                            var colName = column.dataSrc();
                            if (!(colName === undefined) && !(colFilters[colName] === undefined)) {
                            $.each(colFilters[colName], function (index, value) {
                                    if (value) {
                                        //var d = moment.utc(value).format('MM-DD-YYYY');
                                        //var dval = moment.utc(value).format('YYYY-MM-DD');
                                        //select.append('<option value="' + dval + '">' + d + '</option>');
                                        select.append(buildOption_Date(value));
                                    }
                                });
                            }
                        });
                        api.columns(['.afilter']).every(function () {
                            var column = this;
                            var select = $('<select class="customFilter"><option value=""></option></select>')
                                .appendTo($("#filterRow-@Model.ListId th").eq(column.index()).empty())
                                .on('change', function () {
                                var val = $(this).val();
                                let col = getTransposedColumn(column);
                                col
                                    .search(val ? val : '', false, false)
                                    .draw();
                            });
                            var colName = column.dataSrc();
                            if (!(colName === undefined) && !(colFilters[colName] === undefined)) {
                            $.each(colFilters[colName], function (index, value) {
                                    if (value) {
                                        var opt = $('<option></option>').attr({ value: value }).text(value);
                                        select.append(opt);                                    }
                                });
                            }
                        });
                        api.columns(['.asearch']).every(function () {
                            var column = this;
                            var select = $('<input class="customFilter" type="text" placeholder="Search" />')
                                .appendTo($("#filterRow-@Model.ListId th").eq(column.index()).empty())
                                .on('change', function () {
                                var val = $(this).val();
                                let col = getTransposedColumn(column);
                                col
                                    .search(val ? val : '', false, false)
                                    .draw();
                            });
                        });
                        fixupColumnWidths(this);
                },
                "footerCallback": function (row, data, start, end, display) {
                    var api = this.api();
                    var fmtCurrency = $.fn.dataTable.render.number(',', '.', 2, '$ ');

                    api.columns('.sum', {
                        page: 'current'
                    }).every(function () {
                        var sum = this
                            .data()
                            .reduce(function (a, b) {
                                var x = parseFloat(a) || 0;
                                var y = parseFloat(b) || 0;
                                return x + y;
                            }, 0);
                        let text = fmtCurrency.display(sum);
                        $(this.footer()).html(text);
                    });
                },
                "dom": "<'row'<'col-sm-6'l><'col-sm-6'<'#buttonContainer.site-datatable-button-container'>>>" + "<'row'<'col-sm-12'tr>>" + "<'row'<'col-sm-5'i><'col-sm-7'p>><'alert row'>B",
            });

        @Model.TableVarName = table;

        table.on('select deselect', function (e, dt, type, indexes) {
            if (type === 'row') {
                if (table.rows({ selected: true }).indexes().length === 0) {
                    table.buttons('.selectOnOff').disable();
                }
                else if (table.rows({ selected: true }).indexes().length === 1) {
                    table.buttons('.selectOnOff').enable();
                }
                else {
                    table.buttons('.selectOnOff').enable();
                    table.buttons('.selectOnOff.selectOne').disable();
                }
            }
        });
        table.buttons('.selectOnOff').disable();
        $('#filterRow-@Model.ListId').find('.clearFilter').on('click', function (e) {
            e.preventDefault();
            $('#@Model.ListId').find('.customFilter').val('');
            table.search('').columns().search('').draw();
        });
        $('#filterRow-@Model.ListId').find('.advancedFilter').on('click', function (e) {
            e.preventDefault();
            $('#@Model.ListId').find('.filterToggle').toggleClass('advancedOn');
            table.columns.adjust().draw();
        });
    });
</script>
