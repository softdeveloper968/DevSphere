@{
}
<div id="modal-vinChange" class="modal fade hidden-print" tabindex="-1">
    <div class="container vertical-alignment-helper">
        <div class="row vertical-align-center">
            <div class="col-sm-4"></div>
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                        <h4 class="modal-title" id="myModal-label">Change VIN</h4>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="ChangeVIN_RequestId" />
                        <div class="form-group">
                            <label for="ChangeVIN_CurrentVIN" class="control-label">Current VIN</label>
                            <input width="150" id="ChangeVIN_CurrentVIN" class="form-control" readonly />
                        </div>
                        <div class="form-group">
                            <label for="ChangeVIN_CurrentVIN_Year" class="control-label">Year</label>
                            <input width="150" id="ChangeVIN_CurrentVIN_Year" class="form-control" readonly />
                        </div>
                        <div class="form-group">
                            <label for="ChangeVIN_CurrentVIN_Make" class="control-label">Year</label>
                            <input width="150" id="ChangeVIN_CurrentVIN_Make" class="form-control" readonly />
                        </div>
                        <hr />
                        <div class="form-group">
                            <label for="ChangeVIN_NewVIN" class="control-label">New VIN<span class="vinvalidation"></span></label>
                            <input type="text" width="150" id="ChangeVIN_NewVIN" class="form-control vincheck" />
                        </div>
                        <div class="form-group">
                            <label for="ChangeVIN_NewVIN_Year" class="control-label">Year</label>
                            <input width="150" id="ChangeVIN_NewVIN_Year" name="Vehicle Year" class="form-control" readonly />
                        </div>
                        <div class="form-group">
                            <label for="ChangeVIN_NewVIN_Make" class="control-label">Make</label>
                            <input width="150" id="ChangeVIN_NewVIN_Make" name="Vehicle Make" class="form-control" readonly />
                        </div>
                        <div class="form-group">
                            <label for="ChangeVIN_Note" class="control-label">Note</label>
                            <input type="text" width="150" id="ChangeVIN_Note" class="form-control" />
                        </div>
                    </div>
                    <div class="alert alert-danger" style="display:none" role="alert"></div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-success" id="okButton">Save</button>
                        <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
