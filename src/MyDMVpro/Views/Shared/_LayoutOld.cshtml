@*<!--
BODY TAG OPTIONS:
=================
Apply one or more of the following classes to get the
desired effect
|---------------------------------------------------------|
| SKINS         | skin-blue                               |
|               | skin-black                              |
|               | skin-purple                             |
|               | skin-yellow                             |
|               | skin-red                                |
|               | skin-green                              |
|---------------------------------------------------------|
|LAYOUT OPTIONS | fixed                                   |
|               | layout-boxed                            |
|               | layout-top-nav                          |
|               | sidebar-collapse                        |
|               | sidebar-mini                            |
|---------------------------------------------------------|
-->*@
<body class="hold-transition skin-blue sidebar-mini">
    <style asp-add-nonce="true">
        #uploadsDiv {
            width: 100%;
        }
    </style>
    <div class="wrapper">
        @await Component.InvokeAsync("Header")
        @await Component.InvokeAsync("Sidebar")
        <div class="content-wrapper">
            <section class="content-header text-center">
                @await Component.InvokeAsync("PageHeader")
                @await Component.InvokeAsync("VinSearch")
                @await Component.InvokeAsync("Breadcrumb")
                @*                @await Component.InvokeAsync("PageAlert")*@
            </section>
            <section class="content">
                <div class="page_style">
                    @RenderBody()
                </div>
            </section>
            <section class="content-rightpanel">
            </section>
        </div>
        @await Component.InvokeAsync("Footer")
        @await Component.InvokeAsync("ControlSidebar")
        <div class="control-sidebar-bg"></div>
    </div>
    <div class="toast-container"></div>


    @*  <!-- Optionally, you can add Slimscroll and FastClick plugins.
    Both of these plugins are recommended to enhance the
    user experience. Slimscroll is required when using the
    fixed layout. -->*@
    @RenderSection("scripts", required: false)
    <script asp-add-nonce="true">
        $(document).ready(function () {
            (function (e, t, n) { var r = e.querySelectorAll("html")[0]; r.className = r.className.replace(/(^|\s)no-js(\s|$)/, "$1js$2"); })(document, window, 0);
            moment.suppressDeprecationWarnings = true;
            initGlobalAutoComplete($("#globalRequestSearch"), '@User.GetUserProperty(MyDmvProClaims.GroupId)');
        });


        var jqToast = (function ($) {
            var $toastContainer = $('.toast-container');
            if ($toastContainer.length === 0) {
                $('body').append($('<div>').addClass('toast-container'));
            }

            var getOptions = function (opts) {
                return $.extend({}, {
                    displayTime: 3000,
                    fadeTime: 2000,
                    text: ''
                }, opts);
            };

            var closeToast = function ($toast, fadeTime) {
                $toast.addClass('fading').off('click');
                $toast.fadeOut(fadeTime, function () {
                    $toast.remove();
                });
            };

            var addToast = function (type, options) {
                var iconName = '';
                switch (type) {
                    case 'success':
                        iconName = 'fa-check';
                        break;
                    case 'error':
                        iconName = 'fa-times';
                        break;
                }

                var $icon = $('<div>').addClass('icon').append($('<i>').addClass('fa ' + iconName));
                var $toast = $('<div>').addClass('toast ' + type).append($icon).append($('<div>').addClass('text').text(options.text));

                $toastContainer.append($toast);

                $toast.on('click', function () {
                    closeToast($toast, options.fadeTime);
                });

                setTimeout(function () {
                    closeToast($toast, options.fadeTime);
                }, options.displayTime);
            };

            var successToast = function (opts) {
                var options = getOptions(opts);
                addToast('success', options);
            };

            var errorToast = function (opts) {
                var options = getOptions(opts);
                addToast('error', options);
            };

            return {
                success: function (opts) {
                    successToast(opts);
                },
                error: function (opts) {
                    errorToast(opts);
                }
            };
            
        })(jQuery);

    </script>
</body>
</html>
