@{
}
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const inputs = document.querySelectorAll(".form-control.individual-save");

        inputs.forEach(input => {
            input.addEventListener("input", function () {
                showButtons(this);
            });
        });
    });

    function showButtons(input) {
        let parent = input.parentElement;
        let existingBtns = parent.querySelector(".inline-buttons");

        if (!existingBtns) {
            let btnContainer = document.createElement("span");
            btnContainer.classList.add("inline-buttons");

            let saveBtn = document.createElement("button");
            saveBtn.innerHTML = "<i class='fa fa-check'></i>";
            saveBtn.classList.add("btn", "btn-primary");
            saveBtn.onclick = function () {
                saveInput(input);
            };

            let cancelBtn = document.createElement("button");
            cancelBtn.innerHTML = "<i class='fa fa-times'></i>";
            cancelBtn.classList.add("btn", "btn-danger");
            cancelBtn.onclick = function () {
                cancelEdit(input);
            };

            btnContainer.appendChild(saveBtn);
            btnContainer.appendChild(cancelBtn);
            parent.appendChild(btnContainer);

            // Store original value
            input.dataset.originalValue = input.value;
        }
    }

    function saveInput(input) {
        let parent = input.parentElement;
        let btnContainer = parent.querySelector(".inline-buttons");

        if (btnContainer) {
            parent.removeChild(btnContainer);
        }
    }

    function cancelEdit(input) {
        let parent = input.parentElement;
        let btnContainer = parent.querySelector(".inline-buttons");

        if (btnContainer) {
            input.value = input.dataset.originalValue; // Revert to original value
            parent.removeChild(btnContainer);
        }
    }
</script>
<style>
    .inline-buttons {
        display: inline-flex;
        align-items: center;
        gap: 3px;
    }

    .inline-buttons .btn {
        padding: 6px 9px;
        min-width: 34px;
    }
</style>
