@using MyDMVpro.Models.VendorViewModels;

<form id="changeAppTypeForm" asp-controller="Requests" asp-action="ChangeAppType" method="post" enctype="multipart/form-data">
    <input type="hidden" name="id" id="changeAppTypeForm_requestId" />
    <div id="changeAppTypePanel" style="display:none;" class="sectionBox">
        <div class="box-header">
        <h4 class="box-title">Change App Type</h4>
        </div>
        <div class="box-body">
            <div class="form-group" id="newAppTypePanel">
                <div class="form-group row">
                    <div class="form-group col-sm-6 col-md-6 col-lg-6">
                        <label for="newAppState" class="control-label">State</label>
                        <select id="newAppState" name="newAppState" class="form-control" data-val="true" data-valmsg-replace="true">
                            <option value=""></option>
                        </select>
                    </div>
                    <div class="form-group col-sm-6 col-md-6 col-lg-6">
                        <label for="newAppType" class="control-label">Application Type</label>
                        <select id="newAppType" name="newAppType" class="form-control" data-val="true" data-valmsg-replace="true">
                            <option value=""></option>
                        </select>
                    </div>
                </div>
                <div class="form-group row">
                    <span style="font-size:small;margin:10px;padding:10px">
                        When you change this application type, carefully review the attachments and data
                        points on the record to determine what is still needed to fulfill the request. Tag any
                        missing or incomplete data fields and CHAT THE CLIENT to confirm that the record has
                        been changed and let them know what we need to proceed
                    </span>
                </div>
                <div class="alert alert-danger" style="display:none"></div>
                <div class="form-group row">
                    <button id="btnChangeTypeCancel" class="btn btn-cancel custom_btn pull-right"><span style="font-family:FontAwesome;">&#x0F077;</span></button>
                    <button id="btnChangeTypeSubmit" type="submit" class="btn btn-danger custom_btn">Save App Type Change</button>
                </div>
            </div>
        </div>
         <div class="form-group mb-0">
        </div>
    </div>
</form>

<script>
    $(document).ready(function () {
        var $changeTypeBtn = $('#detailsEditPanel_changeAppTypeButton');
        $("#detailsEditPanel_changeAppTypeButton").off('click').on('click', function (e) {
            e.preventDefault();
            requestLookup_changeAppTypeBtnClick();
        });
        $("#btnChangeTypeCancel").on('click', function (e) {
            e.preventDefault();
            requestLookup_showChangeAppTypePanel(false);
        });
        $("#changeAppTypeForm").submit(function (e) {
            e.preventDefault();
            $form = $(this);
            let reqid = $("#changeAppTypeForm_requestId").val();
            $.ajax({
                url: $form.attr('action'),
                type: 'POST',
                data: $form.serialize()
            }).done(function (data) {
                if (data.success) {
                    // refresh app form
                    requestLookup_vendorEditRequestInline(reqid);
                    requestLookup_showChangeAppTypePanel(false);
                    // refresh Request Codes list
                    $("#DT_RequestCodes").DataTable().ajax.reload();
                }
                else {
                    vendor_show_alert($("#changeAppTypePanel"), data.message, -1);
                }
            });
            return false;
        });
    });
</script>
