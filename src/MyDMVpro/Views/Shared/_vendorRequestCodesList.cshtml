@model VendorRequestCodesViewModel
@using MyDMVpro.Common.ViewHelpers;
@{
    string IconColumnWidth()
    {
        return "30px";
    }
    var columnCount = 0;
    string filterList()
    {
        List<string> filterFields = new List<string>();
        foreach (DatatableColumnInfo col in Model.Columns)
        {
            if (!string.IsNullOrEmpty(col.FilterField))
            {
                filterFields.Add(col.FilterField);
            }
        }
        return string.Join(",", filterFields);
    }
    string SortableOption(bool f)
    {
        if (Model.AllowSort && f)
        {
            return "true";
        }
        return "false";
    }
    string OrderSequenceOption()
    {
        if (Model.AllowSort)
        {
            return ",\"orderSequence\": [\"desc\",\"asc\"]";
        }
        return "";
    }
    string SearchableOption(bool f)
    {
        if (Model.EnableFilter && f)
        {
            return "true";
        }
        return "false";
    }

    if (Model.AddLastModified)
    {
        Model.Columns.Add_Modified();
    }
    if (Model.AddLastModifiedBy)
    {
        bool hasFilter = false;
        foreach (var c in Model.Columns)
        {
            if (!string.IsNullOrEmpty(c.FilterField))
            {
                hasFilter = true;
                break;
            }
        }
        Model.Columns.Add_ModifiedBy(hasFilter);
    }
    Model.Columns.Add_RequestId();


string getbool(bool f)
{
    if (f) return "true";
    return "false";
}
}
<script asp-add-nonce="true">
    function attachmentDropdown() {
        document.getElementById("myDropdown").classList.toggle("show");
    }
    var GetUniqueID = function () {
        // Math.random should be unique because of its seeding algorithm.
        // Convert it to base 36 (numbers + letters), and grab the first 9 characters
        // after the decimal.
        return '_' + Math.random().toString(36).substr(2, 9);
    };
    // Close the dropdown menu if the user clicks outside of it
    window.onclick = function (event) {
        if (!event.target.matches('.dropbtn')) {
            var dropdowns = document.getElementsByClassName("dropdown-content");
            var i;
            for (i = 0; i < dropdowns.length; i++) {
                var openDropdown = dropdowns[i];
                if (openDropdown.classList.contains('show')) {
                    openDropdown.classList.remove('show');
                }
            }
        }
    }
</script>
<style asp-add-nonce="true">
    td.numericCol {
        text-align: right !important;
        padding-right: 30px;
    }
    .advancedFilter {
    }
    .filterToggle .advanced {
            display: none;
        }
    .filterToggle .simple {
            display: inline-block;
        }
    .filterToggle.advancedOn
        .advanced {
            display: inline-block;
        }
    .filterToggle.advancedOn
        .simple {
            display: none;
        }

    .requestCodeCleared {
        background-color: lightgreen !important;
    }

    td.sum {
        border-top: 4px double black;
    }

    #@(Model.ListId)_wrapper tfoot {
        display: table-footer-group;
        font-weight: bold;
    }
    #@(Model.ListId)_wrapper thead {
        display: table-header-group;
    }
</style>

    <div class="table-responsive" height="80%">
        <table class="display stripe" id="@Model.ListId" cellspacing="0" align="left">
            <thead>
                <tr id="headerRow-@Model.ListId">
                    @if (Model.Columns.Count > 0)
                    {
                        foreach (var c in Model.Columns)
                        {
                            <th class="@c.Class dt-center">@c.Title</th>
                        }
                        columnCount = Model.Columns.Count;
                    }
                </tr>
                @if (Model.EnableFilter)
                {<text>
                    <tr id="filterRow-@Model.ListId">
                        @for (var i = 0; i < Model.Columns.Count; i++)
                        {
                            DatatableColumnInfo c = Model.Columns[i];
                            string cls = c.Class;//.Split(" ")[0];

                            if (i == 0)
                            {
                                <th class="clearFilter @cls" data-toggle="tooltip" title="Clear filter"></th>
                            }
                            else if (i == 1 && Model.EnableAdvancedSearch)
                            {
                                <th class="advancedFilter @cls" data-toggle="tooltip" title="Advanced filter"></th>
                            }
                            else
                            {
                                if (cls == "")
                                {
                                    <th></th>
                                }
                                else
                                {
                                    <th class="@cls"></th>
                                }
                            }
                        }
                    </tr>
                </text>}
            </thead>
            <tbody></tbody>
            <tfoot>
                @*<tr>
                        @if (Model.Columns.Count > 0)
                        {
                            foreach (var c in Model.Columns)
                            {
                                <td class="@c.Class"></td>
                            }
                            columnCount = Model.Columns.Count;
                        }
                    </tr>
                *@
            </tfoot>
        </table>
    </div>

<script asp-add-nonce="true">
    $(document).ready(function () {
        $.fn.dataTable.render.shortDate = datatable_render_shortdate;

        var table = $('#@Model.ListId')
            .on('preXhr.dt', function (e, settings, data) {
                data.dropdownFilters = '@filterList()';
            })
            .on('xhr.dt', function (e, settings, json, xhr) {
                requestcodes_addFields(e, settings, json, xhr);
            })
            .DataTable(
                {
                @if  (Model.EnableKeyNavigation)
                {
                    @:@Model?.KeyNavigation
                }
                scrollX: true,
                scrollY: false,
                select: true,
                searching: true,
                language: {
                    emptyTable: "No request tags found",
                    select: {
                        rows: "<span class='info_xrowsselected'>%d rows selected</span>"
                        ,selector: 'td:not(.norowselect)'
                    }
                },
                pageLength: @Model.PageLength,
                lengthChange: false,
                @if (Model.SortColumns.Count > 0)
                {
                    @:order: [
                    for(var i = 0; i<Model.SortColumns.Count; i++)
                    {
                        if (i > 0) { @:,
                        } @:[$('#@Model.ListId .@Model.SortColumns[i].Name').index(), '@(Model.SortColumns[i].Descending?"desc":"asc")']
                    }
                    @:],
                }
                searchDelay: 500,
                columnDefs: [
                    {
                        "targets": "reqChkbx",
                        "orderable": false,
                        "className": "select-checkbox dt-center",
                        "min-width": "40px",
                        "sortable": false,
                        "data": null
                    },
                    { "targets": "reqBlank", "data": null },
                    { "targets": "reqCode", "data": "tagName", "width": "100px", defaultContent: "", sortable: false, orderable: false },
                    { "targets": ["reqNote"], "sortable": false, "className": "details-control",
                        "orderable": false, "data": "note", "defaultContent": '',
                        "searchable": false, "autowidth": true, "max-width": "200px", "width": "150px"
                    },
                    { "targets": "reqResolution", "data": "resolution", "width": "100px", defaultContent: "",
                        "render": function (data, type, full, meta) {
                                    var expand = (GetDtSetting("@Model.ListId", "expandNotes") == "true");
                                    if (expand) {
                                        return data;
                                    }
                                    else {
                                        if (data && data.length > 15) {
                                            return data.substr(0,15) + '...';
                                        }
                                        return data;
                                    }
                        }, sortable: false, orderable: false 

                    },
                    { "targets": "reqId", "visible": false, "sortable": false, "className": "hidcol", "data": "requestCodeId", "searchable": false },
                    {
                        "targets": "reqFields", "data": "fields", sortable: false, orderable: false,
                        "render": function (data, type, full, meta) {
                                        var expand = (GetDtSetting("@Model.ListId", "expandNotes") == "true");
                                        if (type == "display") {
                                            let html = '';
                                            if (data) {
                                                try {
                                                    if (expand) {
                                                        $(data).each(function (index, item) {
                                                            if (html.length > 1) html += "<br/>";
                                                            html += item.excelName
                                                        });
                                                    }
                                                    else if (data.length > 0) {
                                                        html += data[0].excelName;
                                                        if (data.length > 1) html += " ...";
                                                    }
                                                }
                                                catch (e) {
                                                    console.log(e);
                                                }
                                            }
                                            return html;
                                        }
                                        return "";
                                    }
                    },
                    {
                        "targets": [ "requesttagfilter" ],
                        "sortable": false,
                        "width": "120px"
                    },
                    {
                        "targets": "_all", "searchable": true, "className": "dt-center", "autowidth": true, "defaultContent": "", "sortable": true,
                        render: $.fn.dataTable.render.text()
                    }
                ],
                processing: true,
                serverSide: true,
                rowCallback: datatable_rowCallback_requestcode,
                ajax:
                    {
                        "url": "@Model.DataUrl",
                        "type": "POST",
                        "dataType": "JSON",
                        "data": function (data) {
                            var cleared = GetDtSetting("@Model.ListId","includeCleared");
                            var notes = GetDtSetting("@Model.ListId","expandNotes");
                            
                            data.includeCleared = (cleared == "true") ? "true" : "false";
                            data.expandNotes = (notes == "true") ? "true": "false";

                            requestCodes_SaveViewSettings('@Model.ListId', data);
                        },
                        headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() }
                    },
                createdRow: function (row, data, dataIndex) {
                    @*console.log(`createdRow: ${data.requestId}`);*@
                },
                buttons: [
                    {
                        extend: 'selectAll',
                        className: 'selectall',
                        action: function (e) {
                            e.preventDefault();
                            table.rows({ search: 'applied' }).deselect();
                            table.rows({ search: 'applied' }).select();
                        }
                    },
                    'selectNone',
                    { text: "New", action: function (e) { e.preventDefault(); vendor_show_RequestCode_Create(table); } },
                    { text: "Edit", className: "selectOnOff selectOne", action: function (e) { e.preventDefault(); vendor_show_RequestCode_Edit(table); } },
                    { text: "Clear", className: "selectOnOff selectOne", action: function (e) { e.preventDefault(); vendor_show_RequestCode_Clear(table); } },
                    @if (Model.AllowDelete)
                    {
                        @:{ text: "Delete", className: "selectOnOff", action: function (e) { e.preventDefault(); vendor_show_RequestCodes_Delete(table); } },
                    }
                    @if (Model.AddExpandNotesOption || Model.AddIncludeClearOption) {<text>
                    {
                        extend: 'collection',
                        text: 'Options',
                        "dropup": true,
                        autoClose: true,
                        background: false,
                        buttons: [
                            @if (Model.AddExpandNotesOption) { <text>
                            {
                                text: function (dt, button, config) { return GetExpandNotesButtonText("@Model.ListId"); },
                                className: "btnExpandNotes",
                                action: function (e, dt, button, config) {
                                    e.preventDefault();
                                    var btnText = "Expand Notes";
                                    if (ToggleExpandNotes(table, "@Model.ListId") == "true") {
                                        btnText = "Collapse Notes";
                                    }
                                    button.find('a').text(btnText);
                                }
                            },
                            </text>}
                            @if (Model.AddIncludeClearOption) { <text>
                            {
                                text: function (dt, button, config) { return requestCodes_GetIncludedClearedButtonText("@Model.ListId"); },
                                className: "btnIncludeCleared",
                                action: function (e, dt, button, config) {
                                    e.preventDefault();
                                    var btnText = "Include Cleared";
                                    if (requestCodes_ToggleIncludeCleared(table, "@Model.ListId") == "true") {
                                        btnText = "Exclude Cleared";
                                    }
                                    button.find('a').text(btnText);
                                },
                            },
                            </text>}
                        ]
                    },
                    </text> }
                    { text: "", titleAttr: "Refresh", className: "listRefresh", action: function (e) { e.preventDefault(); table.ajax.reload(); }}
                ],
                initComplete: function (settings, json ) {
                    var colFilters = json.columnFilters;
                    var api = this.api();
                    var tblid = '@Model.ListId';
                    @if (Model.EnableFilter) { <text>
                            api.columns(['.dsearch']).every(getfn_datatable_dsearch(tblid));
                            api.columns(['.asearch']).every(getfn_datatable_asearch(tblid));
                            api.columns(['.afilter']).every(getfn_datatable_afilter(tblid, true, colFilters));
                            api.columns(['.emptyornot']).every(getfn_datatable_emptyornotfilter(tblid, true));
                            api.columns(['.requesttagfilter']).every(getfn_datatable_requesttagfilter(tblid, true));
                    </text>}
                    fixupColumnWidths(this);
                },
                footerCallback: function (row, data, start, end, display) {
                    var api = this.api();
                    var fmtCurrency = $.fn.dataTable.render.number(',', '.', 2, '$ ');

                    api.columns('.sum', {
                        page: 'current'
                    }).every(function () {
                        var sum = this
                            .data()
                            .reduce(function (a, b) {
                                var x = parseFloat(a) || 0;
                                var y = parseFloat(b) || 0;
                                return x + y;
                            }, 0);
                        let text = fmtCurrency.display(sum);
                        $(this.footer()).html(text);
                    });
                },
                dom: "<'row'<'col-sm-6'l><'col-sm-6'<'#buttonContainer.site-datatable-button-container'>>>" + "<'row'<'col-sm-12'tr>>" + "<'alert row'>B"
            });

        @Model.TableVarName = table;

        // Add event listener for opening and closing details
        // $('#@Model.ListId tbody').on('click', 'td.fup-details-control', function (e) {
        //     e.preventDefault();
        //     var tr = $(this).closest('tr');
        //     var row = table.row(tr);
        //     var td = tr.find('div.fupnoteabbrev');

        //     if (td.length == 1) {
        //         if (row.child.isShown()) {
        //             // This row is already open - close it
        //             row.child.hide();
        //             tr.removeClass('shown');
        //             td.addClass('fupnotecollapsed');
        //             td.removeClass('fupnoteshown');
        //         }
        //         else {
        //             td.addClass('fupnoteshown');
        //             td.removeClass('fupnotecollapsed');
        //             // Open this row
        //             vendorShowFupNotes(row.data(), tr, row);
        //         }
        //     }
        // });

        datatable_setup_select_deselect(table);

        datatable_filter_setup(table, '@Model.ListId', true);
    });
</script>
