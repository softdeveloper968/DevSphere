                                    @:null,
                                }
                            }
                            columnCount = Model.Columns.Count;
                        }
                    ],
                    "columnDefs": [
                                             {
    "targets": "outcomecomboboxColumn",
    "width": "@IconColumnWidth()",
    "min-width": "@IconColumnWidth()",
    "max-width": "@IconColumnWidth()",
    "className": "dt-center norowselect",
    "searchable": false,
    "orderable": false,
    "data": "outcome",
    "render": function (data, type, row, meta) {
        var selectHtml = '<select class="comboboxColumn getoutcomedata form-control">';
        var normalizedData = data ? data.trim().toLowerCase() : '';
        var matchFound = false;
        if (!normalizedData) {
            selectHtml += '<option value="" disabled selected>Select an outcome ...</option>';
        }
        var outComeOptions = getOutcomeOptionsByTblid(tblid);
        var renderedOptions = {}; 
        for (var i = 0; i < outComeOptions.length; i++) {
            var optionValue = outComeOptions[i].match(/value="([^"]*)"/)[1];
            var optionText = outComeOptions[i].match(/>([^<]*)</)[1];
            var normalizedOptionValue = optionValue.trim().toLowerCase();
            if (!renderedOptions[normalizedOptionValue]) {
                renderedOptions[normalizedOptionValue] = true;
                var selected = (normalizedOptionValue === normalizedData) ? ' selected' : '';
                selectHtml += '<option value="' + optionValue + '"' + selected + '>' + optionText + '</option>';
                if (selected) {
                    matchFound = true;
                }
            }
        }
        if (!matchFound && normalizedData) {
            selectHtml += '<option value="' + normalizedData + '" selected>' + data + '</option>';
        }

        selectHtml += '</select>';
        return selectHtml;
        }
},
 {
    "data": "assignedUser",
    "targets": "assignedusercomboboxColumn",
    "width": "@IconColumnWidth()",
    "min-width": "@IconColumnWidth()",
    "max-width": "@IconColumnWidth()",
    "className": "dt-center norowselect",
    "searchable": @Html.Raw(SearchableOption(true)),
    "orderable": false,
    "render": function (data, type, row, meta) {
    var selectHtml = '<select class="comboboxColumn getassigneduserdata form-control">';
    var found = false;
    selectHtml += '<option value="" disabled ' + (data === null || data === "" ? 'selected' : '') + '>Select a user ...</option>';
    
    for (var i = 0; i < assignedUserOptions.length; i++) {
        var optionValue = $(assignedUserOptions[i]).val();
        if (optionValue === data) {
            selectHtml += '<option value="' + optionValue + '" selected>' + $(assignedUserOptions[i]).text() + '</option>';
            found = true;
        } else {
            selectHtml += '<option value="' + optionValue + '">' + $(assignedUserOptions[i]).text() + '</option>';
        }
    }
    
    if (!found && data !== null && data !== "") {
        selectHtml += '<option value="' + data + '" selected>' + data + '</option>';
    }

    selectHtml += '</select>';
    return selectHtml;
}
},
{
