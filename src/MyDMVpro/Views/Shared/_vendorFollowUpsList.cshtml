                            api.columns(['.outcomesearch']).every(getfn_datatable_outcomesearch(tblid));
                            api.columns(['.dtfilter']).every(getfn_datatable_dtfilter(tblid, false, colFilters));
                            api.columns(['.dsearch']).every(getfn_datatable_dsearch(tblid));
                            api.columns(['.asearch']).every(getfn_datatable_asearch(tblid));
                            api.columns(['.afilter']).every(getfn_datatable_afilter(tblid, true, colFilters));
                            api.columns(['.stageFilter']).every(getfn_datatable_stagefilter(tblid, colFilters));
                            api.columns(['.reqVIN']).every(getfn_datatable_vin(tblid, @getbool(Model.AllowMultilineVin)));
                            api.columns(['.emptyornot']).every(getfn_datatable_emptyornotfilter(tblid, true));
                            api.columns(['.followuptagfilter']).every(getfn_datatable_followuptagfilter(tblid, true));
                            api.columns(['.followupcontactfilter']).every(getfn_datatable_followupcontactfilter(tblid, true));
                            api.columns(['.processingDaysearch']).every(getfn_datatable_processingDaysearch(tblid));
                    </text>}
                    fixupColumnWidths(this);
                },
                "footerCallback": function (row, data, start, end, display) {
                    var api = this.api();
                    var fmtCurrency = $.fn.dataTable.render.number(',', '.', 2, '$ ');

                    api.columns('.sum', {
                        page: 'current'
                    }).every(function () {
                        var sum = this
                            .data()
                            .reduce(function (a, b) {
                                var x = parseFloat(a) || 0;
                                var y = parseFloat(b) || 0;
                                return x + y;
                            }, 0);
                        let text = fmtCurrency.display(sum);
                        $(this.footer()).html(text);
                    });
                },
                "dom": "<'row'<'col-sm-6'l><'col-sm-6'<'#buttonContainer.site-datatable-button-container'>>>" + "<'row'<'col-sm-12'tr>>" + "<'row'<'col-sm-5'i><'col-sm-7'p>><'alert row'>B",
            });

        @if (Model.EnableKeyNavigation)
        {
        <text>
        $('#@Model.ListId').on('key-focus.dt', function (e, datatable, cell) {
            //table.row(cell.index().row).select();
        });

        $('#@Model.ListId').on('key-blur.dt', function (e, datatable, cell) {
            //table.row(cell.index().row).deselect();
        });

        $('#@Model.ListId').on('key.dt', function (e, datatable, key, cell, originalEvent) {
            if (key === 32) {
                // Toggle selection
                var row = table.row(cell.index().row);
                if ($(row.node()).hasClass('selected'))
                    row.deselect();
                else
                    row.select();
            }
            else if (key === 65) { // 'a'
                var data = table.row(cell.index().row).data();
                showAttachments(data.requestId, data.vin);
            }
            else if (key === 67) { // 'c'
                var data = table.row(cell.index().row).data();
                showChat(data.requestId, data.vin);
            }
            else if (key === 69) { // 'e'
                var data = table.row(cell.index().row).data();
                vendorEditRequest(data.requestId);
            }
        });
        </text>
        }
        @Model.TableVarName = table;

        // Add event listener for opening and closing details
        $('#@Model.ListId tbody').on('click', 'td.fup-details-control', function (e) {
            e.preventDefault();
            var tr = $(this).closest('tr');
            var row = table.row(tr);
            var td = tr.find('div.fupnoteabbrev');

            if (td.length == 1) {
                if (row.child.isShown()) {
                    // This row is already open - close it
                    row.child.hide();
                    tr.removeClass('shown');
                    td.addClass('fupnotecollapsed');
                    td.removeClass('fupnoteshown');
                }
                else {
                    td.addClass('fupnoteshown');
                    td.removeClass('fupnotecollapsed');
                    // Open this row
                    vendorShowFupNotes(row.data(), tr, row);
                }
            }
        });

         @if (Model.ViewType == VendorViewType.FollowupAudit)
    {   <text>
          table.on('select deselect', function (e, dt, type, indexes) {
       if (type === 'row') {
        var allRowsHaveClass = true;
        
        table.rows().every(function () {
            if (!$(this.node()).hasClass('row-Frozen')) {
                allRowsHaveClass = false;
                return false; 
            }
        });

        if (!allRowsHaveClass || table.rows({ selected: true }).indexes().length === 0) {
            table.buttons('.selectOnOff').disable();
        } else if (table.rows({ selected: true }).indexes().length === 1) {
            table.buttons('.selectOnOff').enable();
        } else {
            table.buttons('.selectOnOff').enable();
            table.buttons('.selectOnOff.selectOne').disable();
        }
    }
});          
    </text>
    }
    else
    {
        <text>
         table.on('select deselect', function (e, dt, type, indexes) {
            if (type === 'row') {
                if (table.rows({ selected: true }).indexes().length === 0) {
                    table.buttons('.selectOnOff').disable();
                }
                else if (table.rows({ selected: true }).indexes().length === 1) {
                    table.buttons('.selectOnOff').enable();
                }
                else {
                    table.buttons('.selectOnOff').enable();
                    table.buttons('.selectOnOff.selectOne').disable();
                }
            }
        });
         </text>
    }
        table.buttons('.selectOnOff').disable();

        datatable_filter_setup(table, '@Model.ListId', true);
    });
</script>
