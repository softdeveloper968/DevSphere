<div id="modal-TaxCalculation" class="modal fade hidden-print" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title" id="taxModal-label">Calculated Taxes</h4>
            </div>
            <div class="modal-body">
                <!-- VIN Display -->
                <div class="form-group" style="display:flex;justify-content: space-between">
                    <div>
                    <label>VIN:</label>
                    <span id="currentVIN" class="font-weight-bold"></span>
                    </div>
                    @* <div> *@
                    @*     <label>Request ID:</label> *@
                    @*     <span id="currentRequestId" class="font-weight-bold"></span> *@
                    @* </div> *@
                    <div>
                    <label>Totl Tax:</label>
                    <span id="totalTax" class="font-weight-bold"></span>
                    </div>
                </div>
                @* <div class="form-group"> *@
                @*     <label>Totl Tax:</label> *@
                @*     <span id="totalTax" class="font-weight-bold"></span> *@
                @* </div> *@
                <!-- Tax Table -->
                <div class="form-group">
                    <table class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th>Item Name</th>
                                @* <th>State </th> *@
                                @* <th>Jurisdiction </th> *@
                                <th>Tax Due</th>
                            </tr>
                        </thead>
                        <tbody id="taxTableBody">
                            <!-- Rows will be dynamically inserted here -->
                        </tbody>
                    </table>
                </div>
                <!-- Pagination Buttons -->
                <div class="form-group text-center">
                    <button id="prevTaxButton" class="btn btn-secondary" disabled>Previous</button>
                    <button id="nextTaxButton" class="btn btn-primary">Next</button>
                    <button type="button" class="btn btn-default" data-dismiss="modal">Close</button> 
                </div>
            </div>
            @* <div class="modal-footer"> *@
            @*     <button type="button" class="btn btn-default" data-dismiss="modal">Close</button> *@
            @* </div> *@
        </div>
    </div>
</div>
