<div id="modal-vlDelete" class="modal fade hidden-print" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title" id="myModal-label">Delete Vendor Document</h4>
            </div>
            <div class="modal-body">
                <form id="vl_deleteDocument" asp-controller="VendorLibrary" asp-action="Delete" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="attachmentId" id="vl_attachmentId" />
                    <div class="form-group">
                        <input type="text" id="vl_fileName" name="fileName" readonly />
                    </div>
                    <div class="form-group">
                        <label for="vl_displayName" style="float:left" class="control-label">Display name: </label>
                        <input type="text" class="form-control" name="displayName" id="vl_displayName" readonly />
                    </div>
                    <div class="form-group">
                        <label for="vl_description" style="float:left" class="control-label">Description (optional): </label>
                        <input type="text" class="form-control" name="description" id="vl_description" readonly />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <div class="alert alert-danger" style="display:none" role="alert"></div>
                <button type="button" class="btn btn-success" id="okButton">Delete</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
<div id="modal-vlUpload" class="modal fade hidden-print" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title" id="myModal-label">Upload Vendor Document</h4>
            </div>
            <div class="modal-body">
                <form id="vl_uploadDocument" asp-controller="VendorLibrary" asp-action="Upload" method="post" enctype="multipart/form-data">
                    <div class="form-group">
                        <input type="file" name="file" class="form-control" accept="application/pdf" required  />
                    </div>
                    <div class="form-group">
                        <label for="vl_displayName" style="float:left" class="control-label">Display name: </label>
                        <input type="text" class="form-control" name="displayName" id="vl_displayName" />
                    </div>
                    <div class="form-group">
                        <label for="vl_description" style="float:left" class="control-label">Description (optional): </label>
                        <input type="text" class="form-control" name="description" id="vl_description" />
                    </div>
                    <div class="form-group">
                        <label for="vl_attachmentTypeId" style="float:left" class="control-label">Attachment Type</label>
                        <select id="vl_attachmentTypeId" name="attachmentTypeId">
                            <option value="">Select Attachment Type</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <div class="alert alert-danger" style="display:none" role="alert"></div>
                <button type="button" class="btn btn-success" id="okButton">Upload</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
<div id="modal-vlEdit" class="modal fade hidden-print" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                <h4 class="modal-title" id="myModal-label">Edit Vendor Document</h4>
            </div>
            <div class="modal-body">
                <form id="vl_editDocument" asp-controller="VendorLibrary" asp-action="Edit" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="attachmentId" id="vl_attachmentId" />
                    <div class="form-group">
                        <input type="file" name="file" class="form-control" accept="application/pdf" />
                    </div>
                    <div class="form-group">
                        <label for="vl_displayName" style="float:left" class="control-label">Display name: </label>
                        <input type="text" class="form-control" name="displayName" id="vl_displayName" />
                    </div>
                    <div class="form-group">
                        <label for="vl_description" style="float:left" class="control-label">Description (optional): </label>
                        <input type="text" class="form-control" name="description" id="vl_description" />
                    </div>
                    <div class="form-group">
                        <label for="vl_attachmentTypeId" style="float:left" class="control-label">Attachment Type</label>
                        <select id="vl_attachmentTypeId" name="attachmentTypeId">
                            <option value="">Select Attachment Type</option>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <div class="alert alert-danger" style="display:none" role="alert"></div>
                <button type="button" class="btn btn-success" id="okButton">Upload</button>
                <button type="button" class="btn btn-default" data-dismiss="modal">Cancel</button>
            </div>
        </div>
    </div>
</div>
