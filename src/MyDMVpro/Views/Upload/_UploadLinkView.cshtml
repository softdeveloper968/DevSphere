        //     data: uformData,
        //     processData: false, // Prevent jQuery from processing the data
        //     contentType: false, // Prevent jQuery from setting contentType
        //     success: function (response) {
        //         if (response.success) {
        //             // const uploadContainer = document.getElementById("upload-link-container");
        //             // uploadContainer.style.display = "block";
        //         } 
        //         else 
        //         {
        //             const uploadContainer = document.getElementById("upload-link-container");
        //             uploadContainer.style.display = "none";

        //             const uploadSuccessContainer = document.getElementById("failed-message-container");
        //             uploadSuccessContainer.style.display = "block";
        //         }
        //     },
        //     error: function (xhr, status, error) {
        //         alert("An error occurred while uploading the file.");
        //         $(".alert.alert-danger").text(xhr.responseText).show();
        //     }
        // });

        var $attForm = $("#att-addAttachment");

        $attForm.on("submit", function (e) {
            e.preventDefault(); // Prevent the default form submission behavior

            const urlParams = new URLSearchParams(window.location.search);
            const token = urlParams.get("token");

            var requestId = $("#att-RequestId").val(); // Value from the hidden input
            var fileDesc = $("#att-FileDesc").val(); // Value from the description input
            var attachmentTypeId = $attForm.find("#attachmentTypeId").val();

            var formData = new FormData(this);
            formData.append("id", requestId);
            formData.append("filedesc", fileDesc);
            formData.append("token", token)

            // Optional: Add custom validation
            var fileInput = $attForm.find('input[name="file"]');
            if (!fileInput.val()) {
                alert("Please select a file to upload.");
                return;
            }

            // AJAX request to submit the form
            $.ajax({
                url: $attForm.attr("action"), // Form action URL
                type: $attForm.attr("method"), // Form method (POST)
                data: formData,
                processData: false, // Prevent jQuery from processing the data
                contentType: false, // Prevent jQuery from setting contentType
                success: function (response) {
                    alert("File uploaded successfully.")
                    if (response.success) {
                        const uploadContainer = document.getElementById("upload-link-container");
                        uploadContainer.style.display = "none"; 

                        const uploadSuccessContainer = document.getElementById("success-message-container");
                        uploadSuccessContainer.style.display = "block";
                       
                    } else {
                        alert(response.message);
                    }

                    $attForm[0].reset();

                },
                error: function (xhr, status, error) {
                    // Handle error
                    alert("An error occurred while uploading the file.");
                    console.error("Error:", error);

                    // Optional: Display error in the alert box in your HTML
                    $(".alert.alert-danger").text(xhr.responseText).show();
                }
            });
        });

    });

</script>

