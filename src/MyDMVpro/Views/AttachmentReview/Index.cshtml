@using MyDMVpro.Models.AttachmentReviewModels

@{
    ViewData["Title"] = "Attachment Review";
}
<script src="~/js/vendor.js" asp-append-version="true"></script>
<link rel="stylesheet" href="~/css/vendor.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/attachmentreview.css" asp-append-version="true" />
<script src="~/js/attachmentreview.js" asp-append-version="true"></script>

<div class="row gap_15">

     <div class="col-lg-6">
        <div class="white_box p_15">
        <div class="attachmentListPanel">
            @{
                AttachmentReviewModel list = new AttachmentReviewModel()
                {
                    DataUrl = "/AttachmentReview/NeedReview",
                    ListId = "DT_AttachmentReview",
                    TableVarName = "AttachmentReviewTable",
                    PageLength = 5,
                    EnableScroller = false,
                    EnableKeyNavigation = false,
                    AllowMultilineVin = false,
                    AllowMultiSelect = false
                };
                list.Columns.Add_Select();
                list.Columns.Add("", "reqBlank");

                list.Columns.Add_AppType();
                list.Columns.Add_AppState();
                list.Columns.Add_StatusName();
                list.Columns.Add_StageName();
                list.Columns.Add("Attachment Type", "colAttachmentType afilter", filterField: "attachmentTypeName");
                list.Columns.Add_Group();
                list.Columns.Add_VIN();
                list.Columns.Add_RNo();

                list.SortColumns.Add("reqType");
                list.SortColumns.Add("reqState");

                await Html.RenderPartialAsync("_requestAttachments", list);
            }
        </div>
            <div id="reviewPanel" class="reviewPanel mt_10" tabindex="-1" style="display:none" data-attachmentid="">
                <h4 class="smallbox m-0 d-flex items-center justify-between">
                    <span id="reviewPanel_fields">Review Fields</span>
                    <div class="d-flex items-center">
                        <div><span id="reviewPanel_type"></span></div>
                        <button type="button" class="btn btn-success custom_btn" id="reviewPanel_approveButton">Approve</button>
                        <button type="button" class="btn btn-danger custom_btn" id="reviewPanel_rejectButton">Reject</button>
                        <div class="dropdown">
                            <button type="button" class="btn btn-info dropdown-toggle custom_btn" id="reviewPanel_changeType" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">Change Type <span class="caret"></span></button>
                            <ul class="dropdown-menu" aria-labelledby="reviewPanel_changeType">
                            </ul>
                        </div>
                    </div>
                </h4>
                <div class="panel-body p-0 mt_10">
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="white_box p_15">
            <div id="docViewInfo" style="display:none;">
                <div class="h4 mt-0 text-left"><span class="appTypeState"><span id="docViewAppType"></span>-<span id="docViewAppState"></span></span> <span id="docViewVin" style="font-weight:bold;"></span> <span id="docViewAttachmentType"></span></div>
            </div>
            <div id="docViewPanel" class="docViewPanel"></div>
        </div>
    </div>
    <div style="display:none">
        <form id="hiddenform" method="post" action=""></form>
    </div>
</div>
<div id="modal-Confirm-Extra" class="modal fade hidden-print" tabindex="-1" role="dialog">
    <div class="container vertical-alignment-helper">
        <div class="row vertical-align-center">
            <div class="col-sm-4"></div>
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                        <h4 class="modal-title" id="myModal-label">Confirm Approval<span class="pull-right" id="confirm-vin"></span></h4>
                    </div>
                    <div class="modal-body">
                        <div>Please confirm that you are intending to approve this <span>Extra</span> document.</div>
                        <div><br/><span style="font-weight:bold;color:red" id="reviewMessage">additional message goes here</span></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-success custom_btn" id="okButton">Save</button>
                        <button type="button" class="btn btn-default custom_btn" data-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div id="modal-Confirm" class="modal fade hidden-print" tabindex="-1" role="dialog">
    <div class="container vertical-alignment-helper">
        <div class="row vertical-align-center">
            <div class="col-sm-4"></div>
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
                        <h4 class="modal-title" id="myModal-label">Confirm Approval<span class="pull-right" id="confirm-vin"></span></h4>
                    </div>
                    <div class="modal-body">
                        <div><br /><span style="font-weight:bold;color:red" id="reviewMessage">additional message goes here</span></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-success custom_btn" id="okButton">Save</button>
                        <button type="button" class="btn btn-default custom_btn" data-dismiss="modal">Cancel</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@{
    await Html.RenderPartialAsync("_rejectAttachment");
}
<script asp-add-nonce="true">
    $(document).ready(function () {
        $("#reviewPanel_rejectButton").off('click').on('click', function () {
            var dt = $("#DT_AttachmentReview").DataTable();
            attachmentReview_show_Reject(dt);
        });
        $("#reviewPanel_approveButton").off('click').on('click', function () {
            var dt = $("#DT_AttachmentReview").DataTable();
            attachmentReview_show_Approve(dt);
        });
        $("#reviewPanel_changeType").off('click').on('click', function () {
            // populate dropdowns
            attachmentReview_populateChangeTypeList($(this));
        });
    });
</script>