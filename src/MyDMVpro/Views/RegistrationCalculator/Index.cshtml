                        `;

                            $('#registrationFeeContainer').html(htmlContent);
                          
                            function highlightRowById(rowIds) {
                                if (!Array.isArray(rowIds)) {
                                    rowIds = [rowIds];
                                }

                                $('.row-checkbox').each(function () {
                                    const rowId = $(this).data('id'); 

                             
                                    if (rowIds.includes(rowId)) {
                                        const row = $(this).closest('tr'); 
                                        row.addClass('highlighted-row');
                                    }
                                    else {
                                        const row = $(this).closest('tr');
                                        row.removeClass('highlighted-row'); 
                                    }
                                });
                            }

                            $('#Calculate_RegistrationFee').on('click', function () {
                                var PlateClass = $('#PlateClass').val();  
                                var UnladenWeight = $('#UnladenWeight').val();   
                                var Cylinders = $('#Cylinders').val();  
                                var Lien = $('#Lien').val();  
                                var Jurisdiction = $('#Jurisdiction').val(); 
                                var Title = $('#Title').val();
                                var Propulsion = $('#Propulsion').val();
                                var Mpg = $('#Mpg').val();
                                var Mgw = $('#Mgw').val();
                                var Year = $('#Year').val();
                                var StateCode = $('#state').val();

                                var registrationData = {
                                    stateCode: StateCode,
                                    plateClass: PlateClass.toLowerCase(),
                                    unladenWeight: UnladenWeight,
                                    cylinders: Cylinders,
                                    lien: Lien.toLowerCase(),
                                    jurisdiction: Jurisdiction.toLowerCase(),
                                    title: Title.toLowerCase(),
                                    Mpg: Mpg,
                                    Mgw: Mgw,
                                    Propulsion: Propulsion.toLowerCase(),
                                    Year: Year.toLowerCase()
                                };

                                $('#registrationFeeResult').empty();

                                const highlightCalculatedFields = [];

                                $.ajax({
                                    url: '/RegistrationCalculator/CalculateRegistrationFee',
                                    type: 'POST',
                                    contentType: 'application/json',
                                    data: JSON.stringify(registrationData),
                                    headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                                    success: function (response) {
                                        if (response.success) {
                                            let totalShippingCost = 0;
                                            const registrationFeeResultDiv = document.getElementById("registrationFeeResult");
                                            const registrationHeaderDiv = document.getElementById("registrationHeader");
                                            const calculatedValueResultDiv = document.getElementById("calculatedValue");
                                            const calculatorHeader = document.getElementById("calculatorHeader");

                                            if (!registrationFeeResultDiv || !calculatedValueResultDiv) {
                                                console.error("Missing required elements in the DOM.");
                                                return;
                                            }
                                            registrationFeeResultDiv.innerHTML = "";
                                            calculatedValueResultDiv.innerHTML = "";
                                            calculatorHeader.innerHTML = "Result of the Calculation";

                                            const parameters = {};
                                            let formula = "";
                                            const highlightCalculatedFields = [];

                                            response.data.forEach(result => {
                                                const shippingCost = parseFloat(result.shippingCost) || 0;
                                                totalShippingCost += shippingCost;
                                                const normalizedKey = result.tableName.replace(/\s+/g, '');
                                                parameters[normalizedKey] = shippingCost;
                                                const costElement = document.createElement("p");
                                                costElement.style.fontWeight = "normal";
                                                costElement.classList.add("normal-text");
                                                costElement.textContent = `${result.tableName}: $${shippingCost.toFixed(2)}`;
                                                registrationFeeResultDiv.appendChild(costElement);
                                                highlightCalculatedFields.push(result.ruleName);
                                            });

                                            if (response.data.length > 0) {
                                                let originalFormula = response.data[0]?.formula || "";

                                                response.data.forEach(result => {
                                                    const normalizedKey = result.tableName.replace(/\s+/g, '');
                                                    originalFormula = originalFormula.replace(new RegExp(result.tableName, 'g'), normalizedKey);
                                                });

                                                formula = originalFormula.trim();

                                                try {
                                                    if (formula) {
                                                        const expression = math.compile(formula);
                                                        const evaluatedResult = expression.evaluate(parameters);

                                                        if (!isNaN(evaluatedResult)) {
                                                            console.log("Evaluated Result:", evaluatedResult);
                                                            calculatedValueResultDiv.innerHTML = `Total Registration Fee: $${evaluatedResult.toFixed(2)}`;
                                                        } else {
                                                            throw new Error("Invalid calculation result (NaN).");
                                                        }
                                                    } else {
                                                        calculatedValueResultDiv.innerHTML = "No valid formula provided.";
                                                    }
                                                } catch (error) {
                                                    calculatedValueResultDiv.innerHTML = "Error calculating registration fee.";
                                                }
                                            } else {
                                                calculatedValueResultDiv.innerHTML = "No data available.";
                                            }
                                            highlightRowById(highlightCalculatedFields);
                                        } else {
                                            jqToast.error({ text: response.message });
                                        }
                                    },
                                    error: function (xhr, status, error) {
                                        jqToast.error({ text: 'An error occurred while clearing the data.' });
                                    }
                                });
                            });
                        });
                    },
                    error: function (xhr) {
                        alert("An error occurred while loading data.");
                        console.error(xhr.responseText);
                    }
                });
            }

            const createTextInput = (column) => (data, type, row, meta) => {
                const cleanedData = data && typeof data === 'string' ? data.replace(/^"+|"+$/g, '') : '';
                return `<input type="text" class="form-control edit-field editable-input" value="${cleanedData || ''}" data-row="${meta.row}" data-row-id="${meta.row}" data-field-name="${column}" data-column="${column}">`;
            }

            const createDropdown = (column, options) => (data, type, row, meta) => {
               
                const placeholder = data || " ";

                const normalizedData = data ? data.toLowerCase().replace(/\s+/g, '') : ''; 
                const normalizedOptions = options.map(opt => opt.toLowerCase().replace(/\s+/g, ''));

                const emptyOption = `<option value="null" ${!data ? 'selected' : ''}></option>`;

                const optionTags = options.map((opt, index) => {
                    const normalizedOption = normalizedOptions[index];
                    return `<option value="${opt}" ${normalizedData === normalizedOption ? 'selected' : ''}>${opt}</option>`;
                }).join('');

                return `
                    <select class="form-control edit-field editable-input" data-row="${meta.row}" data-row-id="${meta.row}" data-field-name="${column}" data-column="${column}">
                    ${emptyOption}
                    ${optionTags}
                </select>`;
            };

            $('#importModal').on('show.bs.modal', function () {
                $('#modalState').val($('#state').val());
            });

            $("#importForm").submit(function (e) {
                e.preventDefault();
                var StateCode = $('#state').val();

                const formData = new FormData(this);
                formData.append('stateCode', StateCode);


                $.ajax({
                    url: $(this).attr("action"),
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    success: function (response) {
                        if (response.success) {
                            jqToast.success({ text: 'File imported successfully!' });
                            $("#importModal").modal("hide");
                            reloadDataTable($('#state').val());
                        } else {
                            jqToast.error({ text: response.message || "An error occurred!" });
                        }
                    },
                    error: function (xhr) {
                        jqToast.error({ text: "An error occurred!" });
                        console.error(xhr.responseText);
                    }
                });
            });

            $('#state').on('change', function (e) {
                e.preventDefault(); 
                var StateCode = $('#state').val();
                const createNewTableButtonId = document.getElementById('createNewTableButtonId');
                createNewTableButtonId.style.display = 'block'; // Show the div
                reloadDataTable(StateCode);
                createMasterFormulaTable(StateCode)

            });
        });
    </script>
}

