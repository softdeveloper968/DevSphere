@model MyDMVpro.Models.CalculationTables

@{
    ViewData["Title"] = "Manage State Specific Tables";
}

<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
<link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/mathjs/11.5.0/math.min.js"></script>

<style> 
    .modal-dialog-centered {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .changed {
        background-color: #f0f8ff; 
        border: 1px solid #007bff;
    }

    .updated-field {
        border: 1px solid orange;
        background-color: #fff3cd;
    }

    #registrationFeeResult p {
        font-size: 16px;
        margin: 5px 0;
    }

    #registrationFeeResult p:first-child {
        font-weight: bold;
        font-size: 18px;
    }

    .highlighted-row, .highlighted-row > td {
        background-color: #ffeb3b !important;
    }

    .row-highlight {
        background-color: #ffff99 !important; /* Light yellow */
        transition: background-color 1s ease;
    }




</style>

@section Scripts {
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {

            $('[data-bs-toggle="tooltip"]').tooltip();
       
            const relationOptions = [
                "EQUAL TO",
                "NOT EQUAL TO",
                "GREATER THAN OR EQUAL TO",
                "GREATER THAN",
                "LESS THAN",
                "LESS THAN OR EQUAL TO",
                "BETWEEN"
            ];

            const operatorsOptions = [
                "+",
                "-",
                "*",
                "%"
            ];

            const itemsOptions = [
                "UNLADENWEIGHT",
                "MGW",
                "MPG",
                "CYLINDERS",
                "PLATECLASS",
                "PROPULSION",
                "LIEN",
                "TITLE",
                "JURISDICTION",
                "YEAR"

            ];

            const showContainer = (showData) => {
                $('#showNoDataContainer').toggle(!showData);
                $('#showDataContainer').toggle(showData);
            };


            const createMasterFormulaTable = (StateCode) => {
                const workflowName = "Master Formula Table"
                const formData = new FormData();
                formData.append('excelFile', null); 
                formData.append('stateCode', StateCode); 
                formData.append('workflowName', workflowName);

                $.ajax({
                    url: '/RegistrationCalculator/Import',
                    type: "POST",
                    data: formData,
                    processData: false,
                    contentType: false,
                    dataType: 'html',
                    cache: false,
                    headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                    success: function (response) {
                        reloadMasterFormulaDataTable(StateCode);
                        loadRegistrationFeeCalculatorTable(StateCode)
                    },
                    error: function (xhr) {
                        alert("An error occurred while importing the file.");
                        console.error(xhr.responseText);
                    }
                });

            }

            const reloadDataTable = (StateCode) => {
                $.ajax({
                    url: '/RegistrationCalculator/GetStateSpecificData',
                    type: 'POST',
                    dataType: 'html',
                    cache: false,
                    data: { StateCode },
                    headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                    success: function (response) {
                        const responseData = JSON.parse(response);

                        if (!responseData || !Array.isArray(responseData) || responseData.length === 0) {
                            showContainer(false);
                            $('#emptyTablesContainer').html(`
                                        <div class="table-section white_box p_15 mt_15">
                                            <h5>No data available for the selected state.</h5>
                                            <table class="display" style="width:100%"></table>
                                        </div>
                                    `);
                            return;
                        }

                        showContainer(true);

                        // Clear existing tables
                        $('.dataTableForCalculationTables').DataTable().destroy();

                        $('#tablesContainer').empty();
                       
                        let tables = {};
                        let originalDataMap = {};


                        responseData.forEach((tableData, index) => {

                            console.log("table data", tableData)
                            const tableId = `dataTableForCalculationTables_${index}`;
                            const addRowButtonId = `addRowButton_${index}`
                            const removeSelectedButtonId = `removeSelectedButton_${index}`
                            const insertExcelButtonId = `insertExcel_${index}`
                            const clearDataButtonId = `clearData_${index}`
                            const deleteButtonId = `delete_${index}`
                            const saveButtonId = `save_${index}`
                            const exportExcelButtonId = `exportExcel_${index}`
                            const refreshTableButtonId = `refreshTable_${index}`
                            let originalData = [...(tableData.data || [])];
                            originalDataMap[tableId] = JSON.parse(JSON.stringify(tableData.data || []));



                            $('#tablesContainer').append(`
                                <div class="table-section white_box p_15 mt_15">
                                    <div class="row flex_row items-end">
                                    <div class="col-md-4 col-12">
                                        <h4>State: <b>${tableData.state || 'Unknown State'}</b></h5>
                                        <h5>Table Name: <b>${tableData.workflowName || 'Unknown Table Name'}</b></h5>
                                    </div>
                                    <div class="col-md-8 text-right col-12">
                                        <div class="flex_btns">
                                            <button id="addRowButton_${index}" class="btn btn-primary">Add Row</button>
                                            <button id="refreshTable_${index}" class="btn btn-primary">Refresh Table</button>
                                            <button id="removeSelectedButton_${index}" class="btn btn-primary">Remove Selected</button>
                                            <button id="exportExcel_${index}" class="btn btn-primary">Export Excel</button>
                                            <button id="insertExcel_${index}" class="btn btn-primary">Import Excel</button>
                                            <button id="clearData_${index}" class="btn btn-primary">Clear Data</button>
                                            <button id="delete_${index}" class="btn btn-primary">Delete Table</button>
                                            <button id="save_${index}" class="btn btn-primary">Save</button>
                                        </div>
                                    </div>
                                    </div>
                                    <input type="hidden" class="table-data-id" value="${tableData.workFlowId || ''}" />
                                    <input type="hidden" class="table-state-id" value="${tableData.stateCode || ''}" />
                                    <table id="${tableId}" class="display dataTableForCalculationTables" style="width:100%"></table>
                                </div>
                            `);

                            let selectedIds = [];
                            const updatedFields = new Set();


                            tables[tableId] = $(`#${tableId}`).DataTable({
                                data: tableData.data || [],
                                paging: true,
                                pageLength: 10,
                                scrollX: true,
                                scrollCollapse: false,
                                searching: false,
                                info: true,
                                lengthChange: true,
                                ordering: false,
                                dom: '<"top"lf>rt<"bottom"ip><"clear">',
                                columns: [
                                    {
                                        data: 'ruleName', title: '', render: function (data, type, row) {
                                            return `<input type="checkbox" value="${data || ''}" class="row-checkbox selectRow" data-id="${data || ''}">`; // Added data-id attribute
                                        }
                                    },
                                    { data: 'dataPoint1', title: 'Data Point 1', render: createDropdown('dataPoint1', itemsOptions) },
                                    { data: 'relation1', title: 'Relation 1', render: createDropdown('relation1', relationOptions) },
                                    { data: 'condition1', title: 'Submitted Value 1', render: createTextInput('condition1') },
                                    { data: 'dataPoint2', title: 'Data Point 2', render: createDropdown('dataPoint2', itemsOptions) },
                                    { data: 'relation2', title: 'Relation 2', render: createDropdown('relation2', relationOptions) },
                                    { data: 'condition2', title: 'Submitted Value 2', render: createTextInput('condition2') },
                                    { data: 'dataPoint3', title: 'Data Point 3', render: createDropdown('dataPoint3', itemsOptions) },
                                    { data: 'relation3', title: 'Relation 3', render: createDropdown('relation3', relationOptions) },
                                    { data: 'condition3', title: 'Submitted Value 3', render: createTextInput('condition3') },
                                    { data: 'dataPoint4', title: 'Data Point 4', render: createDropdown('dataPoint4', itemsOptions) },
                                    { data: 'relation4', title: 'Relation 4', render: createDropdown('relation4', relationOptions) },
                                    { data: 'condition4', title: 'Submitted Value 4', render: createTextInput('condition4') },
                                    { data: 'dataPoint5', title: 'Data Point 5', render: createDropdown('dataPoint5', itemsOptions) },
                                    { data: 'relation5', title: 'Relation 5', render: createDropdown('relation5', relationOptions) },
                                    { data: 'condition5', title: 'Submitted Value 5', render: createTextInput('condition5') },
                                    { data: 'calculatedValue', title: 'Calculated Value', render: createTextInput('calculatedValue') },
                                    { data: 'calculatedValueDescription', title: 'Calculated Value Description', render: createTextInput('calculatedValueDescription') },
                                ],
                                rowCallback: function (row, data, index) {
                                    $(row).find('.edit-field').each(function () {
                                        const fieldId = $(this).attr('id') || `${$(this).data('row-id')}-${$(this).data('field-name')}`;
                                        if (updatedFields.has(fieldId)) {
                                            $(this).addClass('updated-field');
                                        }
                                    });
                                },
                            });

                            $(`#${addRowButtonId}`).click(function () {
                                const table = $(`#${tableId}`).DataTable();
                                table.row.add({
                                    dataPoint1: '',
                                    relation1: '',
                                    condition1: '',
                                    dataPoint2: '',
                                    relation2: '',
                                    condition2: '',
                                    dataPoint3: '',
                                    relation3: '',
                                    condition3: '',
                                    dataPoint4: '',
                                    relation4: '',
                                    condition4: '',
                                    dataPoint5: '',
                                    relation5: '',
                                    condition5: '',
                                    calculatedValue: '',
                                    calculatedValueDescription: ''
                                }).draw();
                            });

                            $(document).on('click', `#${clearDataButtonId}`, function () {
                                const tableSection = $(this).closest('.table-section');
                                const state = tableSection.find('h4').text().replace('State: ', '').trim();
                                const workflowName = tableSection.find('h5').text().replace('Table Name: ', '').trim();
                                const tableDataId = tableSection.find('.table-data-id').val();
                                const tableStateCode = tableSection.find('.table-state-id').val();

                                const formData = new FormData();
                                formData.append('stateCode', tableStateCode);
                                formData.append('workflowName', workflowName);
                                formData.append('tableId', tableDataId);

                                $('#confirmClearModal').modal('show');

                                $('#confirmClearButton').off('click').on('click', function () {

                                    $.ajax({
                                        url: '/RegistrationCalculator/ClearTableData',
                                        type: 'POST',
                                        data: formData,
                                        processData: false,
                                        contentType: false,
                                        headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                                        cache: false,
                                        success: function (response) {
                                            if (response.success) {
                                                jqToast.success({ text: 'Table data cleared!' });
                                                const table = $(`#${tableId}`).DataTable();
                                                table.clear().draw();
                                            } else {
                                                jqToast.error({ text: 'Error occured while clearing data.' });
                                            }
                                        },
                                        error: function (xhr, status, error) {
                                            jqToast.error({ text: 'An error occurred while clearing the data.' });
                                        }
                                    });

                                    $('#confirmClearModal').modal('hide');
                                });
                            });

                            $(`#${insertExcelButtonId}`).click(function () {
                                const fileInput = $('<input type="file" accept=".xlsx, .xls"/>');

                                const tableSection = $(this).closest('.table-section'); // Get the parent table section
                                const state = tableSection.find('h4').text().replace('State: ', '').trim(); // Extract State
                                const workflowName = tableSection.find('h5').text().replace('Table Name: ', '').trim(); // Extract Workflow Name
                                const tableDataId = tableSection.find('.table-data-id').val(); // Extract Table Data ID
                                const tableStateCode = tableSection.find('.table-state-id').val(); // Extract Table Data ID

                                fileInput.on('change', function (e) {
                                    const file = e.target.files[0];

                                    if (file) {
                                        const formData = new FormData();
                                        formData.append('excelFile', file); 
                                        formData.append('stateCode', tableStateCode);  
                                        formData.append('workflowName', workflowName);  
                                        formData.append('tableId', tableDataId); 

                                        $.ajax({
                                            url: '/RegistrationCalculator/ImportExcelForSpecificTable',
                                            type: 'POST',
                                            data: formData,
                                            processData: false,  
                                            contentType: false,  
                                            headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                                            cache: false,
                                            success: function (response) {
                                                if (response.success) {
                                                    jqToast.success({ text: 'File imported successfully!' });
                                                    reloadDataTable(tableStateCode);
                                                } else {
                                                    jqToast.error({ text: 'Error occured while importing file.' });
                                                }
                                            },
                                            error: function (xhr, status, error) {
                                                jqToast.error({ text: 'An error occurred while uploading the file.' });
                                            }

                                        });

                                    }
                                });

                                fileInput.click();
                            });

                            $(document).on('click', `#${deleteButtonId}`, function () {
                                const tableSection = $(this).closest('.table-section');
                                const state = tableSection.find('h4').text().replace('State: ', '').trim();
                                const workflowName = tableSection.find('h5').text().replace('Table Name: ', '').trim();
                                const tableDataId = tableSection.find('.table-data-id').val();
                                const tableStateCode = tableSection.find('.table-state-id').val();

                                const formData = new FormData();
                                formData.append('stateCode', tableStateCode);
                                formData.append('workflowName', workflowName);
                                formData.append('tableId', tableDataId);

                                $('#confirmDeleteModal').modal('show');

                                $('#confirmDeleteButton').off('click').on('click', function () {

                                    $.ajax({
                                        url: '/RegistrationCalculator/DeleteDataTable',
                                        type: 'POST',
                                        data: formData,
                                        processData: false,  
                                        contentType: false, 
                                        headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                                        cache: false,
                                        success: function (response) {
                                            if (response.success) {
                                                jqToast.success({ text: 'Table deleted successfully!' });
                                                reloadDataTable(tableStateCode);
                                            } else {
                                                jqToast.error({ text: 'Error occured while deleting table.' });
                                            }
                                        },
                                        error: function (xhr, status, error) {
                                            jqToast.error({ text: 'An error occurred while deleting the table.' });
                                        }

                                    });

                                    $('#confirmDeleteModal').modal('hide');
                                });

                            });

                            $(`#${tableId}`).on('change', 'select.edit-field', function () {
                                const table = $(`#${tableId}`).DataTable();
                                const $input = $(this);
                                const rowIndex = $input.closest('tr').index();
                                const column = $input.data('column');
                                const value = $input.val();

                                const rowData = table.row(rowIndex).data();
                                rowData[column] = value;
                                table.row(rowIndex).data(rowData).draw();
                            });

                            $(`#${tableId}`).on('change', 'input.edit-field', function () {
                                const table = $(`#${tableId}`).DataTable();
                                const $input = $(this);
                                const rowIndex = $input.closest('tr').index();
                                const column = $input.data('column');
                                const value = $input.val();

                                const rowData = table.row(rowIndex).data();
                                rowData[column] = value;
                                table.row(rowIndex).data(rowData).draw();
                            });

                            $(`#${saveButtonId}`).click(function () {
                                const tableSection = $(this).closest('.table-section');
                                const tableDataId = tableSection.find('.table-data-id').val();
                                const tableStateCode = tableSection.find('.table-state-id').val();

                                const table = $(`#${tableId}`).DataTable();

                                const tableData = table.rows().data();

                                if (!tableData || !tableData.length) {
                                    return;
                                }

                                const payload = {
                                    tableDataId: tableDataId,
                                    tableStateCode: tableStateCode,
                                    rows: tableData.toArray().map(row => ({
                                        dataPoint1: row.dataPoint1,
                                        relation1: row.relation1,
                                        condition1: row.condition1,
                                        dataPoint2: row.dataPoint2,
                                        relation2: row.relation2,
                                        condition2: row.condition2,
                                        dataPoint3: row.dataPoint3,
                                        relation3: row.relation3,
                                        condition3: row.condition3,
                                        dataPoint4: row.dataPoint4,
                                        relation4: row.relation4,
                                        condition4: row.condition4,
                                        dataPoint5: row.dataPoint5,
                                        relation5: row.relation5,
                                        condition5: row.condition5,
                                        calculatedValue: row.calculatedValue,
                                        calculatedValueDescription: row.calculatedValueDescription
                                    }))
                                };


                                $('#confirmSaveModal').modal('show');

                                $('#confirmSaveButton').off('click').on('click', function () {

                                    $.ajax({
                                        url: '/RegistrationCalculator/SaveTableData',
                                        type: 'POST',
                                        contentType: 'application/json',
                                        data: JSON.stringify(payload),
                                        headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                                        success: function (response) {
                                            if (response.success) {
                                                jqToast.success({ text: 'Data saved successfully!' });
                                                $('.edit-field.updated-field').removeClass('updated-field');
                                                updatedFields.clear();
                                            } else {
                                                jqToast.error({ text: 'Error saving data.' });
                                            }
                                        },
                                        error: function (xhr, status, error) {

                                            jqToast.error({ text: 'An error occurred while saving the data.' });
                                        }
                                    });

                                    $('#confirmSaveModal').modal('hide');
                                });
                            });

                            $(`#${tableId}`).on('click', '.selectRow', function () {
                                var isChecked = $(this).prop('checked');
                                var id = $(this).data("id");

                                if (isChecked) {
                                    if (!selectedIds.includes(id)) {
                                        selectedIds.push(id);
                                    }
                                }
                                else {
                                    var index = selectedIds.indexOf(id);
                                    if (index !== -1) {
                                        selectedIds.splice(index, 1);
                                    }
                                }

                                if (isChecked) {
                                    $(this).closest('tr').addClass('selected');
                                }
                                else {
                                    $(this).closest('tr').removeClass('selected');
                                }
                            });

                            $(`#${tableId}`).on('change', '.select-all', function () {
                                var isChecked = $(this).prop('checked');
                                $('.selectRow').prop('checked', isChecked).trigger('click');
                                if (isChecked) {
                                    $(this).closest('tr').addClass('selected');
                                } else {
                                    $(this).closest('tr').removeClass('selected');
                                }
                            });

                            $(`#${removeSelectedButtonId}`).click(function () {
                                if (selectedIds.length <= 0) {
                                    alert("Please select the row to be removed first!")
                                }
                                else {
                                    const tableSection = $(this).closest('.table-section');
                                    const tableDataId = tableSection.find('.table-data-id').val();
                                    const tableStateCode = tableSection.find('.table-state-id').val();

                                    const table = $(`#${tableId}`).DataTable();

                                    const tableData = table.rows().data();

                                    if (!tableData || !tableData.length) {
                                        return;
                                    }

                                    const payload = {
                                        WorkflowId: tableDataId,
                                        StateCode: tableStateCode,
                                        RuleNamesToRemove: selectedIds

                                    };

                                    $('#confirmRemoveRowModal').modal('show');

                                    $('#confirmRemoveRowButton').off('click').on('click', function () {
                                        $.ajax({
                                            url: '/RegistrationCalculator/RemoveRules',
                                            type: 'POST',
                                            contentType: 'application/json',
                                            data: JSON.stringify(payload),
                                            headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                                            success: function (response) {
                                                if (response.success) {
                                                    jqToast.success({ text: 'Data removed successfully!' });
                                                    reloadDataTable(tableStateCode);
                                                }
                                                else {
                                                    jqToast.error({ text: 'Error saving data.' });
                                                }
                                            },
                                            error: function (xhr, status, error) {
                                                jqToast.error({ text: 'An error occurred while saving the data.' });
                                            }
                                        });

                                        $('#confirmRemoveRowModal').modal('hide');
                                    });
                                }
                            });

                            $(`#${tableId}`).on('change', '.edit-field', function () {
                                const fieldId = $(this).attr('id') || `${$(this).data('row-id')}-${$(this).data('field-name')}`;
                                $(this).addClass('updated-field');
                                updatedFields.add(fieldId);

                                const table = $(`#${tableId}`).DataTable();
                                table.draw(false);
                            });

                            $(`#${refreshTableButtonId}`).click(function () {
                                const table = $(`#${tableId}`).DataTable();
                                updatedFields.clear();
                                
                                $(`#${tableId}`).find('.updated-field').removeClass('updated-field');
                                const origData = originalDataMap[tableId];
                                if (origData && origData.length) {
                                    // tables[tableId].clear().rows.add(origData).draw();
                                    tables[tableId].clear().rows.add(JSON.parse(JSON.stringify(origData))).draw();
                                } else {
                                    console.warn(`No original data found for table ${tableId}`);
                                }

                            });

                            $(`#${exportExcelButtonId}`).on('click', function () {
                                const tableSection = $(this).closest('.table-section');
                                const tableDataId = tableSection.find('.table-data-id').val();
                                const tableStateCode = tableSection.find('.table-state-id').val();
                                const tableInstance = $(`#${tableId}`).DataTable();
                                const state = tableSection.find('h4').text().replace('State: ', '').trim();
                                const workflowName = tableSection.find('h5').text().replace('Table Name: ', '').trim();
                                const tableData = tableInstance.rows().data().toArray();

                                const worksheetData = tableData.map(row => {
                                    return {
                                        "Rule Name": row.ruleName || '',
                                        "Data Point 1": row.dataPoint1 || '',
                                        "Relation 1": row.relation1 || '',
                                        "Submitted Value 1": row.condition1 || '',
                                        "Data Point 2": row.dataPoint2 || '',
                                        "Relation 2": row.relation2 || '',
                                        "Submitted Value 2": row.condition2 || '',
                                        "Data Point 3": row.dataPoint3 || '',
                                        "Relation 3": row.relation3 || '',
                                        "Submitted Value 3": row.condition3 || '',
                                        "Data Point 4": row.dataPoint4 || '',
                                        "Relation 4": row.relation4 || '',
                                        "Submitted Value 4": row.condition4 || '',
                                        "Data Point 5": row.dataPoint5 || '',
                                        "Relation 5": row.relation5 || '',
                                        "Submitted Value 5": row.condition5 || '',
                                        "Calculated Value": row.calculatedValue || '',
                                        "Calculated Value Description": row.calculatedValueDescription || '',
                                    };
                                });

                                const worksheet = XLSX.utils.json_to_sheet(worksheetData);
                                const workbook = XLSX.utils.book_new();
                                XLSX.utils.book_append_sheet(workbook, worksheet, `Table_${index}`);

                                const fileName = `${workflowName}.xlsx`;
                                XLSX.writeFile(workbook, fileName);
                            });

                        });

                    },
                    error: function (xhr) {
                        alert("An error occurred while loading data.");
                    }
                
                });
            };

            const reloadMasterFormulaDataTable = (StateCode) => {
                $.ajax({
                    url: '/RegistrationCalculator/GetMasterFormulaByState',
                    type: 'POST',
                    dataType: 'html',
                    cache: false,
                    data: { StateCode },
                    headers: { 'RequestVerificationToken': $('[name="__RequestVerificationToken"]').val() },
                    success: function (response) {
                        const responseData = JSON.parse(response);
                        console.log(responseData);

                        if (!responseData || !Array.isArray(responseData)) {
                            showContainer(false);
                            $('#emptyTablesContainer').html(`
                                                <div class="mfTable-section white_box p_15 mt_15">
                                                    <h5>No data available for the selected state.</h5>
                                                    <table class="display" style="width:100%"></table>
                                                </div>
                                            `);
                            return;
                        }

                        showContainer(true);

                        $('.dataTableForMasterFormula').DataTable().destroy();

                        $('#masterFormulaTablesContainer').empty();

                        responseData.forEach((tableData, index) => {

                            const mfTableId = `dataTableForMasterFormula`;
                            const mfAddRowButtonId = `addRowButton_MasterFormula`
                            const mfRemoveSelectedButtonId = `removeSelectedButton_MasterFormula`
                            const mfInsertExcelButtonId = `insertExcel_MasterFormula`
                            const mfClearDataButtonId = `clearData_MasterFormula`
                            const mfDeleteButtonId = `delete_MasterFormula}`
                            const mfSaveButtonId = `save_MasterFormula`
                            const mfExportExcelButtonId = `export_MasterFormulaExcel_${index}`
                            const mfRefreshTableButtonId = `refresh_MasterFormulaTable_${index}`

                            $('#masterFormulaTablesContainer').append(`
                                        <div class="mfTable-section white_box p_15 mt_15">
                                        <div class="row flex_row items-end">
                                        <div class="col-md-4 col-12">
