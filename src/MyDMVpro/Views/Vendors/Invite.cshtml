@model MyDMVpro.Models.VendorInvite

@{
    ViewData["Title"] = "Invite";
}

<div class="row">
    <div class="col-md-4">
        <form asp-action="Invite">
            <input type="hidden" asp-for="VendorId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="UserEmail" class="control-label"></label>
                <input asp-for="UserEmail" class="form-control" />
                <span asp-validation-for="UserEmail" class="text-danger"></span>
            </div>
            <div class="form-group">
                <div class="checkbox">
                    <label>
                        <input asp-for="MakeVendorAdmin" /> Make admin
                    </label>
                </div>
            </div>
            <div class="form-group">
                <input type="submit" value="Send Invite" class="btn btn-default" />
            </div>
        </form>
    </div>
</div>
