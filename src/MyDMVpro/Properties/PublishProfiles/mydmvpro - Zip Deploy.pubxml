<Project>
  <PropertyGroup>
    <WebPublishMethod>ZipDeploy</WebPublishMethod>
    <ResourceId>/subscriptions/92e1451d-ee5d-43ad-ac8a-e57fd7c87c30/resourceGroups/mdp-prod/providers/Microsoft.Web/sites/mydmvpro</ResourceId>
